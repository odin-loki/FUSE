// FUSE editor Windows resources: application icon + version info (Appendix A: icons).
// Added to fuse_editor on WIN32 by Source/FUSE/Editor/CMakeLists.txt; fuse.ico is generated by
// gen_fuse_icons.py next to this file.
#include <winver.h>

IDI_ICON1 ICON "fuse.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "FUSE"
            VALUE "FileDescription", "FUSE Editor"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "fuse_editor"
            VALUE "OriginalFilename", "fuse_editor.exe"
            VALUE "ProductName", "FUSE"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
