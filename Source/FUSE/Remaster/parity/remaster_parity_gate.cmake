# FUSE Remaster W1.7 gate remaster_parity: the door / trigger / pickup fixture matches its expected log, the run is
# byte-deterministic, and a scenario that misses the pickup is reported as a mismatch (exit 1).
# Usage: cmake -DEXE=<fuse_remaster_parity> -DFIXTURE=<fixture dir> -DOUT=<scratch> [-DUPDATE=ON] -P remaster_parity_gate.cmake
foreach(_v EXE FIXTURE OUT)
    if(NOT DEFINED ${_v})
        message(FATAL_ERROR "remaster_parity_gate: pass -D${_v}=")
    endif()
endforeach()
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
if(UPDATE)
    execute_process(COMMAND "${EXE}" "${FIXTURE}" --out "${FIXTURE}/expected.log" --work "${OUT}/w0" RESULT_VARIABLE _rc)
    message(STATUS "remaster_parity_gate: rewrote ${FIXTURE}/expected.log (exit ${_rc}; review the diff)")
    return()
endif()
execute_process(COMMAND "${EXE}" "${FIXTURE}" --out "${OUT}/run1.log" --work "${OUT}/w1" RESULT_VARIABLE _rc OUTPUT_VARIABLE _o ERROR_VARIABLE _e)
if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "remaster_parity_gate: the fixture does not match expected.log (exit ${_rc})\n${_o}\n${_e}")
endif()
execute_process(COMMAND "${EXE}" "${FIXTURE}" --out "${OUT}/run2.log" --work "${OUT}/w2" RESULT_VARIABLE _rc2 OUTPUT_QUIET ERROR_QUIET)
file(SHA256 "${OUT}/run1.log" _a)
file(SHA256 "${OUT}/run2.log" _b)
if(NOT _rc2 EQUAL 0 OR NOT _a STREQUAL _b)
    message(FATAL_ERROR "remaster_parity_gate: two runs differ")
endif()
execute_process(COMMAND "${EXE}" "${FIXTURE}" --scenario "${FIXTURE}/scenario_miss.json" --work "${OUT}/w3"
                RESULT_VARIABLE _rc3 OUTPUT_VARIABLE _o3 ERROR_VARIABLE _e3)
string(FIND "${_o3}" "parity MISMATCH" _at)
if(NOT _rc3 EQUAL 1 OR _at LESS 0)
    message(FATAL_ERROR "remaster_parity_gate: the negative scenario was not reported as a mismatch (exit ${_rc3})\n${_o3}\n${_e3}")
endif()
file(STRINGS "${OUT}/run1.log" _lines)
list(LENGTH _lines _n)
file(REMOVE_RECURSE "${OUT}")
message(STATUS "remaster_parity: ${_n} events match expected.log, deterministic, negative scenario detected")
