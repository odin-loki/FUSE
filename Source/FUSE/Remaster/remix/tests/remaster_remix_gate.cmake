# FUSE Remaster W2.3 / W2.4 gate remaster_remix (docs/plans/FUSE_REMASTER_PLAN.md §7 Wave 2):
#   W2.3  the handcrafted capture fixture (staged: DDS generated from gen_textures.txt) -> `ingest-remix` -> exactly
#         the expected oaid set (FIXTURE/expected/ingest.json), every mesh / texture original linked remix64 <->
#         sha256 (remix.geom.asset / remix.tex + fuse.capture.sha256 on one oaid); re-ingest is idempotent (same lock
#         bytes, no new assets).
#   W2.4  our replacement assets (remaster_remix_fixture author) -> `replace` rows (an original refused) ->
#         `export-remix` (validates: manifest schema, BC7 / BC5 DDS, composed stage, re-ingest of the mod finds every
#         replacement, no-originals lint) -> deterministic bytes on a second export; a recipe-only derivative is
#         refused without --local and marked local-only with it; seeded lint violations are all reported.
# Usage: cmake -DEXE=<fuse_remaster> -DFIXTURE_TOOL=<remaster_remix_fixture> -DSTAGER=<fuse_relight_mods_import_tests>
#              -DFIXTURE=<capture fixture dir> -DOUT=<scratch> [-DUPDATE=ON] -P remaster_remix_gate.cmake
foreach(_v EXE FIXTURE_TOOL STAGER FIXTURE OUT)
    if(NOT DEFINED ${_v})
        message(FATAL_ERROR "remaster_remix_gate: pass -D${_v}=")
    endif()
endforeach()
# EMU (optional): CMAKE_CROSSCOMPILING_EMULATOR, '|'-joined, that runs the cross-compiled executables
# (fuse-wine-run.sh for MinGW); empty for a native build.
string(REPLACE "|" ";" _emu "${EMU}")
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")

function(_run expect_code out_var)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
    if(NOT "${_rc}" STREQUAL "${expect_code}")
        message(FATAL_ERROR "remaster_remix_gate: `${ARGN}` exited ${_rc}, expected ${expect_code}\n${_out}\n${_err}")
    endif()
    set(${out_var} "${_out}${_err}" PARENT_SCOPE)
endfunction()
function(_expect text needle)
    string(FIND "${text}" "${needle}" _at)
    if(_at LESS 0)
        message(FATAL_ERROR "remaster_remix_gate: expected '${needle}' in:\n${text}")
    endif()
endfunction()

# ---- W2.3 ingest -------------------------------------------------------------------------------------------
_run(0 _o ${_emu} "${STAGER}" stage "${FIXTURE}" "${OUT}/capture")
set(_proj "${OUT}/proj")
_run(0 _o ${_emu} "${EXE}" init "${_proj}" --game "Remix Fixture")
_run(0 _ingest ${_emu} "${EXE}" ingest-remix "${OUT}/capture" --project "${_proj}" --json)
string(JSON _ok GET "${_ingest}" ok)
string(JSON _assets GET "${_ingest}" assets)
string(JSON _n LENGTH "${_ingest}" assets)
if(NOT _ok OR NOT _n EQUAL 5)
    message(FATAL_ERROR "remaster_remix_gate: ingest gave ${_n} assets (expected 5)\n${_ingest}")
endif()
# remix64 <-> sha256 links: meshes and textures carry both keys, the light its remix key.
set(_mesh_oaid "")
set(_tex_oaid "")
set(_mesh2_oaid "")
math(EXPR _last "${_n} - 1")
foreach(_i RANGE ${_last})
    string(JSON _kind GET "${_assets}" ${_i} kind)
    string(JSON _oaid GET "${_assets}" ${_i} oaid)
    if(_kind STREQUAL "mesh")
        string(JSON _h GET "${_assets}" ${_i} keys remix.geom.asset)
        string(JSON _s GET "${_assets}" ${_i} keys fuse.capture.sha256)
        if(_h STREQUAL "5EED000000000001")
            set(_mesh_oaid "${_oaid}")
        elseif(_h STREQUAL "5EED000000000002")
            set(_mesh2_oaid "${_oaid}")
        endif()
    elseif(_kind STREQUAL "texture")
        string(JSON _h GET "${_assets}" ${_i} keys remix.tex)
        string(JSON _s GET "${_assets}" ${_i} keys fuse.capture.sha256)
        if(_h STREQUAL "7E7E000000000001")
            set(_tex_oaid "${_oaid}")
        endif()
    else()
        string(JSON _h GET "${_assets}" ${_i} keys remix.light)
        set(_s "${_h}")
    endif()
    if(NOT _s MATCHES "^[0-9a-fA-F]+$")
        message(FATAL_ERROR "remaster_remix_gate: asset ${_oaid} (${_kind}) lacks its sha256 / remix key link")
    endif()
endforeach()
if(_mesh_oaid STREQUAL "" OR _mesh2_oaid STREQUAL "" OR _tex_oaid STREQUAL "")
    message(FATAL_ERROR "remaster_remix_gate: the fixture's hashes were not ingested\n${_ingest}")
endif()
# The expected oaid set (pinned; -DUPDATE=ON rewrites it).
set(_expected_file "${FIXTURE}/expected/ingest.json")
if(UPDATE)
    file(WRITE "${_expected_file}" "{\n  \"schema\": \"fuse.remaster.remix-ingest-expected/1\",\n  \"assets\": ${_assets}\n}\n")
    message(STATUS "remaster_remix_gate: rewrote ${_expected_file}")
else()
    file(READ "${_expected_file}" _exp)
    string(JSON _exp_assets GET "${_exp}" assets)
    if(NOT _exp_assets STREQUAL _assets)
        message(FATAL_ERROR "remaster_remix_gate: ingested assets differ from ${_expected_file}\nexpected:\n${_exp_assets}\ngot:\n${_assets}")
    endif()
endif()
file(SHA256 "${_proj}/remaster.lock.json" _lock1)
_run(0 _ingest2 ${_emu} "${EXE}" ingest-remix "${OUT}/capture" --project "${_proj}" --json)
file(SHA256 "${_proj}/remaster.lock.json" _lock2)
string(JSON _new GET "${_ingest2}" new_assets)
if(NOT _lock1 STREQUAL _lock2 OR NOT _new EQUAL 0)
    message(FATAL_ERROR "remaster_remix_gate: re-ingest is not idempotent (new assets ${_new})")
endif()
_run(0 _doctor ${_emu} "${EXE}" doctor --project "${_proj}")

# ---- W2.4 export ---------------------------------------------------------------------------------------------
_run(0 _o ${_emu} "${FIXTURE_TOOL}" author "${_proj}")
# An original (a captured record) can never be a replacement.
file(GLOB_RECURSE _captured RELATIVE "${_proj}/store/poco/mesh" "${_proj}/store/poco/mesh/capture/*.poco.json")
list(GET _captured 0 _cap)
string(REGEX REPLACE "\\.poco\\.json$" "" _cap "${_cap}")
_run(1 _o ${_emu} "${EXE}" replace --project "${_proj}" --oaid "${_mesh_oaid}" --with "mesh/${_cap}")
_expect("${_o}" "is an original")
_run(0 _o ${_emu} "${EXE}" replace --project "${_proj}" --oaid "${_mesh_oaid}" --with mesh/lib/fixture/crate)
_run(0 _o ${_emu} "${EXE}" replace --project "${_proj}" --oaid "${_tex_oaid}" --with material/lib/fixture/crate_mat)
_run(0 _export ${_emu} "${EXE}" export-remix --project "${_proj}" --out "${OUT}/mod" --json)
string(JSON _eok GET "${_export}" ok)
string(JSON _nrep LENGTH "${_export}" replacements)
string(JSON _found GET "${_export}" reingest_oaids)
if(NOT _eok OR NOT _nrep EQUAL 2)
    message(FATAL_ERROR "remaster_remix_gate: export failed\n${_export}")
endif()
_expect("${_found}" "${_mesh_oaid}")
_expect("${_found}" "${_tex_oaid}")
foreach(_f mod.usda materials/materials.usda assets/meshes/lib_fixture_crate.usda assets/textures/lib_fixture_crate_tex_albedo.dds
           assets/textures/lib_fixture_crate_tex_normal.dds remaster-export.json)
    if(NOT EXISTS "${OUT}/mod/${_f}")
        message(FATAL_ERROR "remaster_remix_gate: export did not write ${_f}")
    endif()
endforeach()
file(READ "${OUT}/mod/mod.usda" _mod)
_expect("${_mod}" "over \"mesh_5EED000000000001\"")
_expect("${_mod}" "string lightspeed_layer_type = \"replacement\"")
file(READ "${OUT}/mod/materials/materials.usda" _mats)
_expect("${_mats}" "def Material \"mat_7E7E000000000001\"")
_expect("${_mats}" "AperturePBR_Opacity")
# Deterministic: a second export gives the same bytes.
_run(0 _o ${_emu} "${EXE}" export-remix --project "${_proj}" --out "${OUT}/mod2")
file(GLOB_RECURSE _files RELATIVE "${OUT}/mod" "${OUT}/mod/*")
foreach(_f IN LISTS _files)
    file(SHA256 "${OUT}/mod/${_f}" _a)
    file(SHA256 "${OUT}/mod2/${_f}" _b)
    if(NOT _a STREQUAL _b)
        message(FATAL_ERROR "remaster_remix_gate: ${_f} differs between two exports")
    endif()
endforeach()
# Seeded lint violations (original blob, path out of the mod, stray file) are all reported.
_run(0 _o ${_emu} "${FIXTURE_TOOL}" lint-negative "${_proj}" "${OUT}/mod" "${OUT}/mod_seeded")
# A recipe-only derivative: refused without --local, local-only with it.
_run(0 _o ${_emu} "${EXE}" replace --project "${_proj}" --oaid "${_mesh2_oaid}" --with mesh/der/fixture/upscaled)
_run(1 _o ${_emu} "${EXE}" export-remix --project "${_proj}" --out "${OUT}/mod_refused")
_expect("${_o}" "recipe-only")
_run(0 _o ${_emu} "${EXE}" export-remix --project "${_proj}" --out "${OUT}/mod_local" --local)
file(READ "${OUT}/mod_local/remaster-export.json" _man)
_expect("${_man}" "\"local-only\"")
file(REMOVE_RECURSE "${OUT}")
message(STATUS "remaster_remix: 5 originals ingested with remix64 <-> sha256 links (idempotent); 2 replacements exported, "
               "validated, re-ingested and linted; recipe-only needs --local")
