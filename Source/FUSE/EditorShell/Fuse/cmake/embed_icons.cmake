# Writes ${OUT}: the Source/FUSE/Branding PNG rasters as byte arrays (fuse_editor_fuse window icon, Appendix A icons).
set(_body "// generated by embed_icons.cmake from Source/FUSE/Branding\n#pragma once\n#include <cstddef>\n")
set(_table "")
foreach(_px 16 32 48 256)
    file(READ "${BRANDING}/fuse_${_px}.png" _hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
    string(APPEND _body "inline constexpr unsigned char kFusePng${_px}[] = {${_bytes}};\n")
    string(APPEND _table "    {${_px}, kFusePng${_px}, sizeof(kFusePng${_px})},\n")
endforeach()
string(APPEND _body "struct EmbeddedIcon { int size; const unsigned char* png; std::size_t bytes; };\n")
string(APPEND _body "inline constexpr EmbeddedIcon kFuseIcons[] = {\n${_table}};\n")
file(WRITE "${OUT}.tmp" "${_body}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
