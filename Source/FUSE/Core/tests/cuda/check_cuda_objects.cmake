# ctest -L cuda: verify every FUSE .cu translation unit was compiled and carries device code.
# Inputs: FUSE_CUDA_OBJECTS (|-list of object files, generator-expanded), FUSE_CUDA_EXPECTED
# (|-list of .cu basenames that must be present), FUSE_CUOBJDUMP (path; optional),
# FUSE_CUDA_SOURCE_ROOT (Source/FUSE; every .cu found there must be in FUSE_CUDA_EXPECTED).
cmake_policy(SET CMP0057 NEW) # if(IN_LIST) in -P script mode

if(NOT FUSE_CUDA_OBJECTS)
    message(FATAL_ERROR "FUSE_CUDA_OBJECTS is empty")
endif()
string(REPLACE "|" ";" FUSE_CUDA_OBJECTS "${FUSE_CUDA_OBJECTS}")
string(REPLACE "|" ";" FUSE_CUDA_EXPECTED "${FUSE_CUDA_EXPECTED}")

set(_cu_objects)
foreach(_obj IN LISTS FUSE_CUDA_OBJECTS)
    if(_obj MATCHES "\\.cu\\.o(bj)?$")
        list(APPEND _cu_objects "${_obj}")
    endif()
endforeach()

set(_failures 0)
foreach(_name IN LISTS FUSE_CUDA_EXPECTED)
    set(_found "")
    foreach(_obj IN LISTS _cu_objects)
        get_filename_component(_base "${_obj}" NAME)
        if(_base STREQUAL "${_name}.o" OR _base STREQUAL "${_name}.obj")
            set(_found "${_obj}")
        endif()
    endforeach()
    if(NOT _found)
        message(SEND_ERROR "CUDA TU ${_name} is not part of any gated target")
        math(EXPR _failures "${_failures} + 1")
        continue()
    endif()
    if(NOT EXISTS "${_found}")
        message(SEND_ERROR "CUDA object missing (not built): ${_found}")
        math(EXPR _failures "${_failures} + 1")
        continue()
    endif()
    if(FUSE_CUOBJDUMP)
        execute_process(COMMAND "${FUSE_CUOBJDUMP}" -lelf "${_found}"
                        OUTPUT_VARIABLE _elf ERROR_VARIABLE _err RESULT_VARIABLE _rc)
        if(NOT _rc EQUAL 0 OR NOT _elf MATCHES "sm_[0-9]+")
            message(SEND_ERROR "no device ELF (sm_XX cubin) in ${_found}: ${_elf}${_err}")
            math(EXPR _failures "${_failures} + 1")
            continue()
        endif()
        string(REGEX MATCH "sm_[0-9]+" _sm "${_elf}")
        message(STATUS "ok ${_name} (${_sm})")
    else()
        message(STATUS "ok ${_name} (object present; cuobjdump unavailable)")
    endif()
endforeach()

# Every .cu under Source/FUSE must be gated — a new kernel file that no target builds is an error.
if(FUSE_CUDA_SOURCE_ROOT)
    file(GLOB_RECURSE _all_cu RELATIVE "${FUSE_CUDA_SOURCE_ROOT}" "${FUSE_CUDA_SOURCE_ROOT}/*.cu")
    foreach(_cu IN LISTS _all_cu)
        get_filename_component(_cu_name "${_cu}" NAME)
        if(NOT _cu_name IN_LIST FUSE_CUDA_EXPECTED)
            message(SEND_ERROR "Source/FUSE/${_cu} is not covered by fuse_cuda_compile_gate")
            math(EXPR _failures "${_failures} + 1")
        endif()
    endforeach()
endif()

list(LENGTH FUSE_CUDA_EXPECTED _n)
if(_failures GREATER 0)
    message(FATAL_ERROR "fuse_cuda_compile_gate: ${_failures} of ${_n} CUDA TUs failed")
endif()
message(STATUS "fuse_cuda_compile_gate: ${_n} CUDA TUs compiled with device code")
