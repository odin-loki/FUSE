# Ported from dxvk-remix bridge/src/util/util_commands.h@0867d3c (command ids and names)

# FUSE Relight bridge command table (RL-2.1). gen_commands.cmake turns it into the command ids,
# per-command structs, encoders, decoders, the host-side dispatch switch, the fuzz randomizers and
# kSchemaHash (SHA-256 of the normalized table). The handshake rejects a peer whose schema hash
# differs, so any edit here (add, remove, reorder, retype) is safe across mismatched builds.
#
# Row syntax:   Name: type field, type field, ...        (no fields: "Name:")
# Types:        u8 u16 u32 u64 i8 i16 i32 i64 f32 f64 handle (u32 client object id)
#               T[N] fixed array, T[] counted array, bytes (= u8[]), str (UTF-8, counted)
# Wire:         little-endian, no padding; counted arrays/str/bytes carry a u32 count first.
#
# Every COM method row targets the object in MessageHeader::handle; `this` is not a field. Rows that
# create or return an object carry the client-chosen `handle result` of the new object (upstream
# assigned client-side ids the same way). `bytes` fields hold a D3D structure whose cross-arch wire
# layout RL-2.2 defines (present parameters, rects, regions, D3DLIGHT9 is spelled out below);
# RL-2.2 may retype any row: the schema hash keeps mismatched builds from connecting.
#
# Ids are assigned in table order starting at 1 (0 = Invalid). The names and order of the D3D9 rows
# follow upstream util_commands.h; upstream's Bridge_Any is a wait wildcard (not a command),
# Bridge_Terminate is a normal row here, and Bridge_SharedHeap_{AddSeg,Alloc,Dealloc} are gone (the
# heap's segment table and chunk states live in shared memory; see ipc/shared_heap.hpp).

protocol 1 0

# ---- bridge control -------------------------------------------------------------------------------
Bridge_Syn: u32 protocolMajor, u32 protocolMinor, u64 schemaHash, u32 pid, u32 pointerBits, str buildTag
Bridge_Ack: u32 protocolMajor, u32 protocolMinor, u64 schemaHash, u32 pid, u32 status, str reason
Bridge_Continue:
Bridge_Terminate:
Bridge_Response: i32 result, bytes payload
Bridge_DebugMessage: u32 level, str text
Bridge_UnlinkResource: handle resource
Bridge_UnlinkVolumeResource: handle resource

# ---- Remix API forwarding (RL-6.2 refines the payloads) ------------------------------------------
RemixApi_CreateMaterial: handle material, bytes info
RemixApi_DestroyMaterial: handle material
RemixApi_CreateMesh: handle mesh, bytes info
RemixApi_DestroyMesh: handle mesh
RemixApi_DrawInstance: bytes info
RemixApi_CreateLight: handle light, bytes info
RemixApi_DestroyLight: handle light
RemixApi_DrawLightInstance: handle light
RemixApi_SetConfigVariable: str key, str value
RemixApi_CreateD3D9: u32 editorModeEnabled
RemixApi_RegisterDevice:

# ---- bridge-only device links ---------------------------------------------------------------------
IDirect3DDevice9Ex_LinkSwapchain: u32 index, handle swapChain
IDirect3DDevice9Ex_LinkBackBuffer: u32 swapChain, u32 index, handle surface
IDirect3DDevice9Ex_LinkAutoDepthStencil: handle surface

