# FUSE Relight RL-3.6: embeds the three particle passes' SPIR-V into a C++ header (build step, script mode):
#   cmake -DOUT=<header> -DSPAWN=<spv> -DEVOLVE=<spv> -DBILLBOARD=<spv> -P embed_spirv.cmake
set(_text "// Generated by Source/FUSE/Relight/particles/cmake/embed_spirv.cmake from shaders/particle_sim.comp. Do not edit.\n")
string(APPEND _text "#pragma once\n#include <cstdint>\n#define FUSE_RELIGHT_PARTICLE_SPV 1\n")
foreach(_pair "SPAWN;kRelightParticleSpawnSpv" "EVOLVE;kRelightParticleEvolveSpv" "BILLBOARD;kRelightParticleBillboardSpv")
    list(GET _pair 0 _var)
    list(GET _pair 1 _name)
    file(READ "${${_var}}" _hex HEX)
    string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1u," _words "${_hex}")
    string(APPEND _text "alignas(4) static const std::uint32_t ${_name}[] = {${_words}};\n")
endforeach()
file(WRITE "${OUT}" "${_text}")
