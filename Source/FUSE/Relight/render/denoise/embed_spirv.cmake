# FUSE Relight RL-5.5 (script mode, build step): embeds the gradient producer's SPIR-V into a C++ header.
#   cmake -DOUT=<header> [-DSLANG_SPV=<spv>] [-DGLSL_SPV=<spv>] -P embed_spirv.cmake
set(_text "// Generated by Source/FUSE/Relight/render/denoise/embed_spirv.cmake from shaders/rl_dn_gradient.*. Do not edit.\n")
string(APPEND _text "#pragma once\n#include <cstdint>\n")
foreach(_lang SLANG GLSL)
    if(_lang STREQUAL "SLANG")
        set(_suffix Slang)
    else()
        set(_suffix Glsl)
    endif()
    set(_spv "${${_lang}_SPV}")
    if(_spv AND EXISTS "${_spv}")
        string(APPEND _text "#define FUSE_RL_DN_GRADIENT_${_lang} 1\n")
        file(READ "${_spv}" _hex HEX)
        string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1u," _words "${_hex}")
        string(APPEND _text "alignas(4) static const std::uint32_t kRlDnGradient${_suffix}Spv[] = {${_words}};\n")
    endif()
endforeach()
file(WRITE "${OUT}" "${_text}")
