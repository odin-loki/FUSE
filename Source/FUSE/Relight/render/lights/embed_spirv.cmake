# FUSE Relight RL-4.4 (script mode, build step): embeds the light kernels' SPIR-V into a C++ header.
#   cmake -DOUT=<header> [-DSLANG_CONVERT=<spv> -DSLANG_SAMPLE=<spv>] [-DGLSL_CONVERT=<spv> -DGLSL_SAMPLE=<spv>]
#         -P embed_spirv.cmake
set(_text "// Generated by Source/FUSE/Relight/render/lights/embed_spirv.cmake from render/lights/shaders/rl_light_*. Do not edit.\n")
string(APPEND _text "#pragma once\n#include <cstdint>\n")
foreach(_lang SLANG GLSL)
    if(_lang STREQUAL "SLANG")
        set(_suffix Slang)
    else()
        set(_suffix Glsl)
    endif()
    set(_convert "${${_lang}_CONVERT}")
    set(_sample "${${_lang}_SAMPLE}")
    if(_convert AND _sample AND EXISTS "${_convert}" AND EXISTS "${_sample}")
        string(APPEND _text "#define FUSE_RL_LIGHTS_${_lang} 1\n")
        foreach(_kernel Convert Sample)
            if(_kernel STREQUAL "Convert")
                file(READ "${_convert}" _hex HEX)
            else()
                file(READ "${_sample}" _hex HEX)
            endif()
            string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1u," _words "${_hex}")
            string(APPEND _text "alignas(4) static const std::uint32_t kRlLight${_kernel}${_suffix}Spv[] = {${_words}};\n")
        endforeach()
    endif()
endforeach()
file(WRITE "${OUT}" "${_text}")
