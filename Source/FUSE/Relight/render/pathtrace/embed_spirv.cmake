# FUSE Relight RL-5.1 (script mode, build step): embeds the path tracer's SPIR-V into a C++ header.
#   cmake -DOUT=<header> [-DSLANG_TRACE=<spv>] [-DGLSL_TRACE=<spv>] -P embed_spirv.cmake
set(_text "// Generated by Source/FUSE/Relight/render/pathtrace/embed_spirv.cmake from render/pathtrace/shaders/rl_pt_trace.*. Do not edit.\n")
string(APPEND _text "#pragma once\n#include <cstdint>\n")
foreach(_lang SLANG GLSL)
    if(_lang STREQUAL "SLANG")
        set(_suffix Slang)
    else()
        set(_suffix Glsl)
    endif()
    set(_trace "${${_lang}_TRACE}")
    if(_trace AND EXISTS "${_trace}")
        string(APPEND _text "#define FUSE_RL_PT_${_lang} 1\n")
        file(READ "${_trace}" _hex HEX)
        string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1u," _words "${_hex}")
        string(APPEND _text "alignas(4) static const std::uint32_t kRlPtTrace${_suffix}Spv[] = {${_words}};\n")
    endif()
endforeach()
file(WRITE "${OUT}" "${_text}")
