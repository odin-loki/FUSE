# FUSE Relight RL-5.4 (script mode, build step): embeds the radiance cache stage kernel's SPIR-V into a C++ header.
#   cmake -DOUT=<header> [-DSLANG_SPV=<spv>] [-DGLSL_SPV=<spv>] -P radiance_cache_embed.cmake
set(_text "// Generated by Source/FUSE/Relight/render/pathtrace/radiance_cache/radiance_cache_embed.cmake. Do not edit.\n")
string(APPEND _text "#pragma once\n#include <cstdint>\n")
foreach(_lang SLANG GLSL)
    if(_lang STREQUAL "SLANG")
        set(_suffix Slang)
    else()
        set(_suffix Glsl)
    endif()
    set(_spv "${${_lang}_SPV}")
    if(_spv AND EXISTS "${_spv}")
        string(APPEND _text "#define FUSE_RL_RADIANCE_CACHE_${_lang} 1\n")
        file(READ "${_spv}" _hex HEX)
        string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1u," _words "${_hex}")
        string(APPEND _text "alignas(4) static const std::uint32_t kRlRadianceCache${_suffix}Spv[] = {${_words}};\n")
    endif()
endforeach()
file(WRITE "${OUT}" "${_text}")
