# FUSE Relight RL-5.6 (script mode, build step): embeds a kernel's SPIR-V (Slang and / or GLSL build) into a header.
#   cmake -DOUT=<header> -DNAME=<Name> -DMACRO=<MACRO> [-DSLANG_SPV=<spv>] [-DGLSL_SPV=<spv>] -P embed_spirv.cmake
# Emits kRl<Name>{Slang,Glsl}Spv and FUSE_RL_<MACRO>_{SLANG,GLSL}.
set(_text "// Generated by Source/FUSE/Relight/render/volumetrics/embed_spirv.cmake. Do not edit.\n")
string(APPEND _text "#pragma once\n#include <cstdint>\n")
foreach(_lang SLANG GLSL)
    if(_lang STREQUAL "SLANG")
        set(_suffix Slang)
    else()
        set(_suffix Glsl)
    endif()
    set(_spv "${${_lang}_SPV}")
    if(_spv AND EXISTS "${_spv}")
        string(APPEND _text "#define FUSE_RL_${MACRO}_${_lang} 1\n")
        file(READ "${_spv}" _hex HEX)
        string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1u," _words "${_hex}")
        string(APPEND _text "alignas(4) static const std::uint32_t kRl${NAME}${_suffix}Spv[] = {${_words}};\n")
    endif()
endforeach()
file(WRITE "${OUT}" "${_text}")
