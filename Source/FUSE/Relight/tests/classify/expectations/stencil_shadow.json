        "shadow_volume": {"status": "ignored", "reason": "ColorWriteDisabled", "decision": "raster"},
        "shadow_darken": {"status": "rasterized", "reason": "PositionT"}
      }
    },
    {
      "name": "positiont_is_ui",
      "conf": ["rtx.preTransformedVerticesIsUI = True"],
      "tags": {
        "world": {"status": "raytraced"},
        "shadow_volume": {"status": "ignored", "reason": "ColorWriteDisabled"},
        "shadow_darken": {"status": "rasterized", "reason": "PositionTAsUI", "inject": true}
      }
    }
  ]
