# RL-6.1 build step (script mode): embed the overlay compose pass's SPIR-V into a C++ header.
#   cmake -DOUT=<header> [-DSLANG=<spv>] [-DGLSL=<spv>] -P overlay_embed.cmake
# Each given one becomes `alignas(4) static const std::uint32_t kOverlayCompose<Slang|Glsl>Spv[]` (little-endian
# words) and kOverlayHave<Slang|Glsl> says which exist.
cmake_minimum_required(VERSION 3.20)
if(NOT OUT)
    message(FATAL_ERROR "overlay_embed.cmake: OUT is required")
endif()
set(_text "// Generated by Source/FUSE/Relight/overlay/overlay_embed.cmake. Do not edit.\n#pragma once\n#include <cstdint>\n")
foreach(_lang Slang Glsl)
    string(TOUPPER "${_lang}" _var)
    if(${_var} AND EXISTS "${${_var}}")
        file(READ "${${_var}}" _hex HEX)
        string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1u," _words "${_hex}")
        string(APPEND _text "inline constexpr bool kOverlayHave${_lang} = true;\n")
        string(APPEND _text "alignas(4) static const std::uint32_t kOverlayCompose${_lang}Spv[] = {${_words}};\n")
    else()
        string(APPEND _text "inline constexpr bool kOverlayHave${_lang} = false;\n")
        string(APPEND _text "alignas(4) static const std::uint32_t kOverlayCompose${_lang}Spv[] = {0u};\n")
    endif()
endforeach()
file(WRITE "${OUT}" "${_text}")
