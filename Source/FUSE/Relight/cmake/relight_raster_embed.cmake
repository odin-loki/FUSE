# RL-4.2 build step (script mode): embed the raster remaster's SPIR-V into a C++ header.
#   cmake -DOUT=<header> -DKEYS=<Key>,<Key>... -D<Key>=<spv> ... -P relight_raster_embed.cmake
# Each <Key> becomes `alignas(4) static const std::uint32_t kRaster<Key>Spv[]` (little-endian words).
# Used by Source/FUSE/Relight/render/raster/CMakeLists.txt.
cmake_minimum_required(VERSION 3.20)
if(NOT OUT OR NOT KEYS)
    message(FATAL_ERROR "relight_raster_embed.cmake: OUT and KEYS are required")
endif()
string(REPLACE "," ";" _keys "${KEYS}")
set(_text "// Generated by Source/FUSE/Relight/cmake/relight_raster_embed.cmake from Relight/shaders/raster. Do not edit.\n")
string(APPEND _text "#pragma once\n#include <cstdint>\n")
foreach(_key IN LISTS _keys)
    if(NOT ${_key} OR NOT EXISTS "${${_key}}")
        message(FATAL_ERROR "relight_raster_embed.cmake: no SPIR-V for ${_key}")
    endif()
    file(READ "${${_key}}" _hex HEX)
    string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1u," _words "${_hex}")
    string(APPEND _text "alignas(4) static const std::uint32_t kRaster${_key}Spv[] = {${_words}};\n")
endforeach()
file(WRITE "${OUT}" "${_text}")
