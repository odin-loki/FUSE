#version 460
// WP-5.1 expand, GLSL twin of meshlet_expand.slang. One invocation per culler draw slot of phase
// `pc.phase`: the drawn instance's meshlets become ceil(meshletCount / 32) MeshletGroup records in
// region phase - 1 (contiguous and in meshlet order per instance, appended with atomics), and the
// region's VkDrawMeshTasksIndirectCommandEXT.x becomes min(records requested, capacity).
#extension GL_GOOGLE_include_directive : require
#include "bindless.glsl"
#include "gpu_scene.glsl"
#include "cull_common.glsl"
#include "meshlet_common.glsl"

layout(local_size_x = 64) in;

FUSE_BINDLESS_SSBO_LAYOUT buffer FuseMeshletWords { uint w[]; } fuse_meshlet_words[];

layout(push_constant) uniform Push {
    uint64_t constants;
    uint phase;
    uint maxDraws;
} pc;

void main() {
    FuseCullConstantsRef C = FuseCullConstantsRef(pc.constants);
    FuseMeshletTailRef M = FuseMeshletTailRef(pc.constants + FUSE_MESHLET_TAIL_OFFSET);
    const uint i = gl_GlobalInvocationID.x;
    const uint region = pc.phase - 1u;
    const uint cullCounts = fuse_handle_index(C.countsBuffer);
    const uint draws = fuse_meshlet_words[cullCounts].w[region == 0u ? FUSE_CULL_COUNT_PHASE1_DRAWS : FUSE_CULL_COUNT_PHASE2_DRAWS];
    if (i >= draws || i >= pc.maxDraws) {
        return;
    }
    const uint slot = (region == 0u ? 0u : C.phase2DrawBase) + i;
    const uint instance = fuse_meshlet_words[fuse_handle_index(C.argsBuffer)].w[slot * 5u + 4u];
    FuseGpuSceneHeaderRef scene = fuse_gpu_scene(M.scene);
    const FuseGpuInstance inst = fuse_gpu_scene_instances(scene).v[instance];
    const FuseGpuMesh mesh = fuse_gpu_scene_meshes(scene).v[inst.mesh];
    const uint counts = fuse_handle_index(M.countsBuffer);
    if (mesh.meshletCount == 0u || mesh.meshlets == 0ul || mesh.meshletVertices == 0ul || mesh.meshletTriangles == 0ul ||
        mesh.positions == 0ul) {
        atomicAdd(fuse_meshlet_words[counts].w[FUSE_MESHLET_COUNT_SKIPPED], 1u);
        return;
    }
    const uint n = (mesh.meshletCount + FUSE_MESHLET_TASK_GROUP - 1u) / FUSE_MESHLET_TASK_GROUP;
    const uint base = atomicAdd(fuse_meshlet_words[counts].w[FUSE_MESHLET_COUNT_REQUESTED0 + region], n);
    const uint cap = M.groupCapacity;
    const uint groups = fuse_handle_index(M.groupsBuffer);
    for (uint k = 0u; k < n && base + k < cap; ++k) {
        const uint r = (region * cap + base + k) * 2u;
        fuse_meshlet_words[groups].w[r] = instance;
        fuse_meshlet_words[groups].w[r + 1u] = k * FUSE_MESHLET_TASK_GROUP;
    }
    const uint end = base + n;
    atomicMax(fuse_meshlet_words[counts].w[region == 0u ? FUSE_MESHLET_COUNT_TASKS0 : FUSE_MESHLET_COUNT_TASKS1],
              min(end, cap));
    if (end > cap) {
        atomicAdd(fuse_meshlet_words[counts].w[FUSE_MESHLET_COUNT_OVERFLOW], end - max(base, cap));
    }
}
