#version 460
// "ssrc.cascade": one record (probe, direction) of cascade i per invocation: trace the cascade's screen-space
// interval over the depth buffer and merge with cascade i + 1 (bilinear fix or vanilla; the top cascade and the
// rays that end or leave the screen take the far field). CPU reference: ssrc_cascade_record / trace_segment
// (src/ssrc/ssrc_reference.cpp). GLSL twin of src_cascade.slang.
#extension GL_GOOGLE_include_directive : require
#define SRC_MATH
#include "src_common.glsl"
#include "ddgi_sample.glsl"

layout(local_size_x = 64) in;

// --- rays (ssrc_reference.cpp raySetup / pointAt / intervalOf) -------------------------------------------
struct SrcRay {
    bool valid;
    float kO;
    float kE;
    vec3 qO;
    vec3 qE;
    float len;
};

SrcRay src_ray_setup(vec3 o, vec3 d) {
    SrcRay r;
    r.valid = false;
    r.kO = 0.0;
    r.kE = 0.0;
    r.qO = vec3(0.0);
    r.qE = vec3(0.0);
    r.len = 0.0;
    precise float nearLimit = F.nearZ * 1.01;
    if (!(o.z >= nearLimit)) {
        return r;
    }
    float len = F.maxDistance;
    if (d.z < 0.0) {
        precise float toNear = (o.z - nearLimit) / (-d.z);
        len = min(len, toNear);
    }
    if (!(len > 1e-4)) {
        return r;
    }
    const vec3 e = src_add(o, src_scale(d, len));
    precise float kO = 1.0 / o.z;
    precise float kE = 1.0 / e.z;
    r.kO = kO;
    r.kE = kE;
    r.qO = src_scale(o, kO);
    r.qE = src_scale(e, kE);
    precise float ox = F.fx * r.qO.x + F.cx;
    precise float oy = F.fy * r.qO.y + F.cy;
    precise float ex = F.fx * r.qE.x + F.cx;
    precise float ey = F.fy * r.qE.y + F.cy;
    precise float dx = ex - ox;
    precise float dy = ey - oy;
    precise float l = sqrt(dx * dx + dy * dy);
    r.len = l;
    r.valid = true;
    return r;
}

vec3 src_point_at(SrcRay r, float f) {
    precise float k = r.kO + (r.kE - r.kO) * f;
    precise float inv = 1.0 / k;
    precise float qx = r.qO.x + (r.qE.x - r.qO.x) * f;
    precise float qy = r.qO.y + (r.qE.y - r.qO.y) * f;
    precise float qz = r.qO.z + (r.qE.z - r.qO.z) * f;
    precise vec3 p = vec3(qx * inv, qy * inv, qz * inv);
    return p;
}

bool src_interval(SrcRay r, uint ci, out float fA, out float fB, out bool ended) {
    const float tS = F.tStart[ci];
    const float tE = F.tEnd[ci];
    fA = 0.0;
    fB = 1.0;
    ended = false;
    if (r.len < 1e-3) {
        if (ci != 0u) {
            return false;
        }
        ended = true;
        return true;
    }
    if (tS > 0.0 && !(r.len > tS)) {
        return false;
    }
    precise float a = tS / r.len;
    fA = a;
    ended = !(tE < r.len);
    if (!ended) {
        precise float b = tE / r.len;
        fB = b;
    }
    return true;
}

// --- far field (sky + DDGI) --------------------------------------------------------------------------------
vec3 src_to_world(vec3 e, bool point) {
    precise float x = F.viewToWorld[0] * e.x + F.viewToWorld[1] * e.y + F.viewToWorld[2] * e.z;
    precise float y = F.viewToWorld[4] * e.x + F.viewToWorld[5] * e.y + F.viewToWorld[6] * e.z;
    precise float z = F.viewToWorld[8] * e.x + F.viewToWorld[9] * e.y + F.viewToWorld[10] * e.z;
    if (point) {
        precise float px = x + F.cameraWorld[0];
        precise float py = y + F.cameraWorld[1];
        precise float pz = z + F.cameraWorld[2];
        return vec3(px, py, pz);
    }
    return vec3(x, y, z);
}

vec3 src_far_field(vec3 o, vec3 d) {
    float r = F.sky[0];
    float g = F.sky[1];
    float b = F.sky[2];
    if ((F.flags & SRC_FLAG_DDGI) != 0u && F.ddgiVolume != 0ul) {
        const vec3 wo = src_to_world(vec3(o.x, -o.y, -o.z), true);
        const vec3 wd = src_to_world(vec3(d.x, -d.y, -d.z), false);
        const vec3 e = fuse_ddgi_sample_irradiance(F.ddgiVolume, wo, wd);
        precise float fr = r + e.x * F.ddgiScale;
        precise float fg = g + e.y * F.ddgiScale;
        precise float fb = b + e.z * F.ddgiScale;
        r = fr;
        g = fg;
        b = fb;
    }
    return vec3(r, g, b);
}

// --- segment march (trace_segment) ------------------------------------------------------------------------
// xyz = hit radiance, w = state (0 hit, 1 continue, 2 escaped).
float src_proj(float f, float p, float k, float c) {
    precise float r = f * (p * k) + c;
    return r;
}

// Depth of a pixel's surfel (tangent plane through its centre point: depth zc, normal n, nd = n . centre ray) on the
// view ray through screen point (x, y); the ratio to zc clamped to [0.5, 2] (patchDepth).
float src_patch_depth(float zc, float nd, vec3 n, float x, float y) {
    precise float rx = (x - F.cx) / F.fx;
    precise float ry = (y - F.cy) / F.fy;
    const float nr = src_dot(n, vec3(rx, ry, 1.0));
    if (!(abs(nr) >= 1e-6)) {
        return zc;
    }
    precise float q = nd / nr;
    float qc = q;
    if (!(qc > 0.5)) {
        qc = 0.5;
    }
    if (qc > 2.0) {
        qc = 2.0;
    }
    precise float z = zc * qc;
    return z;
}

vec4 src_trace(vec3 a, vec3 b, uint startPixel) {
    precise float ka = 1.0 / a.z;
    precise float kb = 1.0 / b.z;
    const float ax = src_proj(F.fx, a.x, ka, F.cx);
    const float ay = src_proj(F.fy, a.y, ka, F.cy);
    const float bx = src_proj(F.fx, b.x, kb, F.cx);
    const float by = src_proj(F.fy, b.y, kb, F.cy);
    precise float ddx = bx - ax;
    precise float ddy = by - ay;
    const float len = max(abs(ddx), abs(ddy));
    if (!(len >= 1e-3)) {
        return vec4(0.0, 0.0, 0.0, 1.0);
    }
    precise float q = len / F.stride;
    const float n = min(ceil(q), 1048576.0);
    const uint steps = uint(n);
    precise float fStep = F.stride / len;
    const float fw = float(F.width);
    const float fh = float(F.height);
    float prevZ = a.z;
    float prevX = ax;
    float prevY = ay;
    precise vec3 dir = vec3(b.x - a.x, b.y - a.y, b.z - a.z);
    const float kd = kb - ka;
    for (uint i = 1u; i <= steps; ++i) {
        precise float fi = float(i) * fStep;
        const float f = min(1.0, fi);
        precise float sx = ax + ddx * f;
        precise float sy = ay + ddy * f;
        if (!(sx >= 0.0 && sy >= 0.0 && sx < fw && sy < fh)) {
            return vec4(0.0, 0.0, 0.0, 2.0);
        }
        precise float den = ka + kd * f;
        precise float rayZ = 1.0 / den;
        const uint hx = uint(sx);
        const uint hy = uint(sy);
        const uint pixel = hy * F.width + hx;
        if (pixel != startPixel) {
            const vec4 g = SrcTexelsRef(F.geo).v[pixel];
            const float zc = g.x;
            if (zc > 0.0) {
                const vec3 rd = vec3(src_ray_coord(hx, F.cx, F.fx), src_ray_coord(hy, F.cy, F.fy), 1.0);
                const float nd = src_dot(g.yzw, rd);
                precise float d0 = prevZ - src_patch_depth(zc, nd, g.yzw, prevX, prevY);
                precise float d1 = rayZ - src_patch_depth(zc, nd, g.yzw, sx, sy);
                precise float th = F.thickness + F.thicknessSlope * zc;
                if ((d1 >= 0.0 && d1 <= th) || (d0 < 0.0 && d1 > th) || (d0 > th && d1 < 0.0)) {
                    const float alongRay = src_dot(g.yzw, dir);
                    const bool front = nd > 0.0 ? alongRay > 0.0 : alongRay < 0.0;
                    if (front) {
                        return vec4(SrcTexelsRef(F.lit).v[pixel].xyz, 0.0);
                    }
                    return vec4(0.0, 0.0, 0.0, 0.0);
                }
            }
        }
        prevZ = rayZ;
        prevX = sx;
        prevY = sy;
    }
    return vec4(0.0, 0.0, 0.0, 1.0);
}

// Mean of the 4 children (cascade ci + 1) of direction k on upper probe (ux, uy) over the children in the hemisphere
// of the receiving probe's normal n (all 4, solid-angle weighted, when none is); cascade 0: solid angle x cosine.
vec4 src_child_average(uint ci, uint ux, uint uy, uint k, vec3 n) {
    const uint res = F.dirRes[ci];
    const uint res2 = F.dirRes[ci + 1u];
    const uint ku = k % res;
    const uint kv = k / res;
    const uint base = (uy * F.probesX[ci + 1u] + ux) * (res2 * res2);
    const uint dirBase = F.dirOffset[ci + 1u];
    precise float sr = 0.0;
    precise float sg = 0.0;
    precise float sb = 0.0;
    precise float sv = 0.0;
    precise float sw = 0.0;
    precise float ar = 0.0;
    precise float ag = 0.0;
    precise float ab = 0.0;
    precise float av = 0.0;
    precise float aw = 0.0;
    for (uint j = 0u; j < 4u; ++j) {
        const uint ck = (2u * kv + (j >> 1u)) * res2 + 2u * ku + (j & 1u);
        const vec4 rec = src_decode(SrcRecordsRef(pc.upper).v[base + ck]);
        const vec4 dt = SrcTexelsRef(F.dirs).v[dirBase + ck];
        const float w = dt.w;
        ar = ar + w * rec.x;
        ag = ag + w * rec.y;
        ab = ab + w * rec.z;
        av = av + w * rec.w;
        aw = aw + w;
        const float cosine = src_dot(n, dt.xyz);
        if (cosine > 0.0) {
            precise float wc = w * cosine;
            const float wm = ci == 0u ? wc : w;
            sr = sr + wm * rec.x;
            sg = sg + wm * rec.y;
            sb = sb + wm * rec.z;
            sv = sv + wm * rec.w;
            sw = sw + wm;
        }
    }
    if (sw > 0.0) {
        precise vec4 m = vec4(sr / sw, sg / sw, sb / sw, sv / sw);
        return m;
    }
    precise vec4 m = vec4(ar / aw, ag / aw, ab / aw, av / aw);
    return m;
}

void main() {
    const uint index = (gl_WorkGroupID.y * pc.groupsX + gl_WorkGroupID.x) * 64u + gl_LocalInvocationID.x;
    if (index >= pc.count) {
        return;
    }
    const uint ci = pc.cascade;
    const uint res = F.dirRes[ci];
    const uint count = res * res;
    const uint k = index % count;
    const uint probe = index / count;
    const uint probeX = probe % F.probesX[ci];
    const uint probeY = probe / F.probesX[ci];
    const vec3 d = SrcTexelsRef(F.dirs).v[F.dirOffset[ci] + k].xyz;
    const bool hasUpper = ci + 1u < F.cascades;
    float r = 0.0;
    float g = 0.0;
    float b = 0.0;
    float vis = 1.0;
    const SrcProbe p = src_probe_at(ci, probeX, probeY);
    float fA = 0.0;
    float fB = 1.0;
    bool ended = false;
    SrcRay ray;
    ray.valid = false;
    if (p.valid) {
        ray = src_ray_setup(p.o, d);
    }
    bool inside = p.valid && ray.valid;
    if (inside) {
        inside = src_interval(ray, ci, fA, fB, ended);
    }
    if (!inside) {
        const vec3 farRgb = src_far_field(p.valid ? p.o : vec3(0.0), d);
        r = farRgb.x;
        g = farRgb.y;
        b = farRgb.z;
        vis = 1.0;
    } else {
        const vec3 A = src_point_at(ray, fA);
        const vec3 B = src_point_at(ray, fB);
        bool fallback = !hasUpper;
        // Cascade 0 bins centred below the probe's horizon: merge their (masked) children without tracing.
        const bool below = ci == 0u && !(src_dot(p.n, d) > 0.0);
        if (hasUpper) {
            vec4 w;
            const uvec4 q = src_bilinear(src_grid(probeX, F.spacing[ci]), src_grid(probeY, F.spacing[ci]),
                                         F.spacing[ci + 1u], F.probesX[ci + 1u], F.probesY[ci + 1u], w);
            // Parents: valid (not sky) and, plane-aware, near the child's tangent plane (all valid ones when none is).
            SrcProbe qs[4];
            bool use[4] = bool[4](false, false, false, false);
            bool anyPlane = false;
            for (uint j = 0u; j < 4u; ++j) {
                qs[j].valid = false;
                if (!(w[j] > 0.0)) {
                    continue;
                }
                qs[j] = src_probe_at(ci + 1u, (j & 1u) != 0u ? q.y : q.x, (j >> 1u) != 0u ? q.w : q.z);
                if (!qs[j].valid) {
                    continue;
                }
                const float dist = abs(src_dot(qs[j].n, src_sub(p.o, qs[j].o)));
                precise float tol = F.planeTolerance * p.o.z;
                use[j] = !(F.planeTolerance > 0.0) || dist <= tol;
                anyPlane = anyPlane || use[j];
            }
            if (!anyPlane) {
                for (uint j = 0u; j < 4u; ++j) {
                    use[j] = w[j] > 0.0 && qs[j].valid;
                }
            }
            precise float sr = 0.0;
            precise float sg = 0.0;
            precise float sb = 0.0;
            precise float sv = 0.0;
            precise float sw = 0.0;
            if ((F.flags & SRC_FLAG_BILINEAR_FIX) != 0u && !below) {
                for (uint j = 0u; j < 4u; ++j) {
                    if (!use[j]) {
                        continue;
                    }
                    const float wj = w[j];
                    const uint ux = (j & 1u) != 0u ? q.y : q.x;
                    const uint uy = (j >> 1u) != 0u ? q.w : q.z;
                    vec3 target = B;
                    bool toParent = false;
                    const SrcRay qr = src_ray_setup(qs[j].o, d);
                    if (qr.valid && qr.len >= 1e-3 && F.tEnd[ci] < qr.len) {
                        precise float ft = F.tEnd[ci] / qr.len;
                        target = src_point_at(qr, ft);
                        toParent = true;
                    }
                    const vec4 s = src_trace(A, target, p.pixel);
                    vec4 val;
                    if (s.w == 0.0) {
                        val = vec4(s.xyz, 0.0);
                    } else if (s.w == 2.0 || (!toParent && ended)) {
                        val = vec4(src_far_field(p.o, d), 1.0);
                    } else {
                        val = src_child_average(ci, ux, uy, k, p.n);
                    }
                    sr = sr + wj * val.x;
                    sg = sg + wj * val.y;
                    sb = sb + wj * val.z;
                    sv = sv + wj * val.w;
                    sw = sw + wj;
                }
                if (sw > 0.0) {
                    precise float fr = sr / sw;
                    precise float fg = sg / sw;
                    precise float fb = sb / sw;
                    precise float fv = sv / sw;
                    r = fr;
                    g = fg;
                    b = fb;
                    vis = fv;
                } else {
                    fallback = true;
                }
            } else {
                vec4 s = vec4(0.0, 0.0, 0.0, 1.0);
                if (!below) {
                    s = src_trace(A, B, p.pixel);
                }
                if (s.w == 0.0) {
                    r = s.x;
                    g = s.y;
                    b = s.z;
                    vis = 0.0;
                } else if (s.w == 2.0 || (ended && !below)) {
                    const vec3 farRgb = src_far_field(p.o, d);
                    r = farRgb.x;
                    g = farRgb.y;
                    b = farRgb.z;
                    vis = 1.0;
                } else {
                    for (uint j = 0u; j < 4u; ++j) {
                        if (!use[j]) {
                            continue;
                        }
                        const float wj = w[j];
                        const uint ux = (j & 1u) != 0u ? q.y : q.x;
                        const uint uy = (j >> 1u) != 0u ? q.w : q.z;
                        const vec4 val = src_child_average(ci, ux, uy, k, p.n);
                        sr = sr + wj * val.x;
                        sg = sg + wj * val.y;
                        sb = sb + wj * val.z;
                        sv = sv + wj * val.w;
                        sw = sw + wj;
                    }
                    if (sw > 0.0) {
                        precise float fr = sr / sw;
                        precise float fg = sg / sw;
                        precise float fb = sb / sw;
                        precise float fv = sv / sw;
                        r = fr;
                        g = fg;
                        b = fb;
                        vis = fv;
                    } else {
                        const vec3 farRgb = src_far_field(p.o, d);
                        r = farRgb.x;
                        g = farRgb.y;
                        b = farRgb.z;
                        vis = 1.0;
                    }
                }
            }
        }
        if (fallback) {
            const vec4 s = src_trace(A, B, p.pixel);
            if (s.w == 0.0) {
                r = s.x;
                g = s.y;
                b = s.z;
                vis = 0.0;
            } else {
                const vec3 farRgb = src_far_field(p.o, d);
                r = farRgb.x;
                g = farRgb.y;
                b = farRgb.z;
                vis = 1.0;
            }
        }
    }
    if (ci >= F.aoCascades) {
        vis = 1.0;
    }
    SrcRecordsRef(pc.dst).v[index] =
        uvec2(src_f32_to_f16(r) | (src_f32_to_f16(g) << 16), src_f32_to_f16(b) | (src_f32_to_f16(vis) << 16));
}
