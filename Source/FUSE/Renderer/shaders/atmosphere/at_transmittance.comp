#version 460
// WP-8.2 "atmos.transmittance": transmittance LUT, one texel per invocation (8 x 8 tiles).
// CPU reference: atmosphere::transmittance_texel. GLSL twin of at_transmittance.slang.
#extension GL_GOOGLE_include_directive : require
#include "at_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

void main() {
    const AtParams P = at_load(pc.params);
    const uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x >= P.transWidth || p.y >= P.transHeight) {
        return;
    }
    AtTexelsRef(P.transmittance).v[p.y * P.transWidth + p.x] = at_transmittance_texel(P, p.x, p.y);
}
