#version 460
// WP-7.3 any-hit shader of both hit groups (twin: pt_any_hit.slang): ignores the triangle the ray starts on (the
// origin is also offset along the normal; this removes the remaining self-hits at grazing angles). Every other
// candidate is accepted (opaque materials; an alpha-cutout test would go here).
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_tracing : require
#include "lt_common.glsl"
#include "pt_common.glsl"
#include "pt_payload.glsl"

layout(location = 0) rayPayloadInEXT PtPayload payload;

void main() {
    if (uint(gl_InstanceID) == payload.originInstance && uint(gl_PrimitiveID) == payload.originPrimitive) {
        ignoreIntersectionEXT;
    }
}
