#version 460
// WP-2.2 GPU gate kernel (fuse_rp_ltc_vk_probe_*): evaluates the light.shade per-light code of
// lc_ltc.glsl (fuse_lc_surface_terms + fuse_lc_light_ms: compensated BRDF, LTC area lights, sun disks)
// on a list of (surface, view, light) cases; the CPU twin is lighting_gpu::surface_terms +
// light_contribution. One case per thread. GLSL twin of ltc_probe.slang.
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#include "bindless.glsl"
#include "gpu_scene.glsl"
#include "lc_common.glsl"
#include "lc_ltc.glsl"

layout(local_size_x = 64) in;

// 128 bytes (test_rp_ltc.cpp ProbeCase).
struct FuseLtcProbeCase {
    FuseGpuLight light;
    float position[3];
    float roughness;
    float normal[3];
    float metallic;
    float albedo[3];
    float pad0;
    float view[3];
    float pad1;
};
layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer FuseLtcProbeCases { FuseLtcProbeCase v[]; };
layout(buffer_reference, std430, buffer_reference_align = 16) writeonly buffer FuseLtcProbeOut { vec4 v[]; };

layout(push_constant) uniform FuseLtcProbePush {
    uint64_t cases;
    uint64_t lut;
    uint64_t out_;
    uint count;
    uint pad;
} pc;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) {
        return;
    }
    const FuseLtcProbeCase c = FuseLtcProbeCases(pc.cases).v[i];
    FuseLcSurface s;
    s.position = fuse_lc_vec3(c.position);
    s.normal = fuse_lc_vec3(c.normal);
    s.albedo = fuse_lc_vec3(c.albedo);
    s.roughness = c.roughness;
    s.metallic = c.metallic;
    s.ao = 1.0;
    s.emissive = vec3(0.0);
    const vec3 v = fuse_lc_vec3(c.view);
    FuseLcLutRef lut = FuseLcLutRef(pc.lut);
    const FuseLcTerms t = fuse_lc_surface_terms(s, v, lut);
    FuseLtcProbeOut(pc.out_).v[i] = vec4(fuse_lc_light_ms(c.light, s, v, t, lut), 0.0);
}
