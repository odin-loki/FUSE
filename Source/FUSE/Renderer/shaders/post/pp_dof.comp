#version 460
// WP-4.5 depth of field (renderer::dof_pass, dof.cpp), one texel per thread:
//   coc      per source pixel: thin-lens CoC radius (dof_coc_radius_px) clamped to the max radius,
//            stored as (radius^2, 1 / disc area in pixels) at F.cocs
//   gather   per target pixel: the oracle scatters every source's colour uniformly over its disc; the
//            gather visits the sources of the (2 reach + 1)^2 window in raster order (the order the
//            scatter adds them in), keeps those whose disc covers the target and normalises.
// GLSL twin of pp_dof.slang.
#extension GL_GOOGLE_include_directive : require
#include "pp_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

float pp_coc_radius(float depthM, PpFrame F) {
    const float f = F.dofFocalLength;
    precise float s1 = F.dofFocalDistance * 1000.0;
    precise float s2 = max(depthM * 1000.0, 1e-3);
    if (s1 <= f) {
        return 0.0;
    }
    precise float aperture = f / max(F.dofFStop, 1e-4);
    precise float coc = aperture * f * (s2 - s1) / (s2 * (s1 - f));
    if (coc < 0.0 && (F.flags & PP_FLAG_DOF_NEAR_BLUR) == 0u) {
        return 0.0;
    }
    const float sensor = max(F.dofSensorWidth, 1e-4);
    precise float r = 0.5 * coc / sensor * float(F.width);
    return r;
}

void main() {
    const PpFrame F = pp_frame();
    const uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x >= F.width || p.y >= F.height) {
        return;
    }
    const uint index = p.y * F.width + p.x;
    PpPairsRef cocs = PpPairsRef(F.cocs);
    if (pc.mode == 0u) {
        const float depth = pp_fetch(F.inputDepth, ivec2(p)).x;
        const float radius = min(abs(pp_coc_radius(depth, F)), max(F.dofMaxRadius, 0.0));
        const int reach = int(floor(radius));
        precise float radiusSq = radius * radius;
        uint area = 0u;
        for (int dy = -reach; dy <= reach; ++dy) {
            for (int dx = -reach; dx <= reach; ++dx) {
                if (float(dx * dx + dy * dy) <= radiusSq) {
                    ++area;
                }
            }
        }
        cocs.v[index] = vec2(radiusSq, 1.0 / float(max(area, 1u)));
        return;
    }
    PpTexelsRef src = PpTexelsRef(pc.src);
    const int reach = int(F.dofReach);
    precise vec3 accum = vec3(0.0);
    precise float weight = 0.0;
    for (int dy = -reach; dy <= reach; ++dy) {
        const int sy = int(p.y) + dy;
        if (sy < 0 || sy >= int(F.height)) {
            continue;
        }
        for (int dx = -reach; dx <= reach; ++dx) {
            const int sx = int(p.x) + dx;
            if (sx < 0 || sx >= int(F.width)) {
                continue;
            }
            const uint s = uint(sy) * F.width + uint(sx);
            const vec2 coc = cocs.v[s];
            if (float(dx * dx + dy * dy) > coc.x) {
                continue;
            }
            accum = accum + src.v[s].xyz * coc.y;
            weight += coc.y;
        }
    }
    precise vec3 result = weight > 0.0 ? accum * (1.0 / weight) : src.v[index].xyz;
    PpTexelsRef(pc.dst).v[index] = vec4(result, 0.0);
}
