#version 460
// WP-4.5 "post.display": the per-pixel display transform, one texel per thread, in the oracle's order
//   exposure    x 2^EV (host scale, or 2^(EV - adapted EV) from the GPU adaptation state)
//   curve       pre-tonemap curve (evaluate_tonemap_curve_channel)
//   tone map    ACES / Filmic / Reinhard / Neutral / AgX (apply_tone_map)
//   grade       PostStack: grade_linear's clamp, lift + contrast, saturation, gamma + gain (each stage
//               only when non-neutral); Look: the baked 3D LUT (look GradeLutKernel)
//   vignette    PostStack vignette_factor | look vignette_gain + tint
//   grain       PostStack apply_film_grain | look FilmGrainKernel
//   finalize    saturate + sRGB OETF (finalize_display / look output_encode sRGB)
// Writes the RGBA16F output (bindless storage image) and the f32 dump when F.dump != 0.
// GLSL twin of pp_display.slang.
#extension GL_GOOGLE_include_directive : require
#include "pp_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

FUSE_BINDLESS_STORAGE_IMAGE_LAYOUT(rgba16f) uniform writeonly image2D fuse_pp_images[];

void main() {
    const PpFrame F = pp_frame();
    const uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x >= F.width || p.y >= F.height) {
        return;
    }
    const uint index = p.y * F.width + p.x;
    precise vec3 c = PpTexelsRef(pc.src).v[index].xyz;
    float scale = F.exposureScale;
    if ((F.flags & PP_FLAG_AUTO_EXPOSURE) != 0u) {
        precise float ev = F.exposureEv - PpFloatsRef(F.exposureState).v[PP_STATE_CURRENT_EV];
        scale = exp2(ev);
    }
    c = vec3(c.x * scale, c.y * scale, c.z * scale);
    if ((F.flags & PP_FLAG_CURVE) != 0u) {
        c = vec3(pp_curve_channel(c.x, F), pp_curve_channel(c.y, F), pp_curve_channel(c.z, F));
    }
    c = pp_tonemap(c, F.toneMapper);
    if ((F.flags & PP_FLAG_GRADE_CLAMP) != 0u) {
        c = vec3(pp_saturate(c.x), pp_saturate(c.y), pp_saturate(c.z));
    }
    if ((F.flags & PP_FLAG_GRADE_LIFT_CONTRAST) != 0u) {
        precise vec3 lifted = vec3(c.x + F.lift[0], c.y + F.lift[1], c.z + F.lift[2]) - vec3(0.5);
        c = lifted * F.contrast + vec3(0.5);
    }
    if ((F.flags & PP_FLAG_GRADE_SATURATION) != 0u) {
        const float lum = pp_luminance(c);
        c = vec3(lum) + (c - vec3(lum)) * F.saturation;
    }
    if ((F.flags & PP_FLAG_GRADE_GAMMA_GAIN) != 0u) {
        c = vec3(pow(max(c.x, 0.0), F.invGamma[0]) * F.gain[0], pow(max(c.y, 0.0), F.invGamma[1]) * F.gain[1],
                 pow(max(c.z, 0.0), F.invGamma[2]) * F.gain[2]);
    }
    if ((F.flags & PP_FLAG_LUT) != 0u) {
        const vec3 v = max(c, vec3(0.0));
        const vec3 base = min(v, vec3(1.0));
        const vec3 e = vec3(pp_srgb_encode(base.x), pp_srgb_encode(base.y), pp_srgb_encode(base.z));
        const vec3 s = pp_lut_tetrahedral(F.lut, F.lutSize, e);
        const vec3 graded = vec3(pp_srgb_decode(pp_saturate(s.x)), pp_srgb_decode(pp_saturate(s.y)),
                                 pp_srgb_decode(pp_saturate(s.z)));
        precise vec3 headroom = v - base;
        c = graded + headroom;
    }
    if ((F.flags & PP_FLAG_VIGNETTE_STACK) != 0u) {
        precise float u = (float(p.x) + 0.5) / float(F.width) * 2.0 - 1.0;
        precise float v = (float(p.y) + 0.5) / float(F.height) * 2.0 - 1.0;
        precise float r2 = 0.5 * (u * u + v * v);
        const float factor = max(1.0 - F.vignette * r2, 0.0);
        c = c * factor;
    } else if ((F.flags & PP_FLAG_VIGNETTE_LOOK) != 0u) {
        precise float u = (float(p.x) + 0.5) / float(F.width) * 2.0 - 1.0;
        precise float v = (float(p.y) + 0.5) / float(F.height) * 2.0 - 1.0;
        precise float aspect = float(F.width) / float(F.height);
        precise float xs = 1.0 + (aspect - 1.0) * F.vignetteRoundness;
        precise float x = u * xs;
        precise float r = sqrt((x * x + v * v) / (xs * xs + 1.0));
        const float g = max(1.0 - F.vignette * pow(r, F.vignetteFalloff), 0.0);
        precise vec3 tinted = c * g + vec3(F.vignetteTint[0], F.vignetteTint[1], F.vignetteTint[2]) * (1.0 - g);
        c = tinted;
    }
    if ((F.flags & PP_FLAG_GRAIN_STACK) != 0u) {
        precise float g = pp_grain_noise(F, p.x, p.y) * F.grain;
        c = c + vec3(g);
    } else if ((F.flags & PP_FLAG_GRAIN_LOOK) != 0u) {
        precise float amp = F.grain * (1.0 - F.grainResponse * pp_saturate(pp_luminance(c)));
        precise float g = pp_grain_noise(F, p.x, p.y) * amp;
        c = c + vec3(g);
    }
    vec3 outColor = vec3(pp_saturate(c.x), pp_saturate(c.y), pp_saturate(c.z));
    if ((F.flags & PP_FLAG_SRGB) != 0u) {
        outColor = vec3(pp_srgb_encode(outColor.x), pp_srgb_encode(outColor.y), pp_srgb_encode(outColor.z));
    }
    const vec4 result = vec4(outColor, 1.0);
    imageStore(fuse_pp_images[fuse_handle_index(F.output_)], ivec2(p), result);
    if (F.dump != 0ul) {
        PpTexelsRef(F.dump).v[index] = result;
    }
}
