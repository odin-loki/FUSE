#version 460
// GPU skinning in the GPU scene ("skin.lbs"): linear blend skinning of one vertex per thread (x), one skinned
// instance per workgroup row (y). Line-for-line twin of the CPU kernel fuse::animation::skinning_kernel::skin_vertex
// ("skinning_lbs"): the same operations in the same order without contraction (`precise`), correctly rounded sqrt /
// division (common/exact_math.glsl), so the output is bit-identical to the CPU. Skins the rest pose with this
// frame's palette (positions + normals) and with the previous palette (positions only). Records:
// include/fuse/renderer/skinning/skinning_gpu_types.hpp. GLSL twin of skin_lbs.slang.
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_GOOGLE_include_directive : require
#include "../common/exact_math.glsl"

layout(local_size_x = 128) in;

#define FUSE_SKIN_JOB_NORMALS 1u

struct FuseSkinJob {
    uint64_t rest;
    uint64_t palette;
    uint64_t prevPalette;
    uint64_t out_;
    uint vertexCount;
    uint boneCount;
    uint flags;
    uint pad;
};

layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer FuseSkinJobsRef { FuseSkinJob v[]; };
layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer FuseSkinVec4InRef { vec4 v[]; };
layout(buffer_reference, std430, buffer_reference_align = 16) writeonly buffer FuseSkinVec4OutRef { vec4 v[]; };
layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer FuseSkinWeightsRef { uvec4 v[]; };
layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer FuseSkinFloatsRef { float v[]; };

layout(push_constant) uniform FuseSkinPush {
    uint64_t jobs;
    uint jobCount;
    uint pad;
} pc;

struct FuseSkinResult {
    vec3 position;
    vec3 normal;
};

// skinning_kernel::skin_vertex for one palette (the normal sum is unnormalised here).
FuseSkinResult fuse_skin(FuseSkinFloatsRef pal, uint boneCount, vec3 rp, vec3 rn, uvec4 bones, vec4 weights) {
    precise float px = 0.0;
    precise float py = 0.0;
    precise float pz = 0.0;
    precise float nx = 0.0;
    precise float ny = 0.0;
    precise float nz = 0.0;
    for (uint k = 0u; k < 4u; ++k) {
        const float weight = weights[k];
        if (weight <= 0.0) {
            continue;
        }
        const uint bone = bones[k];
        if (bone >= boneCount) {
            continue;
        }
        const uint o = bone * 16u;
        precise float tx = pal.v[o + 0u] * rp.x + pal.v[o + 4u] * rp.y + pal.v[o + 8u] * rp.z + pal.v[o + 12u];
        precise float ty = pal.v[o + 1u] * rp.x + pal.v[o + 5u] * rp.y + pal.v[o + 9u] * rp.z + pal.v[o + 13u];
        precise float tz = pal.v[o + 2u] * rp.x + pal.v[o + 6u] * rp.y + pal.v[o + 10u] * rp.z + pal.v[o + 14u];
        precise float ux = pal.v[o + 0u] * rn.x + pal.v[o + 4u] * rn.y + pal.v[o + 8u] * rn.z;
        precise float uy = pal.v[o + 1u] * rn.x + pal.v[o + 5u] * rn.y + pal.v[o + 9u] * rn.z;
        precise float uz = pal.v[o + 2u] * rn.x + pal.v[o + 6u] * rn.y + pal.v[o + 10u] * rn.z;
        px += tx * weight;
        py += ty * weight;
        pz += tz * weight;
        nx += ux * weight;
        ny += uy * weight;
        nz += uz * weight;
    }
    FuseSkinResult r;
    r.position = vec3(px, py, pz);
    r.normal = vec3(nx, ny, nz);
    return r;
}

void main() {
    const uint job = gl_WorkGroupID.y;
    if (job >= pc.jobCount) {
        return;
    }
    const FuseSkinJob j = FuseSkinJobsRef(pc.jobs).v[job];
    const uint v = gl_GlobalInvocationID.x;
    if (v >= j.vertexCount) {
        return;
    }
    const uint n = j.vertexCount;
    const bool hasNormals = (j.flags & FUSE_SKIN_JOB_NORMALS) != 0u;
    FuseSkinVec4InRef rest = FuseSkinVec4InRef(j.rest);
    const vec4 rp = rest.v[v];
    const vec3 rn = hasNormals ? rest.v[n + v].xyz : vec3(0.0);
    FuseSkinWeightsRef w = FuseSkinWeightsRef(j.rest + uint64_t(n) * 32ul);
    const uvec4 bones = w.v[v * 2u];
    const vec4 weights = uintBitsToFloat(w.v[v * 2u + 1u]);
    FuseSkinVec4OutRef out_ = FuseSkinVec4OutRef(j.out_);

    const FuseSkinResult cur = fuse_skin(FuseSkinFloatsRef(j.palette), j.boneCount, rp.xyz, rn, bones, weights);
    out_.v[v] = vec4(cur.position, rp.w);
    if (hasNormals) {
        float nx = cur.normal.x;
        float ny = cur.normal.y;
        float nz = cur.normal.z;
        precise float sq = nx * nx + ny * ny + nz * nz;
        const float len = fuse_sqrt_rn(sq);
        if (len > 1e-8) {
            nx = fuse_div_rn(nx, len);
            ny = fuse_div_rn(ny, len);
            nz = fuse_div_rn(nz, len);
        }
        out_.v[2u * n + v] = vec4(nx, ny, nz, 0.0);
    }
    const FuseSkinResult prev = fuse_skin(FuseSkinFloatsRef(j.prevPalette), j.boneCount, rp.xyz, vec3(0.0), bones, weights);
    out_.v[n + v] = vec4(prev.position, rp.w);
}
