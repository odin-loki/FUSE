#version 460
// WP-6.1 "ddgi.probe" (twin: ddgi_probe.slang): the volume's irradiance at explicit surface points through
// the shared sampling code the lighting shade uses (ddgi_sample.glsl, with the point's view direction). One thread per DdgiProbePoint at
// pc.aux; f32x4 (E, 1) at pc.out_. The exit-test instrument of the sampling path (and a small API for
// consumers without a G-buffer).
#extension GL_GOOGLE_include_directive : require
#include "ddgi_common.glsl"

layout(local_size_x = FUSE_DDGI_WORKGROUP) in;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) {
        return;
    }
    const FuseDdgiPoint p = FuseDdgiPointsRef(pc.aux).v[i];
    const vec3 e = fuse_ddgi_sample_irradiance_view(pc.frame, p.position.xyz, p.normal.xyz, p.view.xyz);
    FuseDdgiVec4Ref(pc.out_).v[i] = vec4(e, 1.0);
}
