#version 460
// WP-3.2 "vsm.probe" (gates / debugging): the shadow lookup light.shade makes, at explicit world
// points: out[i] = {visibility, level, receiver depth, margin} of in[i] (VsmProbeInput: position,
// light slot, normal, forced directional level or -1). GLSL twin of vsm_probe.slang.
#extension GL_GOOGLE_include_directive : require
#include "vsm_raster_common.glsl"

layout(local_size_x = 64) in;

struct FuseVsmrProbeIn {
    float position[3];
    uint slot;
    float normal[3];
    int level;
};
layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer FuseVsmrProbeInRef { FuseVsmrProbeIn v[]; };
layout(buffer_reference, std430, buffer_reference_align = 16) writeonly buffer FuseVsmrProbeOutRef { vec4 v[]; };

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) {
        return;
    }
    const FuseVsmrProbeIn p = FuseVsmrProbeInRef(pc.in_).v[i];
    const FuseVsmrSample r = fuse_vsmr_shadow_sample(pc.shadow, p.slot, vec3(p.position[0], p.position[1], p.position[2]),
                                                      vec3(p.normal[0], p.normal[1], p.normal[2]), p.level);
    FuseVsmrProbeOutRef(pc.out_).v[i] = vec4(r.visibility, intBitsToFloat(r.level), r.receiverDepth, r.margin);
}
