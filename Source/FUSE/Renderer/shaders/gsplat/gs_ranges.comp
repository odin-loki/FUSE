#version 460
// WP-9.2 "gsplat.ranges": one thread per sorted entry below min(emitted, capacity). A tile's first entry
// writes its range begin, its last the end (ranges zeroed by gsplat.scan: untouched tiles stay empty). CPU
// reference: gs_render_reference (ranges). GLSL twin of gs_ranges.slang.
#extension GL_GOOGLE_include_directive : require
#include "gs_common.glsl"

layout(local_size_x = 256) in;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    const uint count = min(GsUintsRef(F.counters).v[0], F.capacity);
    if (i >= count) {
        return;
    }
    GsKeysRef keys = GsKeysRef(F.keys);
    GsUintsRef ranges = GsUintsRef(F.ranges);
    const uint tile = uint(keys.v[i] >> 32);
    if (i == 0u || uint(keys.v[i - 1u] >> 32) != tile) {
        ranges.v[tile * 2u] = i;
    }
    if (i + 1u == count || uint(keys.v[i + 1u] >> 32) != tile) {
        ranges.v[tile * 2u + 1u] = i + 1u;
    }
}
