#version 460
// WP-9.2 "gsplat.preprocess": one thread per splat. World -> camera, near cull, 3D covariance R S S^T R^T, EWA
// projection J W Sigma W^T J^T + low-pass, conic, 3-sigma radius, tile rectangle, SH radiance. Writes the
// GsProjected record (all zero when culled). CPU reference: gs_preprocess_splat / gs_eval_sh
// (gsplat_reference.cpp), same operation order. GLSL twin of gs_preprocess.slang.
#extension GL_GOOGLE_include_directive : require
#include "gs_common.glsl"

layout(local_size_x = 256) in;

const float kShC0 = 0.28209479177387814;
const float kShC1 = 0.4886025119029199;
const float kShC20 = 1.0925484305920792;
const float kShC21 = -1.0925484305920792;
const float kShC22 = 0.31539156525252005;
const float kShC23 = -1.0925484305920792;
const float kShC24 = 0.5462742152960396;
const float kShC30 = -0.5900435899266435;
const float kShC31 = 2.890611442640554;
const float kShC32 = -0.4570457994644658;
const float kShC33 = 0.3731763325901154;
const float kShC34 = -0.4570457994644658;
const float kShC35 = 1.445305721320277;
const float kShC36 = -0.5900435899266435;

float gs_sh_channel(uint base, uint c, uint degree, float x, float y, float z) {
    GsFloatsRef s = GsFloatsRef(F.splats);
    const uint sh = base + 12u + c;
    precise float xx = x * x;
    precise float yy = y * y;
    precise float zz = z * z;
    precise float xy = x * y;
    precise float yz = y * z;
    precise float xz = x * z;
    precise float res = kShC0 * s.v[sh + 0u];
    if (degree > 0u) {
        res = res - kShC1 * y * s.v[sh + 3u] + kShC1 * z * s.v[sh + 6u] - kShC1 * x * s.v[sh + 9u];
        if (degree > 1u) {
            res = res + kShC20 * xy * s.v[sh + 12u] + kShC21 * yz * s.v[sh + 15u] +
                  kShC22 * (2.0 * zz - xx - yy) * s.v[sh + 18u] + kShC23 * xz * s.v[sh + 21u] +
                  kShC24 * (xx - yy) * s.v[sh + 24u];
            if (degree > 2u) {
                res = res + kShC30 * y * (3.0 * xx - yy) * s.v[sh + 27u] + kShC31 * xy * z * s.v[sh + 30u] +
                      kShC32 * y * (4.0 * zz - xx - yy) * s.v[sh + 33u] +
                      kShC33 * z * (2.0 * zz - 3.0 * xx - 3.0 * yy) * s.v[sh + 36u] +
                      kShC34 * x * (4.0 * zz - xx - yy) * s.v[sh + 39u] + kShC35 * z * (xx - yy) * s.v[sh + 42u] +
                      kShC36 * x * (xx - 3.0 * yy) * s.v[sh + 45u];
            }
        }
    }
    res = res + 0.5;
    return res > 0.0 ? res : 0.0;
}

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= F.splatCount) {
        return;
    }
    GsProjectedRef outp = GsProjectedRef(F.projected);
    const uvec4 zero = uvec4(0u);
    GsFloatsRef s = GsFloatsRef(F.splats);
    const uint base = i * GS_SPLAT_FLOATS;
    const float px = s.v[base + 0u];
    const float py = s.v[base + 1u];
    const float pz = s.v[base + 2u];
    precise float tx = F.view[0] * px + F.view[1] * py + F.view[2] * pz + F.view[3];
    precise float ty = F.view[4] * px + F.view[5] * py + F.view[6] * pz + F.view[7];
    precise float tz = F.view[8] * px + F.view[9] * py + F.view[10] * pz + F.view[11];
    bool culled = !(tz > F.nearZ);
    uvec4 w0 = zero, w1 = zero, w2 = zero, w3 = zero;
    if (!culled) {
        const float qw = s.v[base + 8u];
        const float qx = s.v[base + 9u];
        const float qy = s.v[base + 10u];
        const float qz = s.v[base + 11u];
        const float sx = s.v[base + 4u];
        const float sy = s.v[base + 5u];
        const float sz = s.v[base + 6u];
        precise float m00 = (1.0 - 2.0 * (qy * qy + qz * qz)) * sx;
        precise float m01 = (2.0 * (qx * qy - qw * qz)) * sy;
        precise float m02 = (2.0 * (qx * qz + qw * qy)) * sz;
        precise float m10 = (2.0 * (qx * qy + qw * qz)) * sx;
        precise float m11 = (1.0 - 2.0 * (qx * qx + qz * qz)) * sy;
        precise float m12 = (2.0 * (qy * qz - qw * qx)) * sz;
        precise float m20 = (2.0 * (qx * qz - qw * qy)) * sx;
        precise float m21 = (2.0 * (qy * qz + qw * qx)) * sy;
        precise float m22 = (1.0 - 2.0 * (qx * qx + qy * qy)) * sz;
        precise float s00 = m00 * m00 + m01 * m01 + m02 * m02;
        precise float s01 = m00 * m10 + m01 * m11 + m02 * m12;
        precise float s02 = m00 * m20 + m01 * m21 + m02 * m22;
        precise float s11 = m10 * m10 + m11 * m11 + m12 * m12;
        precise float s12 = m10 * m20 + m11 * m21 + m12 * m22;
        precise float s22 = m20 * m20 + m21 * m21 + m22 * m22;
        precise float limx = 1.3 * F.tanFovX;
        precise float limy = 1.3 * F.tanFovY;
        precise float cxz = gs_clamp(tx / tz, -limx, limx) * tz;
        precise float cyz = gs_clamp(ty / tz, -limy, limy) * tz;
        precise float tz2 = tz * tz;
        precise float j00 = F.fx / tz;
        precise float j02 = -(F.fx * cxz) / tz2;
        precise float j11 = F.fy / tz;
        precise float j12 = -(F.fy * cyz) / tz2;
        precise float t00 = j00 * F.view[0] + j02 * F.view[8];
        precise float t01 = j00 * F.view[1] + j02 * F.view[9];
        precise float t02 = j00 * F.view[2] + j02 * F.view[10];
        precise float t10 = j11 * F.view[4] + j12 * F.view[8];
        precise float t11 = j11 * F.view[5] + j12 * F.view[9];
        precise float t12 = j11 * F.view[6] + j12 * F.view[10];
        precise float u00 = t00 * s00 + t01 * s01 + t02 * s02;
        precise float u01 = t00 * s01 + t01 * s11 + t02 * s12;
        precise float u02 = t00 * s02 + t01 * s12 + t02 * s22;
        precise float u10 = t10 * s00 + t11 * s01 + t12 * s02;
        precise float u11 = t10 * s01 + t11 * s11 + t12 * s12;
        precise float u12 = t10 * s02 + t11 * s12 + t12 * s22;
        precise float a = u00 * t00 + u01 * t01 + u02 * t02 + F.lowPass;
        precise float b = u00 * t10 + u01 * t11 + u02 * t12;
        precise float c = u10 * t10 + u11 * t11 + u12 * t12 + F.lowPass;
        precise float det = a * c - b * b;
        culled = !(det > 0.0);
        if (!culled) {
            precise float inv = 1.0 / det;
            precise float mid = 0.5 * (a + c);
            precise float disc = sqrt(max(0.1, mid * mid - det));
            precise float lambda = mid + disc;
            precise float radius = ceil(3.0 * sqrt(lambda));
            precise float mx = F.fx * tx / tz + F.cx;
            precise float my = F.fy * ty / tz + F.cy;
            const float tiles = float(GS_TILE);
            precise float fminX = (mx - radius) / tiles;
            precise float fminY = (my - radius) / tiles;
            precise float fmaxX = (mx + radius + (tiles - 1.0)) / tiles;
            precise float fmaxY = (my + radius + (tiles - 1.0)) / tiles;
            const uint minX = uint(gs_clamp(fminX, 0.0, float(F.tilesX)));
            const uint minY = uint(gs_clamp(fminY, 0.0, float(F.tilesY)));
            const uint maxX = uint(gs_clamp(fmaxX, 0.0, float(F.tilesX)));
            const uint maxY = uint(gs_clamp(fmaxY, 0.0, float(F.tilesY)));
            culled = !(radius > 0.0) || maxX <= minX || maxY <= minY;
            if (!culled) {
                precise float dx = px - F.camPos[0];
                precise float dy = py - F.camPos[1];
                precise float dz = pz - F.camPos[2];
                precise float len = sqrt(dx * dx + dy * dy + dz * dz);
                precise float nx = 0.0;
                precise float ny = 0.0;
                precise float nz = 0.0;
                if (len > 0.0) {
                    nx = dx / len;
                    ny = dy / len;
                    nz = dz / len;
                }
                const float r = gs_sh_channel(base, 0u, F.shDegree, nx, ny, nz);
                const float g = gs_sh_channel(base, 1u, F.shDegree, nx, ny, nz);
                const float bl = gs_sh_channel(base, 2u, F.shDegree, nx, ny, nz);
                precise float depth = F.depthA + F.depthB / tz;
                precise float c0 = c * inv;
                precise float c1 = -b * inv;
                precise float c2 = a * inv;
                w0 = uvec4(floatBitsToUint(mx), floatBitsToUint(my), floatBitsToUint(tz), floatBitsToUint(depth));
                w1 = uvec4(floatBitsToUint(c0), floatBitsToUint(c1), floatBitsToUint(c2), floatBitsToUint(s.v[base + 3u]));
                w2 = uvec4(floatBitsToUint(r), floatBitsToUint(g), floatBitsToUint(bl), uint(radius));
                w3 = uvec4(minX, minY, maxX, maxY);
            }
        }
    }
    outp.v[i * 4u + 0u] = w0;
    outp.v[i * 4u + 1u] = w1;
    outp.v[i * 4u + 2u] = w2;
    outp.v[i * 4u + 3u] = w3;
}
