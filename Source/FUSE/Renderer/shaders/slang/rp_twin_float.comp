#version 450
// WP-0.5 GLSL twin of rp_twin_float.slang (see there); keep both in sync.
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer Inputs { vec4 inputs[]; };
layout(std430, set = 0, binding = 1) writeonly buffer Outputs { vec4 outputs[]; };
layout(push_constant) uniform TwinPush {
    uint count;
    float scale;
    float bias;
    uint pad;
} pc;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) {
        return;
    }
    const vec4 v = inputs[i];
    const vec3 n = normalize(v.xyz + vec3(1e-3));
    const float d = dot(n, vec3(0.2126, 0.7152, 0.0722));
    const float s = sqrt(abs(v.w)) * pc.scale + pc.bias;
    const float e = exp2(clamp(d * 4.0, -8.0, 8.0));
    outputs[i] = vec4(n * s, fract(e) + floor(v.w) * 0.5);
}
