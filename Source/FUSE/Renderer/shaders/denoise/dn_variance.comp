#version 460
// WP-6.4 "denoise.variance" ([SVGF] 4.2): history length < varianceHistory: 7 x 7 bilateral (depth, normal,
// luminance) estimate of colour and moments, variance boosted by varianceBoost / length; else the temporal
// variance max(0, m2 - m1^2). Writes (rgb, variance) to pc.dst.
// GLSL twin of dn_variance.slang; CPU reference: svgf_kernel::variance_pixel.
#extension GL_GOOGLE_include_directive : require
#include "dn_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

void main() {
    const DnFrame F = dn_frame();
    const uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x >= F.width || p.y >= F.height) {
        return;
    }
    const uint w = F.width;
    const uint i = p.y * w + p.x;
    DnTexelsRef guide = DnTexelsRef(F.guideCur);
    DnTexelsRef accum = DnTexelsRef(F.accum);
    DnTexelsRef moments = DnTexelsRef(F.momCur);
    DnTexelsRef dst = DnTexelsRef(pc.dst);
    const vec4 g = guide.v[i];
    const vec4 a = accum.v[i];
    const vec4 mo = moments.v[i];
    if (!(g.w > 0.0)) {
        dst.v[i] = vec4(a.xyz, 0.0);
        return;
    }
    const float len = mo.z;
    if ((F.flags & DN_FLAG_SPATIAL_VARIANCE) == 0u || !(len < F.varianceHistory)) {
        precise float v = mo.y - mo.x * mo.x;
        dst.v[i] = vec4(a.xyz, v > 0.0 ? v : 0.0);
        return;
    }
    const vec2 gz = DnPairsRef(F.gradZ).v[i];
    const float lp = dn_luminance(a, F.flags);
    precise float sumW = 0.0;
    precise float sr = 0.0;
    precise float sg = 0.0;
    precise float sb = 0.0;
    precise float s1 = 0.0;
    precise float s2 = 0.0;
    for (int dy = -3; dy <= 3; ++dy) {
        for (int dx = -3; dx <= 3; ++dx) {
            const int qx = int(p.x) + dx;
            const int qy = int(p.y) + dy;
            if (qx < 0 || qy < 0 || qx >= int(w) || qy >= int(F.height)) {
                continue;
            }
            const uint q = uint(qy) * w + uint(qx);
            const vec4 gq = guide.v[q];
            if (!(gq.w > 0.0)) {
                continue;
            }
            const vec4 aq = accum.v[q];
            const vec4 mq = moments.v[q];
            const float wz = dn_depth_term(F, g.w, gq.w, gz, float(dx), float(dy));
            const float wn = dn_normal_weight(g, gq, F.sigmaNormal);
            precise float wl = abs(lp - dn_luminance(aq, F.flags)) / F.sigmaVarianceLum;
            precise float wgt = wn * exp(-(wz + wl));
            sumW = sumW + wgt;
            sr = sr + wgt * aq.x;
            sg = sg + wgt * aq.y;
            sb = sb + wgt * aq.z;
            s1 = s1 + wgt * mq.x;
            s2 = s2 + wgt * mq.y;
        }
    }
    if (!(sumW > 0.0)) {
        precise float v = mo.y - mo.x * mo.x;
        dst.v[i] = vec4(a.xyz, v > 0.0 ? v : 0.0);
        return;
    }
    precise float m1 = s1 / sumW;
    precise float m2 = s2 / sumW;
    precise float v = m2 - m1 * m1;
    precise float boost = F.varianceBoost / (len > 1.0 ? len : 1.0);
    precise vec4 r = vec4(sr / sumW, sg / sumW, sb / sumW, (v > 0.0 ? v : 0.0) * boost);
    dst.v[i] = r;
}
