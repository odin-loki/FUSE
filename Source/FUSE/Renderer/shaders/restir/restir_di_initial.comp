#version 460
// WP-7.2 "restir.di.initial" (twin: restir_di_initial.slang). One pixel per thread: RIS over diCandidates WP-7.1 light-tree samples (target luminance(Le G), source pmf x area density), visibility reuse; writes the reservoir at push.dst.
// CPU reference: rsDiInitial in include/fuse/renderer/restir/restir_kernel.hpp (bit for bit on the same inputs).
#extension GL_GOOGLE_include_directive : require
#include "bindless.glsl"
#include "gpu_scene.glsl"
#include "lt_common.glsl"
#include "restir_common.glsl"

layout(local_size_x = RS_TILE, local_size_y = RS_TILE) in;

void main() {
    const RestirFrame F = rs_frame();
    const uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x >= F.width || p.y >= F.height) {
        return;
    }
    const uint pixel = p.y * F.width + p.x;
    RsDiRef(pc.p.dst).v[pixel] = rs_di_initial(F, p.x, p.y);
}
