#version 460
// WP-7.2 "restir.gi.initial" (twin: restir_gi_initial.slang). One pixel per thread: one cosine-weighted ray query from the visible point, next-event estimation (one light-tree sample + shadow ray) at the hit; writes the reservoir at push.dst and, with push.aux, the hit record.
// CPU reference: rsGiInitial in include/fuse/renderer/restir/restir_kernel.hpp (bit for bit on the same inputs).
#extension GL_GOOGLE_include_directive : require
#include "bindless.glsl"
#include "gpu_scene.glsl"
#include "lt_common.glsl"
#include "restir_common.glsl"

layout(local_size_x = RS_TILE, local_size_y = RS_TILE) in;

void main() {
    const RestirFrame F = rs_frame();
    const uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x >= F.width || p.y >= F.height) {
        return;
    }
    const uint pixel = p.y * F.width + p.x;
    RsGiRef(pc.p.dst).v[pixel] = rs_gi_initial(F, p.x, p.y, pc.p.aux);
}
