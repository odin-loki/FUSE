#version 460
// WP-4.2 "fsr3.convert" (GLSL twin of fsr3_convert.slang): the FUSE temporal inputs -> the textures the vendored
// FSR 3.1 passes read. Per render pixel: linear view depth (f32 buffer, <= 0 = sky) -> reverse-Z device depth of a
// finite [near, far] perspective (fsr3_device_depth in fsr3_types.hpp; sky -> 0), UV motion (f32x2 buffer,
// current - previous) copied unchanged (the host sets fMotionVectorScale = -1); thread (0, 0) writes the exposure
// texture (exposure, 0). `precise`: the CPU twin evaluates the same expression without contraction.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer Fsr3SourceDepth { float values[]; } fsr3SourceDepth;
layout(set = 0, binding = 1, std430) readonly buffer Fsr3SourceMotion { vec2 values[]; } fsr3SourceMotion;
layout(set = 0, binding = 2, r32f) writeonly uniform image2D fsr3OutDepth;
layout(set = 0, binding = 3, rg32f) writeonly uniform image2D fsr3OutMotion;
layout(set = 0, binding = 4, rg32f) writeonly uniform image2D fsr3OutExposure;

layout(push_constant) uniform Fsr3ConvertPush {
    uint renderW;
    uint renderH;
    float nearPlane;
    float farPlane;
    float exposure;
    uint pad0;
    uint pad1;
    uint pad2;
} pc;

void main() {
    const uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x == 0u && p.y == 0u) {
        imageStore(fsr3OutExposure, ivec2(0, 0), vec4(pc.exposure, 0.0, 0.0, 0.0));
    }
    if (p.x >= pc.renderW || p.y >= pc.renderH) {
        return;
    }
    const uint i = p.y * pc.renderW + p.x;
    const float linearDepth = fsr3SourceDepth.values[i];
    precise float z = 0.0;
    if (linearDepth > 0.0) {
        precise float num = pc.nearPlane * (pc.farPlane - linearDepth);
        precise float den = linearDepth * (pc.farPlane - pc.nearPlane);
        z = clamp(num / den, 0.0, 1.0);
    }
    imageStore(fsr3OutDepth, ivec2(p), vec4(z, 0.0, 0.0, 0.0));
    imageStore(fsr3OutMotion, ivec2(p), vec4(fsr3SourceMotion.values[i], 0.0, 0.0));
}
