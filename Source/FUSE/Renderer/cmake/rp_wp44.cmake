file(MAKE_DIRECTORY "${_fuse_wp44_gen}" "${_fuse_wp44_spv}")
set(_fuse_wp44_header "${_fuse_wp44_gen}/fg_spv.h")
add_custom_target(fuse_framegen_kernels)
set(_fuse_wp44_embed_args "")
set(_fuse_wp44_embed_deps "")

if(FUSE_GLSLANG_VALIDATOR)
    # The SDK's FidelityFX-SC glslang invocation (CMakeShaders{Opticalflow,Frameinterpolation}.txt of the Vulkan
    # backend: -Os, FFX_GLSL, FFX_GPU) with the provider's permutation: optical flow without the HDR option (the
    # frame-generation provider creates its OF context with no flags); frame interpolation with render-resolution
    # unjittered motion vectors and inverted (reverse-Z) depth; FP32 (FFX_HALF=0).
    file(GLOB _fuse_wp44_ffx_deps "${_fuse_wp44_ffx_gpu}/*.h" "${_fuse_wp44_ffx_gpu}/opticalflow/*.h"
                                  "${_fuse_wp44_ffx_gpu}/frameinterpolation/*.h" "${_fuse_wp44_ffx_gpu}/spd/*.h")
    set(_fuse_wp44_defines_of -DFFX_GPU=1 -DFFX_GLSL=1 -DFFX_HALF=0 -DFFX_OPTICALFLOW_OPTION_HDR_COLOR_INPUT=0)
    set(_fuse_wp44_defines_fi -DFFX_GPU=1 -DFFX_GLSL=1 -DFFX_HALF=0
        -DFFX_FRAMEINTERPOLATION_OPTION_UPSAMPLE_SAMPLERS_USE_DATA_HALF=0
        -DFFX_FRAMEINTERPOLATION_OPTION_ACCUMULATE_SAMPLERS_USE_DATA_HALF=0
        -DFFX_FRAMEINTERPOLATION_OPTION_REPROJECT_SAMPLERS_USE_DATA_HALF=1
        -DFFX_FRAMEINTERPOLATION_OPTION_POSTPROCESSLOCKSTATUS_SAMPLERS_USE_DATA_HALF=0
        -DFFX_FRAMEINTERPOLATION_OPTION_UPSAMPLE_USE_LANCZOS_TYPE=2
        -DFFX_FRAMEINTERPOLATION_OPTION_LOW_RES_MOTION_VECTORS=1
        -DFFX_FRAMEINTERPOLATION_OPTION_JITTER_MOTION_VECTORS=0
        -DFFX_FRAMEINTERPOLATION_OPTION_INVERTED_DEPTH=1)
    foreach(_row IN LISTS _fuse_wp44_passes)
        string(REPLACE "|" ";" _entry "${_row}")
        list(GET _entry 0 _key)
        list(GET _entry 2 _dir)
        list(GET _entry 3 _file)
        string(TOLOWER "${_key}" _suffix)
        set(_out "${_fuse_wp44_spv}/fg_${_suffix}.spv")
        if(_dir STREQUAL "opticalflow")
            set(_defs ${_fuse_wp44_defines_of})
        else()
            set(_defs ${_fuse_wp44_defines_fi})
        endif()
        set(_cmds COMMAND "${FUSE_GLSLANG_VALIDATOR}" -V -Os --target-env vulkan1.3 -S comp ${_defs}
                          "-I${_fuse_wp44_ffx_gpu}" "-I${_fuse_wp44_ffx_gpu}/${_dir}"
                          "${_fuse_wp44_ffx_vk}/${_dir}/${_file}.glsl" -o "${_out}")
        if(FUSE_SPIRV_VAL)
            list(APPEND _cmds COMMAND "${FUSE_SPIRV_VAL}" --target-env vulkan1.3 "${_out}")
        endif()
        add_custom_command(OUTPUT "${_out}" ${_cmds}
            DEPENDS "${_fuse_wp44_ffx_vk}/${_dir}/${_file}.glsl" ${_fuse_wp44_ffx_deps}
            COMMENT "glslangValidator FidelityFX FSR 3.1 FG ${_file} (vendored)"
            VERBATIM)
        list(APPEND _fuse_wp44_embed_args "-D${_key}=${_out}")
        list(APPEND _fuse_wp44_embed_deps "${_out}")
    endforeach()

    # FUSE-derived portable search (includes the vendored optical-flow headers).
    set(_out "${_fuse_wp44_spv}/fg_of_search_portable.spv")
    set(_cmds COMMAND "${FUSE_GLSLANG_VALIDATOR}" -V -Os --target-env vulkan1.3 -S comp ${_fuse_wp44_defines_of}
                      "-I${_fuse_wp44_ffx_gpu}" "-I${_fuse_wp44_ffx_gpu}/opticalflow"
                      "${_fuse_wp44_shd}/fg_of_search_portable.comp" -o "${_out}")
    if(FUSE_SPIRV_VAL)
        list(APPEND _cmds COMMAND "${FUSE_SPIRV_VAL}" --target-env vulkan1.3 "${_out}")
    endif()
    add_custom_command(OUTPUT "${_out}" ${_cmds}
        DEPENDS "${_fuse_wp44_shd}/fg_of_search_portable.comp" ${_fuse_wp44_ffx_deps}
        COMMENT "glslangValidator fg_of_search_portable.comp (FUSE, derived from the SDK search v5)"
        VERBATIM)
    list(APPEND _fuse_wp44_embed_args "-DSEARCH_PORTABLE=${_out}")
    list(APPEND _fuse_wp44_embed_deps "${_out}")

    foreach(_pair "convert|CONVERT_GLSL" "ui_composite|COMPOSITE_GLSL")
        string(REPLACE "|" ";" _p "${_pair}")
        list(GET _p 0 _stem)
        list(GET _p 1 _key)
        set(_out "${_fuse_wp44_spv}/fg_${_stem}.glsl.spv")
        set(_cmds COMMAND "${FUSE_GLSLANG_VALIDATOR}" --target-env vulkan1.3 "${_fuse_wp44_shd}/fg_${_stem}.comp" -o "${_out}")
        if(FUSE_SPIRV_VAL)
            list(APPEND _cmds COMMAND "${FUSE_SPIRV_VAL}" --target-env vulkan1.3 "${_out}")
        endif()
        add_custom_command(OUTPUT "${_out}" ${_cmds}
            DEPENDS "${_fuse_wp44_shd}/fg_${_stem}.comp"
            COMMENT "glslangValidator fg_${_stem}.comp (GLSL twin)"
            VERBATIM)
        list(APPEND _fuse_wp44_embed_args "-D${_key}=${_out}")
        list(APPEND _fuse_wp44_embed_deps "${_out}")
    endforeach()
endif()
if(COMMAND fuse_add_slang_shaders)
    foreach(_pair "convert|CONVERT_SLANG" "ui_composite|COMPOSITE_SLANG")
        string(REPLACE "|" ";" _p "${_pair}")
        list(GET _p 0 _stem)
        list(GET _p 1 _key)
        fuse_add_slang_shaders(fuse_framegen_kernels
            SOURCES "${_fuse_wp44_shd}/fg_${_stem}.slang"
            STAGE compute
            SUFFIX ".fg"
            FLAGS -fp-mode precise
            OUTPUT_DIR "${_fuse_wp44_spv}"
            OUTPUT_VAR _fuse_wp44_out)
        if(_fuse_wp44_out)
            list(APPEND _fuse_wp44_embed_args "-D${_key}=${_fuse_wp44_out}")
            list(APPEND _fuse_wp44_embed_deps "${_fuse_wp44_out}")
        endif()
    endforeach()
endif()
add_custom_command(OUTPUT "${_fuse_wp44_header}"
    COMMAND "${CMAKE_COMMAND}" "-DOUT=${_fuse_wp44_header}" ${_fuse_wp44_embed_args} -P "${CMAKE_CURRENT_LIST_FILE}"
    DEPENDS ${_fuse_wp44_embed_deps} "${CMAKE_CURRENT_LIST_FILE}"
    COMMENT "Embedding the FSR 3.1 frame-generation passes' SPIR-V"
    VERBATIM)
add_custom_target(fuse_framegen_header DEPENDS "${_fuse_wp44_header}")
add_dependencies(fuse_framegen_header fuse_framegen_kernels)
add_dependencies(fuse_framegen fuse_framegen_header)
target_include_directories(fuse_framegen PRIVATE "${_fuse_wp44_gen}")

