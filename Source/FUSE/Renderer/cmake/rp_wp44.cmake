# WP-4.4 (docs/unification/RENDERER-EXECUTION.md): frame generation plus latency.
# Owned by WP-4.4; other packages must not edit this file.
#
#   fuse_present_latency  STATIC  ILatencyProvider (none; Reflex through the NVIDIA runtime provider's latency
#                                 extension; VK_NV_low_latency2; AMD Anti-Lag 2 = VK_AMD_anti_lag) and the present-timing
#                                 model (include/fuse/renderer/present/latency/**, src/present/latency/**). CPU, stub-safe.
#   fuse_framegen         STATIC  FrameGenGpu: FSR 3.1 frame generation on render graph v2 (optical flow + frame
#                                 interpolation of the vendored AMD FidelityFX SDK v1.1.4, clean-room host, FUSE convert /
#                                 UI composite / portable search passes) (include/fuse/renderer/framegen/**, src/framegen/**)
#   FSR 3.1 FG passes     SPIR-V  the vendored Vulkan GLSL (Engine/lib/fidelityfx, MIT) compiled verbatim with
#                                 glslangValidator -Os (the SDK's FidelityFX-SC glslang flags), embedded in fuse_framegen
#   fuse_rp_latency_*, fuse_rp_framegen_*   ctest   CPU gates (stub-safe) and Lavapipe gates

# Every embedded vendored pass, '|'-separated: KEY | C++ name stem | effect dir | pass file stem
set(_fuse_wp44_passes
    "OF_PREPARE_LUMA|OfPrepareLuma|opticalflow|ffx_opticalflow_prepare_luma_pass"
    "OF_LUMINANCE_PYRAMID|OfLuminancePyramid|opticalflow|ffx_opticalflow_compute_luminance_pyramid_pass"
    "OF_SCD_HISTOGRAM|OfScdHistogram|opticalflow|ffx_opticalflow_generate_scd_histogram_pass"
    "OF_SCD_DIVERGENCE|OfScdDivergence|opticalflow|ffx_opticalflow_compute_scd_divergence_pass"
    "OF_SEARCH|OfSearch|opticalflow|ffx_opticalflow_compute_optical_flow_advanced_pass_v5"
    "OF_FILTER|OfFilter|opticalflow|ffx_opticalflow_filter_optical_flow_pass_v5"
    "OF_SCALE|OfScale|opticalflow|ffx_opticalflow_scale_optical_flow_advanced_pass_v5"
    "FI_RECONSTRUCT_AND_DILATE|FiReconstructAndDilate|frameinterpolation|ffx_frameinterpolation_reconstruct_and_dilate_pass"
    "FI_SETUP|FiSetup|frameinterpolation|ffx_frameinterpolation_setup_pass"
    "FI_RECONSTRUCT_PREV_DEPTH|FiReconstructPrevDepth|frameinterpolation|ffx_frameinterpolation_reconstruct_previous_depth_pass"
    "FI_GAME_MV_FIELD|FiGameMotionVectorField|frameinterpolation|ffx_frameinterpolation_game_motion_vector_field_pass"
    "FI_GAME_VF_PYRAMID|FiGameVectorFieldInpaintingPyramid|frameinterpolation|ffx_frameinterpolation_compute_game_vector_field_inpainting_pyramid_pass"
    "FI_OF_VECTOR_FIELD|FiOpticalFlowVectorField|frameinterpolation|ffx_frameinterpolation_optical_flow_vector_field_pass"
    "FI_DISOCCLUSION|FiDisocclusionMask|frameinterpolation|ffx_frameinterpolation_disocclusion_mask_pass"
    "FI_INTERPOLATION|FiInterpolation|frameinterpolation|ffx_frameinterpolation_pass"
    "FI_INPAINTING_PYRAMID|FiInpaintingPyramid|frameinterpolation|ffx_frameinterpolation_compute_inpainting_pyramid_pass"
    "FI_INPAINTING|FiInpainting|frameinterpolation|ffx_frameinterpolation_inpainting_pass")
# FUSE passes: KEY | C++ name stem
set(_fuse_wp44_fuse_passes
    "CONVERT_SLANG|ConvertSlang"
    "CONVERT_GLSL|ConvertGlsl"
    "COMPOSITE_SLANG|CompositeSlang"
    "COMPOSITE_GLSL|CompositeGlsl"
    "SEARCH_PORTABLE|OfSearchPortable")

# Script mode (build step): embed the SPIR-V into a C++ header.
if(CMAKE_SCRIPT_MODE_FILE)
    cmake_policy(SET CMP0007 NEW)
    set(_text "// Generated by Source/FUSE/Renderer/cmake/rp_wp44.cmake. Do not edit.\n#pragma once\n#include <cstdint>\n")
    set(_complete TRUE)
    foreach(_row IN LISTS _fuse_wp44_passes)
        string(REPLACE "|" ";" _entry "${_row}")
        list(GET _entry 0 _key)
        if(NOT ${_key} OR NOT EXISTS "${${_key}}")
            set(_complete FALSE)
        endif()
    endforeach()
    if(_complete)
        string(APPEND _text "#define FUSE_FG_PASSES 1\n")
        foreach(_row IN LISTS _fuse_wp44_passes)
            string(REPLACE "|" ";" _entry "${_row}")
            list(GET _entry 0 _key)
            list(GET _entry 1 _stem)
            file(READ "${${_key}}" _hex HEX)
            string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1u," _words "${_hex}")
            string(APPEND _text "alignas(4) static const std::uint32_t kFg${_stem}Spv[] = {${_words}};\n")
        endforeach()
    endif()
    foreach(_row IN LISTS _fuse_wp44_fuse_passes)
        string(REPLACE "|" ";" _entry "${_row}")
        list(GET _entry 0 _key)
        list(GET _entry 1 _stem)
        if(${_key} AND EXISTS "${${_key}}")
            string(APPEND _text "#define FUSE_FG_${_key} 1\n")
            file(READ "${${_key}}" _hex HEX)
            string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1u," _words "${_hex}")
            string(APPEND _text "alignas(4) static const std::uint32_t kFg${_stem}Spv[] = {${_words}};\n")
        endif()
    endforeach()
    file(WRITE "${OUT}" "${_text}")
    return()
endif()

get_filename_component(_fuse_wp44_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
