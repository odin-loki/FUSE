# Screen-space radiance cascades (the WP-6.5 follow-up, docs/unification/RENDERER-EXECUTION.md): a 2.5D radiance-
# cascades variant over the depth buffer for near-field diffuse GI + AO (T0), beside DDGI (the far field).
# Owned by the SSRC package; other packages must not edit this file.
#
#   fuse_ssrc_gpu       STATIC  SsrcGpu (ssrc.prepare, ssrc.cascade x n, ssrc.gather on render graph v2), settings /
#                               layout / constant resolution, the CPU reference of every kernel, the brute-force
#                               screen-space ground truth and the metrics (include/fuse/renderer/ssrc/**,
#                               src/ssrc/**)
#   src_* kernels       SPIR-V  Slang (primary) + GLSL twins, embedded in fuse_ssrc_gpu
#   fuse_rp_ssrc_*      ctest   CPU gates (stub-safe) and Lavapipe gates (validation + sync validation)

# Every embedded kernel, '|'-separated: KEY | C++ name stem | GLSL source | Slang source
set(_fuse_ssrc_kernels
    "PREPARE|Prepare|src_prepare.comp|src_prepare.slang"
    "CASCADE|Cascade|src_cascade.comp|src_cascade.slang"
    "GATHER|Gather|src_gather.comp|src_gather.slang")

# Script mode (build step): embed the kernels' SPIR-V into a C++ header.
#   cmake -DOUT=<header> [-D<KEY>_SLANG=<spv> ...] [-D<KEY>_GLSL=<spv> ...] -P rp_ssrc.cmake
if(CMAKE_SCRIPT_MODE_FILE)
    cmake_policy(SET CMP0007 NEW)
    set(_text "// Generated by Source/FUSE/Renderer/cmake/rp_ssrc.cmake from shaders/ssrc/*. Do not edit.\n")
    string(APPEND _text "#pragma once\n#include <cstdint>\n")
    foreach(_lang SLANG GLSL)
        if(_lang STREQUAL "SLANG")
            set(_suffix Slang)
        else()
            set(_suffix Glsl)
        endif()
        set(_complete TRUE)
        foreach(_row IN LISTS _fuse_ssrc_kernels)
            string(REPLACE "|" ";" _entry "${_row}")
            list(GET _entry 0 _key)
            if(NOT ${_key}_${_lang} OR NOT EXISTS "${${_key}_${_lang}}")
                set(_complete FALSE)
            endif()
        endforeach()
        if(_complete)
            string(APPEND _text "#define FUSE_SSRC_GPU_${_lang} 1\n")
            foreach(_row IN LISTS _fuse_ssrc_kernels)
                string(REPLACE "|" ";" _entry "${_row}")
                list(GET _entry 0 _key)
                list(GET _entry 1 _stem)
                file(READ "${${_key}_${_lang}}" _hex HEX)
                string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1u," _words "${_hex}")
                string(APPEND _text "alignas(4) static const std::uint32_t kSrc${_stem}${_suffix}Spv[] = {${_words}};\n")
            endforeach()
        endif()
    endforeach()
    file(WRITE "${OUT}" "${_text}")
    return()
endif()

get_filename_component(_fuse_ssrc_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(_fuse_ssrc_inc "${_fuse_ssrc_root}/include/fuse/renderer/ssrc")
set(_fuse_ssrc_src "${_fuse_ssrc_root}/src/ssrc")
set(_fuse_ssrc_shd "${_fuse_ssrc_root}/shaders/ssrc")
set(_fuse_ssrc_common_inc "${_fuse_ssrc_root}/shaders/common")
set(_fuse_ssrc_ddgi_inc "${_fuse_ssrc_root}/shaders/ddgi")

file(GLOB _fuse_ssrc_shader_files CONFIGURE_DEPENDS "${_fuse_ssrc_shd}/*")
add_library(fuse_ssrc_gpu STATIC
    ${_fuse_ssrc_src}/ssrc_reference.cpp
    ${_fuse_ssrc_src}/ssrc_gpu.cpp
    ${_fuse_ssrc_inc}/ssrc_types.hpp
    ${_fuse_ssrc_inc}/ssrc_reference.hpp
    ${_fuse_ssrc_inc}/ssrc_gpu.hpp
    ${_fuse_ssrc_shader_files}
)
set_source_files_properties(${_fuse_ssrc_shader_files} PROPERTIES HEADER_FILE_ONLY TRUE)
# The screen-space prepare oracle (ssfx_gpu::prepare_pixel), camera_from_projection and the SSGI comparison come
# from WP-6.3's library (read only).
target_link_libraries(fuse_ssrc_gpu PUBLIC fuse_ssfx_gpu fuse_rhi)
fuse_apply_cxx23(fuse_ssrc_gpu)
# The CPU reference and the brute force run ~1e9 depth lookups in the metric gates: optimise them in Debug trees
# too (GCC / Clang; the result is bit-identical, no fast-math).
if(NOT MSVC)
    set_source_files_properties(${_fuse_ssrc_src}/ssrc_reference.cpp PROPERTIES COMPILE_OPTIONS "$<$<CONFIG:Debug>:-O2>")
endif()

# Kernels, embedded into the library. Slang is the primary source (execution doc §8 decision 1a); the GLSL twins
# keep the passes available where slangc is not (FUSE_SLANG=AUTO), and the gates run both.
# Slang: -fp-mode precise; GLSL: `precise` (the reference's operation order, no contraction). The cascade kernel
# includes WP-6.1's DDGI sampler (shaders/ddgi/ddgi_sample.*, read only) for the far-field hook.
set(_fuse_ssrc_gen "${CMAKE_CURRENT_BINARY_DIR}/ssrc_gpu_gen")
set(_fuse_ssrc_spv "${CMAKE_CURRENT_BINARY_DIR}/shaders/ssrc")
file(MAKE_DIRECTORY "${_fuse_ssrc_gen}" "${_fuse_ssrc_spv}")
set(_fuse_ssrc_header "${_fuse_ssrc_gen}/ssrc_gpu_spv.h")
add_custom_target(fuse_ssrc_gpu_kernels)
set(_fuse_ssrc_embed_args "")
set(_fuse_ssrc_embed_deps "")
file(GLOB _fuse_ssrc_glsl_includes "${_fuse_ssrc_shd}/*.glsl")

foreach(_row IN LISTS _fuse_ssrc_kernels)
    string(REPLACE "|" ";" _entry "${_row}")
    list(GET _entry 0 _key)
    list(GET _entry 2 _glsl)
    list(GET _entry 3 _slang)
    string(TOLOWER "${_key}" _suffix)
    if(COMMAND fuse_add_slang_shaders)
        fuse_add_slang_shaders(fuse_ssrc_gpu_kernels
            SOURCES "${_fuse_ssrc_shd}/${_slang}"
            STAGE compute
            SUFFIX ".src_${_suffix}"
            INCLUDE_DIRS "${_fuse_ssrc_shd}" "${_fuse_ssrc_ddgi_inc}"
            FLAGS -fp-mode precise
            OUTPUT_DIR "${_fuse_ssrc_spv}"
            OUTPUT_VAR _fuse_ssrc_out)
        if(_fuse_ssrc_out)
            list(APPEND _fuse_ssrc_embed_args "-D${_key}_SLANG=${_fuse_ssrc_out}")
            list(APPEND _fuse_ssrc_embed_deps "${_fuse_ssrc_out}")
        endif()
    endif()
    if(FUSE_GLSLANG_VALIDATOR)
        set(_out "${_fuse_ssrc_spv}/src_${_suffix}.glsl.spv")
        set(_cmds COMMAND "${FUSE_GLSLANG_VALIDATOR}" --target-env vulkan1.3 "-I${_fuse_ssrc_common_inc}"
                          "-I${_fuse_ssrc_shd}" "-I${_fuse_ssrc_ddgi_inc}" "${_fuse_ssrc_shd}/${_glsl}" -o "${_out}")
        if(FUSE_SPIRV_VAL)
            list(APPEND _cmds COMMAND "${FUSE_SPIRV_VAL}" --target-env vulkan1.3 "${_out}")
        endif()
        add_custom_command(OUTPUT "${_out}" ${_cmds}
            DEPENDS "${_fuse_ssrc_shd}/${_glsl}" ${_fuse_ssrc_glsl_includes} "${_fuse_ssrc_common_inc}/bindless.glsl"
                    "${_fuse_ssrc_ddgi_inc}/ddgi_sample.glsl"
            COMMENT "glslangValidator ${_glsl} (src_${_suffix}, GLSL twin)"
            VERBATIM)
        list(APPEND _fuse_ssrc_embed_args "-D${_key}_GLSL=${_out}")
        list(APPEND _fuse_ssrc_embed_deps "${_out}")
    endif()
endforeach()
add_custom_command(OUTPUT "${_fuse_ssrc_header}"
    COMMAND "${CMAKE_COMMAND}" "-DOUT=${_fuse_ssrc_header}" ${_fuse_ssrc_embed_args} -P "${CMAKE_CURRENT_LIST_FILE}"
    DEPENDS ${_fuse_ssrc_embed_deps} "${CMAKE_CURRENT_LIST_FILE}"
    COMMENT "Embedding the screen-space radiance-cascades kernels' SPIR-V"
    VERBATIM)
add_custom_target(fuse_ssrc_gpu_header DEPENDS "${_fuse_ssrc_header}")
add_dependencies(fuse_ssrc_gpu_header fuse_ssrc_gpu_kernels)
add_dependencies(fuse_ssrc_gpu fuse_ssrc_gpu_header)
target_include_directories(fuse_ssrc_gpu PRIVATE "${_fuse_ssrc_gen}")

if(NOT FUSE_BUILD_CORE_TESTS)
    return()
endif()

set(_fuse_ssrc_tests_dir "${_fuse_ssrc_root}/tests")

# --- CPU gates (layout, f16, furnace, error vs brute force, leak, SSGI comparison, api; also in the stub tree) ---
add_executable(fuse_rp_ssrc_cpu ${_fuse_ssrc_tests_dir}/test_rp_ssrc_cpu.cpp)
target_link_libraries(fuse_rp_ssrc_cpu PRIVATE fuse_ssrc_gpu)
target_compile_definitions(fuse_rp_ssrc_cpu PRIVATE FUSE_RP_SSRC_SHADER_DIR="${_fuse_ssrc_shd}")
fuse_apply_cxx23(fuse_rp_ssrc_cpu)
if(NOT MSVC)
    # The brute-force / world references in the test itself.
    target_compile_options(fuse_rp_ssrc_cpu PRIVATE "$<$<CONFIG:Debug>:-O2>")
endif()
foreach(_suite layout f16 furnace error leak ssgi api)
    add_test(NAME fuse_rp_ssrc_${_suite} COMMAND fuse_rp_ssrc_cpu ${_suite})
    set_tests_properties(fuse_rp_ssrc_${_suite} PROPERTIES LABELS "gate;renderer;ssrc" TIMEOUT 900)
endforeach()

# --- Lavapipe gates ------------------------------------------------------------------------------
add_executable(fuse_rp_ssrc_gpu ${_fuse_ssrc_tests_dir}/test_rp_ssrc_gpu.cpp)
target_link_libraries(fuse_rp_ssrc_gpu PRIVATE fuse_ssrc_gpu)
fuse_apply_cxx23(fuse_rp_ssrc_gpu)

# tests/CMakeLists.txt writes the ICD lock wrapper; its variable is scoped to that directory.
set(_fuse_ssrc_lock "${CMAKE_CURRENT_BINARY_DIR}/tests/run_vulkan_icd_locked.sh")
set(_fuse_ssrc_vk_tests "")
foreach(_case "parity;set" "parity;buffer" "zero_alloc;set")
    list(GET _case 0 _mode)
    list(GET _case 1 _backend)
    set(_name "fuse_rp_ssrc_gpu_vk_${_mode}_${_backend}")
    if(FUSE_VULKAN_BACKEND)
        add_test(NAME ${_name}
                 COMMAND "${_fuse_ssrc_lock}" "$<TARGET_FILE:fuse_rp_ssrc_gpu>" --mode ${_mode} --backend ${_backend})
    else()
        add_test(NAME ${_name} COMMAND fuse_rp_ssrc_gpu --mode ${_mode} --backend ${_backend})
    endif()
    list(APPEND _fuse_ssrc_vk_tests ${_name})
endforeach()
set_tests_properties(${_fuse_ssrc_vk_tests} PROPERTIES
    ENVIRONMENT "VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/lvp_icd.json"
    RUN_SERIAL TRUE
    SKIP_RETURN_CODE 77
    TIMEOUT 900
    LABELS "gate;vulkan;renderer;ssrc")
