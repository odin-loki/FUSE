# ASan + UBSan build of the property tests (WP-0.8 probe result; skipped under the fuse-asan preset,
# where every target is instrumented anyway).
if(FUSE_CORE_LOGIC_SAN_OK AND "${FUSE_SANITIZE}" STREQUAL "")
    set(_san -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer)
    add_executable(fuse_core_logic_vsm_pages_tests_san ${_fuse_wp31_cl_test_src})
    target_include_directories(fuse_core_logic_vsm_pages_tests_san PRIVATE "${_fuse_wp31_cl_vsm}/include" "${_fuse_wp31_cl}/include")
    target_compile_features(fuse_core_logic_vsm_pages_tests_san PRIVATE cxx_std_17)
    target_compile_options(fuse_core_logic_vsm_pages_tests_san PRIVATE ${_san} -O1 -g)
    target_link_options(fuse_core_logic_vsm_pages_tests_san PRIVATE ${_san})
    add_test(NAME fuse_core_logic_vsm_pages_sanitize COMMAND fuse_core_logic_vsm_pages_tests_san all)
    set_tests_properties(fuse_core_logic_vsm_pages_sanitize PROPERTIES LABELS "gate;core_logic;prism;sanitize;vsm"
        TIMEOUT 600 ENVIRONMENT "ASAN_OPTIONS=detect_leaks=1:abort_on_error=1;UBSAN_OPTIONS=print_stacktrace=1")
endif()

