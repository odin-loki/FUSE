# CBMC (registered with the WP-0.8 switch: DISABLED unless -DFUSE_CORE_LOGIC_CBMC=ON).
if(FUSE_CBMC_EXECUTABLE)
    add_test(NAME fuse_core_logic_cbmc_vsm_pages
        COMMAND ${FUSE_CBMC_EXECUTABLE} --cpp11 -I${_fuse_wp31_cl_vsm}/include -I${_fuse_wp31_cl}/include -I${_fuse_wp31_cl}/bmc
                --unwinding-assertions --bounds-check --pointer-check --div-by-zero-check --signed-overflow-check
                --undefined-shift-check -DBMC_STEPS=2 --unwind 20 ${_fuse_wp31_cl_vsm}/bmc/bmc_vsm_pages.cpp)
    set_tests_properties(fuse_core_logic_cbmc_vsm_pages PROPERTIES LABELS "core_logic;prism;bmc;slow;vsm" TIMEOUT 3600)
