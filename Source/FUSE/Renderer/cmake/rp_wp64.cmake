# WP-6.4 (docs/unification/RENDERER-EXECUTION.md): in-tree denoiser (SVGF / A-SVGF, Schied et al. 2017 / 2018).
# Owned by WP-6.4; other packages must not edit this file.
#
#   fuse_denoise        STATIC  SvgfDenoiser (denoise.guide, denoise.gradient.*, denoise.temporal, denoise.variance,
#                               denoise.atrous on render graph v2), the single-source CPU reference (svgf_kernel.hpp,
#                               SvgfReference) and the synthetic noisy-sequence generator
#                               (include/fuse/renderer/denoise/**, src/denoise/**)
#   dn_* kernels        SPIR-V  Slang (primary) + GLSL twins, embedded in fuse_denoise
#   fuse_rp_denoise_*   ctest   CPU gates (stub-safe) and Lavapipe gates (validation + sync validation)

# Every embedded kernel, '|'-separated: KEY | C++ name stem | GLSL source | Slang source
set(_fuse_wp64_kernels
    "GUIDE|Guide|dn_guide.comp|dn_guide.slang"
    "GRADIENT|Gradient|dn_gradient.comp|dn_gradient.slang"
    "TEMPORAL|Temporal|dn_temporal.comp|dn_temporal.slang"
    "VARIANCE|Variance|dn_variance.comp|dn_variance.slang"
    "ATROUS|Atrous|dn_atrous.comp|dn_atrous.slang")

# Script mode (build step): embed the kernels' SPIR-V into a C++ header.
#   cmake -DOUT=<header> [-D<KEY>_SLANG=<spv> ...] [-D<KEY>_GLSL=<spv> ...] -P rp_wp64.cmake
if(CMAKE_SCRIPT_MODE_FILE)
    cmake_policy(SET CMP0007 NEW)
    set(_text "// Generated by Source/FUSE/Renderer/cmake/rp_wp64.cmake from shaders/denoise/*. Do not edit.\n")
    string(APPEND _text "#pragma once\n#include <cstdint>\n")
    foreach(_lang SLANG GLSL)
        if(_lang STREQUAL "SLANG")
            set(_suffix Slang)
        else()
            set(_suffix Glsl)
        endif()
        set(_complete TRUE)
        foreach(_row IN LISTS _fuse_wp64_kernels)
            string(REPLACE "|" ";" _entry "${_row}")
            list(GET _entry 0 _key)
            if(NOT ${_key}_${_lang} OR NOT EXISTS "${${_key}_${_lang}}")
                set(_complete FALSE)
            endif()
        endforeach()
        if(_complete)
            string(APPEND _text "#define FUSE_DENOISE_${_lang} 1\n")
            foreach(_row IN LISTS _fuse_wp64_kernels)
                string(REPLACE "|" ";" _entry "${_row}")
                list(GET _entry 0 _key)
                list(GET _entry 1 _stem)
                file(READ "${${_key}_${_lang}}" _hex HEX)
                string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1u," _words "${_hex}")
                string(APPEND _text "alignas(4) static const std::uint32_t kDn${_stem}${_suffix}Spv[] = {${_words}};\n")
            endforeach()
        endif()
    endforeach()
    file(WRITE "${OUT}" "${_text}")
    return()
endif()

get_filename_component(_fuse_wp64_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(_fuse_wp64_inc "${_fuse_wp64_root}/include/fuse/renderer/denoise")
set(_fuse_wp64_src "${_fuse_wp64_root}/src/denoise")
set(_fuse_wp64_shd "${_fuse_wp64_root}/shaders/denoise")
set(_fuse_wp64_common_inc "${_fuse_wp64_root}/shaders/common")

file(GLOB _fuse_wp64_shader_files CONFIGURE_DEPENDS "${_fuse_wp64_shd}/*")
add_library(fuse_denoise STATIC
    ${_fuse_wp64_src}/svgf_denoiser.cpp
    ${_fuse_wp64_src}/svgf_reference.cpp
    ${_fuse_wp64_src}/svgf_synthetic.cpp
    ${_fuse_wp64_inc}/denoise_types.hpp
    ${_fuse_wp64_inc}/svgf_kernel.hpp
    ${_fuse_wp64_inc}/svgf_reference.hpp
    ${_fuse_wp64_inc}/svgf_synthetic.hpp
    ${_fuse_wp64_inc}/svgf_denoiser.hpp
    ${_fuse_wp64_shader_files}
)
set_source_files_properties(${_fuse_wp64_shader_files} PROPERTIES HEADER_FILE_ONLY TRUE)
target_link_libraries(fuse_denoise PUBLIC fuse_rhi)
fuse_apply_cxx23(fuse_denoise)

# Kernels, embedded into the library. Slang is the primary source (execution doc §8 decision 1a); the
# GLSL twins keep the denoiser available where slangc is not (FUSE_SLANG=AUTO), and the gates run both.
# Slang: -fp-mode precise; GLSL: `precise` (the oracle's operation order, no contraction).
set(_fuse_wp64_gen "${CMAKE_CURRENT_BINARY_DIR}/denoise_gen")
set(_fuse_wp64_spv "${CMAKE_CURRENT_BINARY_DIR}/shaders/denoise")
file(MAKE_DIRECTORY "${_fuse_wp64_gen}" "${_fuse_wp64_spv}")
set(_fuse_wp64_header "${_fuse_wp64_gen}/denoise_spv.h")
add_custom_target(fuse_denoise_kernels)
set(_fuse_wp64_embed_args "")
set(_fuse_wp64_embed_deps "")
file(GLOB _fuse_wp64_glsl_includes "${_fuse_wp64_shd}/*.glsl")

foreach(_row IN LISTS _fuse_wp64_kernels)
    string(REPLACE "|" ";" _entry "${_row}")
    list(GET _entry 0 _key)
    list(GET _entry 2 _glsl)
    list(GET _entry 3 _slang)
    string(TOLOWER "${_key}" _suffix)
    if(COMMAND fuse_add_slang_shaders)
        fuse_add_slang_shaders(fuse_denoise_kernels
            SOURCES "${_fuse_wp64_shd}/${_slang}"
            STAGE compute
            SUFFIX ".dn_${_suffix}"
            INCLUDE_DIRS "${_fuse_wp64_shd}"
            # 39001: the bindless arrays alias one binding on purpose.
            FLAGS -warnings-disable 39001 -fp-mode precise
            OUTPUT_DIR "${_fuse_wp64_spv}"
            OUTPUT_VAR _fuse_wp64_out)
        if(_fuse_wp64_out)
            list(APPEND _fuse_wp64_embed_args "-D${_key}_SLANG=${_fuse_wp64_out}")
            list(APPEND _fuse_wp64_embed_deps "${_fuse_wp64_out}")
        endif()
    endif()
    if(FUSE_GLSLANG_VALIDATOR)
        set(_out "${_fuse_wp64_spv}/dn_${_suffix}.glsl.spv")
        set(_cmds COMMAND "${FUSE_GLSLANG_VALIDATOR}" --target-env vulkan1.3 "-I${_fuse_wp64_common_inc}"
                          "-I${_fuse_wp64_shd}" "${_fuse_wp64_shd}/${_glsl}" -o "${_out}")
        if(FUSE_SPIRV_VAL)
            list(APPEND _cmds COMMAND "${FUSE_SPIRV_VAL}" --target-env vulkan1.3 "${_out}")
        endif()
        add_custom_command(OUTPUT "${_out}" ${_cmds}
            DEPENDS "${_fuse_wp64_shd}/${_glsl}" ${_fuse_wp64_glsl_includes} "${_fuse_wp64_common_inc}/bindless.glsl"
            COMMENT "glslangValidator ${_glsl} (dn_${_suffix}, GLSL twin)"
            VERBATIM)
        list(APPEND _fuse_wp64_embed_args "-D${_key}_GLSL=${_out}")
        list(APPEND _fuse_wp64_embed_deps "${_out}")
    endif()
endforeach()
add_custom_command(OUTPUT "${_fuse_wp64_header}"
    COMMAND "${CMAKE_COMMAND}" "-DOUT=${_fuse_wp64_header}" ${_fuse_wp64_embed_args} -P "${CMAKE_CURRENT_LIST_FILE}"
    DEPENDS ${_fuse_wp64_embed_deps} "${CMAKE_CURRENT_LIST_FILE}"
    COMMENT "Embedding the denoiser kernels' SPIR-V"
    VERBATIM)
add_custom_target(fuse_denoise_header DEPENDS "${_fuse_wp64_header}")
add_dependencies(fuse_denoise_header fuse_denoise_kernels)
add_dependencies(fuse_denoise fuse_denoise_header)
target_include_directories(fuse_denoise PRIVATE "${_fuse_wp64_gen}")

if(NOT FUSE_BUILD_CORE_TESTS)
    return()
endif()

set(_fuse_wp64_tests_dir "${_fuse_wp64_root}/tests")

# --- CPU gates (layouts, CPU backend parity, reference quality / disocclusion / A-SVGF; also in the stub tree) --
add_executable(fuse_rp_denoise_cpu ${_fuse_wp64_tests_dir}/test_rp_denoise_cpu.cpp)
target_link_libraries(fuse_rp_denoise_cpu PRIVATE fuse_denoise)
target_compile_definitions(fuse_rp_denoise_cpu PRIVATE FUSE_RP_DENOISE_SHADER_DIR="${_fuse_wp64_shd}")
fuse_apply_cxx23(fuse_rp_denoise_cpu)
foreach(_suite layout backends estimator disocclusion quality asvgf api)
    add_test(NAME fuse_rp_denoise_${_suite} COMMAND fuse_rp_denoise_cpu ${_suite})
    set_tests_properties(fuse_rp_denoise_${_suite} PROPERTIES LABELS "gate;renderer;denoise" TIMEOUT 900)
endforeach()

# --- Lavapipe gates ------------------------------------------------------------------------------
add_executable(fuse_rp_denoise ${_fuse_wp64_tests_dir}/test_rp_denoise.cpp)
target_link_libraries(fuse_rp_denoise PRIVATE fuse_denoise)
fuse_apply_cxx23(fuse_rp_denoise)

# tests/CMakeLists.txt writes the ICD lock wrapper; its variable is scoped to that directory.
set(_fuse_wp64_lock "${CMAKE_CURRENT_BINARY_DIR}/tests/run_vulkan_icd_locked.sh")
set(_fuse_wp64_vk_tests "")
foreach(_case "passes;set" "passes;buffer" "quality;set" "zero_alloc;set")
    list(GET _case 0 _mode)
    list(GET _case 1 _backend)
    set(_name "fuse_rp_denoise_vk_${_mode}_${_backend}")
    if(FUSE_VULKAN_BACKEND)
        add_test(NAME ${_name}
                 COMMAND "${_fuse_wp64_lock}" "$<TARGET_FILE:fuse_rp_denoise>" --mode ${_mode} --backend ${_backend})
    else()
        add_test(NAME ${_name} COMMAND fuse_rp_denoise --mode ${_mode} --backend ${_backend})
    endif()
    list(APPEND _fuse_wp64_vk_tests ${_name})
endforeach()
set_tests_properties(${_fuse_wp64_vk_tests} PROPERTIES
    ENVIRONMENT "VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/lvp_icd.json"
    RUN_SERIAL TRUE
    SKIP_RETURN_CODE 77
    TIMEOUT 900
    LABELS "gate;vulkan;renderer;denoise")
