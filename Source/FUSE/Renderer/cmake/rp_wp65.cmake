# WP-6.5 (docs/unification/RENDERER-EXECUTION.md): radiance cascades, research track (renderer plan 6d).
# Owned by WP-6.5; other packages must not edit this file.
#
#   fuse_rc_research    STATIC  flatland radiance cascades: CPU reference + brute-force ground truth + metrics
#                               (rc_reference) and the Vulkan compute prototype RadianceCascadesGpu on render
#                               graph v2 (research/radiance_cascades/{include,src}/**)
#   rc_* kernels        SPIR-V  Slang (primary) + GLSL twins, embedded in fuse_rc_research
#   fuse_rp_rc_*        ctest   CPU metric gates (stub-safe) and Lavapipe gates (validation + sync validation)
#   report.md                   research/radiance_cascades/report.md: measured metrics and the recommendation

# Every embedded kernel, '|'-separated: KEY | C++ name stem | GLSL source | Slang source
set(_fuse_wp65_kernels
    "CASCADE|Cascade|rc_cascade.comp|rc_cascade.slang"
    "GATHER|Gather|rc_gather.comp|rc_gather.slang")

# Script mode (build step): embed the kernels' SPIR-V into a C++ header.
#   cmake -DOUT=<header> [-D<KEY>_SLANG=<spv> ...] [-D<KEY>_GLSL=<spv> ...] -P rp_wp65.cmake
if(CMAKE_SCRIPT_MODE_FILE)
    cmake_policy(SET CMP0007 NEW)
    set(_text "// Generated by Source/FUSE/Renderer/cmake/rp_wp65.cmake from research/radiance_cascades/shaders/*. Do not edit.\n")
    string(APPEND _text "#pragma once\n#include <cstdint>\n")
    foreach(_lang SLANG GLSL)
        if(_lang STREQUAL "SLANG")
            set(_suffix Slang)
        else()
            set(_suffix Glsl)
        endif()
        set(_complete TRUE)
        foreach(_row IN LISTS _fuse_wp65_kernels)
            string(REPLACE "|" ";" _entry "${_row}")
            list(GET _entry 0 _key)
            if(NOT ${_key}_${_lang} OR NOT EXISTS "${${_key}_${_lang}}")
                set(_complete FALSE)
            endif()
        endforeach()
        if(_complete)
            string(APPEND _text "#define FUSE_RC_GPU_${_lang} 1\n")
            foreach(_row IN LISTS _fuse_wp65_kernels)
                string(REPLACE "|" ";" _entry "${_row}")
                list(GET _entry 0 _key)
                list(GET _entry 1 _stem)
                file(READ "${${_key}_${_lang}}" _hex HEX)
                string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1u," _words "${_hex}")
                string(APPEND _text "alignas(4) static const std::uint32_t kRc${_stem}${_suffix}Spv[] = {${_words}};\n")
            endforeach()
        endif()
    endforeach()
    file(WRITE "${OUT}" "${_text}")
    return()
endif()

get_filename_component(_fuse_wp65_root "${CMAKE_CURRENT_LIST_DIR}/../research/radiance_cascades" ABSOLUTE)
set(_fuse_wp65_inc "${_fuse_wp65_root}/include/fuse/renderer/research/rc")
set(_fuse_wp65_src "${_fuse_wp65_root}/src")
set(_fuse_wp65_shd "${_fuse_wp65_root}/shaders")

file(GLOB _fuse_wp65_shader_files CONFIGURE_DEPENDS "${_fuse_wp65_shd}/*")
add_library(fuse_rc_research STATIC
    ${_fuse_wp65_src}/rc_reference.cpp
    ${_fuse_wp65_src}/rc_gpu.cpp
    ${_fuse_wp65_inc}/rc_types.hpp
    ${_fuse_wp65_inc}/rc_reference.hpp
    ${_fuse_wp65_inc}/rc_gpu.hpp
    ${_fuse_wp65_root}/report.md
    ${_fuse_wp65_shader_files}
)
set_source_files_properties(${_fuse_wp65_shader_files} ${_fuse_wp65_root}/report.md PROPERTIES HEADER_FILE_ONLY TRUE)
target_include_directories(fuse_rc_research PUBLIC "${_fuse_wp65_root}/include")
target_link_libraries(fuse_rc_research PUBLIC fuse_rhi)
fuse_apply_cxx23(fuse_rc_research)
# The CPU reference and the brute-force ground truth run ~1e9 texel lookups in the metric gates: optimise
# them in Debug trees too (GCC / Clang; the result is bit-identical, no fast-math).
if(NOT MSVC)
    set_source_files_properties(${_fuse_wp65_src}/rc_reference.cpp PROPERTIES COMPILE_OPTIONS "$<$<CONFIG:Debug>:-O2>")
endif()

# Kernels, embedded into the library. Slang is the primary source (execution doc §8 decision 1a); the GLSL
# twins keep the prototype available where slangc is not (FUSE_SLANG=AUTO), and the gates run both.
# Slang: -fp-mode precise; GLSL: `precise` (the reference's operation order, no contraction).
set(_fuse_wp65_gen "${CMAKE_CURRENT_BINARY_DIR}/rc_research_gen")
set(_fuse_wp65_spv "${CMAKE_CURRENT_BINARY_DIR}/shaders/rc_research")
file(MAKE_DIRECTORY "${_fuse_wp65_gen}" "${_fuse_wp65_spv}")
set(_fuse_wp65_header "${_fuse_wp65_gen}/rc_gpu_spv.h")
add_custom_target(fuse_rc_research_kernels)
set(_fuse_wp65_embed_args "")
set(_fuse_wp65_embed_deps "")
foreach(_row IN LISTS _fuse_wp65_kernels)
    string(REPLACE "|" ";" _entry "${_row}")
    list(GET _entry 0 _key)
    list(GET _entry 2 _glsl)
    list(GET _entry 3 _slang)
    string(TOLOWER "${_key}" _suffix)
    if(COMMAND fuse_add_slang_shaders)
        fuse_add_slang_shaders(fuse_rc_research_kernels
            SOURCES "${_fuse_wp65_shd}/${_slang}"
            STAGE compute
            SUFFIX ".rc_${_suffix}"
            INCLUDE_DIRS "${_fuse_wp65_shd}"
            FLAGS -fp-mode precise
            OUTPUT_DIR "${_fuse_wp65_spv}"
            OUTPUT_VAR _fuse_wp65_out)
        if(_fuse_wp65_out)
            list(APPEND _fuse_wp65_embed_args "-D${_key}_SLANG=${_fuse_wp65_out}")
            list(APPEND _fuse_wp65_embed_deps "${_fuse_wp65_out}")
        endif()
    endif()
    if(FUSE_GLSLANG_VALIDATOR)
        set(_out "${_fuse_wp65_spv}/rc_${_suffix}.glsl.spv")
        set(_cmds COMMAND "${FUSE_GLSLANG_VALIDATOR}" --target-env vulkan1.3 "-I${_fuse_wp65_shd}"
                          "${_fuse_wp65_shd}/${_glsl}" -o "${_out}")
        if(FUSE_SPIRV_VAL)
            list(APPEND _cmds COMMAND "${FUSE_SPIRV_VAL}" --target-env vulkan1.3 "${_out}")
        endif()
        add_custom_command(OUTPUT "${_out}" ${_cmds}
            DEPENDS "${_fuse_wp65_shd}/${_glsl}" "${_fuse_wp65_shd}/rc_common.glsl"
            COMMENT "glslangValidator ${_glsl} (rc_${_suffix}, GLSL twin)"
            VERBATIM)
        list(APPEND _fuse_wp65_embed_args "-D${_key}_GLSL=${_out}")
        list(APPEND _fuse_wp65_embed_deps "${_out}")
    endif()
endforeach()
add_custom_command(OUTPUT "${_fuse_wp65_header}"
    COMMAND "${CMAKE_COMMAND}" "-DOUT=${_fuse_wp65_header}" ${_fuse_wp65_embed_args} -P "${CMAKE_CURRENT_LIST_FILE}"
    DEPENDS ${_fuse_wp65_embed_deps} "${CMAKE_CURRENT_LIST_FILE}"
    COMMENT "Embedding the radiance-cascades kernels' SPIR-V"
    VERBATIM)
add_custom_target(fuse_rc_research_header DEPENDS "${_fuse_wp65_header}")
add_dependencies(fuse_rc_research_header fuse_rc_research_kernels)
add_dependencies(fuse_rc_research fuse_rc_research_header)
target_include_directories(fuse_rc_research PRIVATE "${_fuse_wp65_gen}")

if(NOT FUSE_BUILD_CORE_TESTS)
    return()
endif()

set(_fuse_wp65_tests_dir "${_fuse_wp65_root}/tests")

# --- CPU gates (layout, energy, error vs brute force, leak, ringing, cost; also in the stub tree) ---------
add_executable(fuse_rp_rc_cpu ${_fuse_wp65_tests_dir}/test_rp_rc_cpu.cpp)
target_link_libraries(fuse_rp_rc_cpu PRIVATE fuse_rc_research)
target_compile_definitions(fuse_rp_rc_cpu PRIVATE FUSE_RP_RC_SHADER_DIR="${_fuse_wp65_shd}")
fuse_apply_cxx23(fuse_rp_rc_cpu)
foreach(_suite layout energy error leak ringing cost)
    add_test(NAME fuse_rp_rc_${_suite} COMMAND fuse_rp_rc_cpu ${_suite})
    set_tests_properties(fuse_rp_rc_${_suite} PROPERTIES LABELS "gate;renderer;rc;research" TIMEOUT 900)
endforeach()

# --- Lavapipe gates ------------------------------------------------------------------------------
add_executable(fuse_rp_rc_gpu ${_fuse_wp65_tests_dir}/test_rp_rc_gpu.cpp)
target_link_libraries(fuse_rp_rc_gpu PRIVATE fuse_rc_research)
fuse_apply_cxx23(fuse_rp_rc_gpu)

# tests/CMakeLists.txt writes the ICD lock wrapper; its variable is scoped to that directory.
set(_fuse_wp65_lock "${CMAKE_CURRENT_BINARY_DIR}/tests/run_vulkan_icd_locked.sh")
set(_fuse_wp65_vk_tests "")
foreach(_case "parity;none" "parity;set" "parity;buffer" "zero_alloc;set")
    list(GET _case 0 _mode)
    list(GET _case 1 _backend)
    set(_name "fuse_rp_rc_gpu_vk_${_mode}_${_backend}")
    if(FUSE_VULKAN_BACKEND)
        add_test(NAME ${_name}
                 COMMAND "${_fuse_wp65_lock}" "$<TARGET_FILE:fuse_rp_rc_gpu>" --mode ${_mode} --backend ${_backend})
    else()
        add_test(NAME ${_name} COMMAND fuse_rp_rc_gpu --mode ${_mode} --backend ${_backend})
    endif()
    list(APPEND _fuse_wp65_vk_tests ${_name})
endforeach()
set_tests_properties(${_fuse_wp65_vk_tests} PROPERTIES
    ENVIRONMENT "VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/lvp_icd.json"
    RUN_SERIAL TRUE
    SKIP_RETURN_CODE 77
    TIMEOUT 900
    LABELS "gate;vulkan;renderer;rc;research")
