# WP-6.2 (docs/unification/RENDERER-EXECUTION.md): ray-traced shadows and reflections (tier T2).
# Owned by WP-6.2; other packages must not edit this file.
#
#   fuse_rt_effects            STATIC  rt.shadows / rt.reflections ray-query passes over the WP-1.5 G-buffer
#                                      and the WP-6.0 TLAS, the RtfxShadowView the lighting reads
#                                      (include/fuse/renderer/rt_effects/**, src/rt_effects/rt_effects.cpp)
#   fuse_rt_effects_reference  STATIC  offline CPU path tracer over rt::RtReferenceScene (the converged
#                                      reference of the gates)
#   rt_effects kernels         SPIR-V  Slang (primary) + GLSL twins (shaders/rt_effects/**), embedded
#   fuse_rp_rt_effects_*       ctest   CPU gates (stub-safe) and Lavapipe gates (validation + sync validation)

# Every embedded kernel, '|'-separated: KEY | C++ name stem | GLSL source | Slang source (relative to
# shaders/rt_effects/).
set(_fuse_wp62_kernels
    "SHADOWS|Shadows|rtfx_shadows.comp|rtfx_shadows.slang"
    "REFLECTIONS|Reflections|rtfx_reflections.comp|rtfx_reflections.slang")

# Script mode (build step): embed the kernels' SPIR-V into a C++ header.
#   cmake -DOUT=<header> [-D<KEY>_SLANG=<spv> ...] [-D<KEY>_GLSL=<spv> ...] -P rp_wp62.cmake
if(CMAKE_SCRIPT_MODE_FILE)
    cmake_policy(SET CMP0007 NEW)
    set(_text "// Generated by Source/FUSE/Renderer/cmake/rp_wp62.cmake from shaders/rt_effects/*. Do not edit.\n")
    string(APPEND _text "#pragma once\n#include <cstdint>\n")
    foreach(_lang SLANG GLSL)
        if(_lang STREQUAL "SLANG")
            set(_suffix Slang)
        else()
            set(_suffix Glsl)
        endif()
        set(_complete TRUE)
        foreach(_row IN LISTS _fuse_wp62_kernels)
            string(REPLACE "|" ";" _entry "${_row}")
            list(GET _entry 0 _key)
            if(NOT ${_key}_${_lang} OR NOT EXISTS "${${_key}_${_lang}}")
                set(_complete FALSE)
            endif()
        endforeach()
        if(_complete)
            string(APPEND _text "#define FUSE_RT_EFFECTS_${_lang} 1\n")
            foreach(_row IN LISTS _fuse_wp62_kernels)
                string(REPLACE "|" ";" _entry "${_row}")
                list(GET _entry 0 _key)
                list(GET _entry 1 _stem)
                file(READ "${${_key}_${_lang}}" _hex HEX)
                string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1u," _words "${_hex}")
                string(APPEND _text "alignas(4) static const std::uint32_t kRtfx${_stem}${_suffix}Spv[] = {${_words}};\n")
            endforeach()
        endif()
    endforeach()
    file(WRITE "${OUT}" "${_text}")
    return()
endif()

get_filename_component(_fuse_wp62_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(_fuse_wp62_inc "${_fuse_wp62_root}/include/fuse/renderer/rt_effects")
set(_fuse_wp62_src "${_fuse_wp62_root}/src/rt_effects")
set(_fuse_wp62_shd "${_fuse_wp62_root}/shaders/rt_effects")
set(_fuse_wp62_scene_inc "${_fuse_wp62_root}/include/fuse/renderer/gpu_scene")
set(_fuse_wp62_common_inc "${_fuse_wp62_root}/shaders/common")
set(_fuse_wp62_tests_dir "${_fuse_wp62_root}/tests")

set(_fuse_wp62_warn "")
if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang|AppleClang")
    set(_fuse_wp62_warn -Wall -Wextra -Werror)
endif()

file(GLOB _fuse_wp62_shader_files CONFIGURE_DEPENDS "${_fuse_wp62_shd}/*")
add_library(fuse_rt_effects STATIC
    ${_fuse_wp62_src}/rt_effects.cpp
    ${_fuse_wp62_inc}/rt_effects_types.hpp
    ${_fuse_wp62_inc}/rt_effects_kernel.hpp
    ${_fuse_wp62_inc}/rt_effects.hpp
    ${_fuse_wp62_shader_files}
)
set_source_files_properties(${_fuse_wp62_shader_files} PROPERTIES HEADER_FILE_ONLY TRUE)
# fuse_lighting_gpu: the LTC area-light encoding (ltc_kernel.hpp) packShadowLight decodes.
target_link_libraries(fuse_rt_effects PUBLIC fuse_rt fuse_material_resolve PRIVATE fuse_lighting_gpu)
target_compile_options(fuse_rt_effects PRIVATE ${_fuse_wp62_warn})
fuse_apply_cxx23(fuse_rt_effects)

add_library(fuse_rt_effects_reference STATIC
    ${_fuse_wp62_src}/rt_effects_reference.cpp
    ${_fuse_wp62_inc}/rt_effects_reference.hpp
)
target_link_libraries(fuse_rt_effects_reference PUBLIC fuse_rt_effects fuse_rt_reference)
target_compile_options(fuse_rt_effects_reference PRIVATE ${_fuse_wp62_warn})
fuse_apply_cxx23(fuse_rt_effects_reference)

# Kernels, embedded into fuse_rt_effects: Slang primary, GLSL twins (the gates run both).
set(_fuse_wp62_gen "${CMAKE_CURRENT_BINARY_DIR}/rt_effects_gen")
set(_fuse_wp62_spv "${CMAKE_CURRENT_BINARY_DIR}/shaders/rt_effects")
file(MAKE_DIRECTORY "${_fuse_wp62_gen}" "${_fuse_wp62_spv}")
set(_fuse_wp62_header "${_fuse_wp62_gen}/rt_effects_spv.h")
add_custom_target(fuse_rt_effects_kernels)
set(_fuse_wp62_embed_args "")
set(_fuse_wp62_embed_deps "")
foreach(_row IN LISTS _fuse_wp62_kernels)
    string(REPLACE "|" ";" _entry "${_row}")
    list(GET _entry 0 _key)
    list(GET _entry 2 _glsl)
    list(GET _entry 3 _slang)
    string(TOLOWER "${_key}" _suffix)
    if(COMMAND fuse_add_slang_shaders)
        fuse_add_slang_shaders(fuse_rt_effects_kernels
            SOURCES "${_fuse_wp62_shd}/${_slang}"
            STAGE compute
            SUFFIX ".rtfx_${_suffix}"
            INCLUDE_DIRS "${_fuse_wp62_scene_inc}" "${_fuse_wp62_shd}" "${_fuse_wp62_root}/shaders" # + atmosphere/at_sample
            # 39001: the bindless arrays alias one binding on purpose.
            FLAGS -warnings-disable 39001 -fp-mode precise -capability spvRayQueryKHR
            OUTPUT_DIR "${_fuse_wp62_spv}"
            OUTPUT_VAR _fuse_wp62_out)
        if(_fuse_wp62_out)
            list(APPEND _fuse_wp62_embed_args "-D${_key}_SLANG=${_fuse_wp62_out}")
            list(APPEND _fuse_wp62_embed_deps "${_fuse_wp62_out}")
        endif()
    endif()
    if(FUSE_GLSLANG_VALIDATOR)
        set(_out "${_fuse_wp62_spv}/rtfx_${_suffix}.glsl.spv")
        set(_cmds COMMAND "${FUSE_GLSLANG_VALIDATOR}" --target-env vulkan1.3 "-I${_fuse_wp62_common_inc}" "-I${_fuse_wp62_scene_inc}"
                          "-I${_fuse_wp62_shd}" "-I${_fuse_wp62_root}/shaders" "${_fuse_wp62_shd}/${_glsl}" -o "${_out}")
        if(FUSE_SPIRV_VAL)
            list(APPEND _cmds COMMAND "${FUSE_SPIRV_VAL}" --target-env vulkan1.3 "${_out}")
        endif()
        add_custom_command(OUTPUT "${_out}" ${_cmds}
            DEPENDS "${_fuse_wp62_shd}/${_glsl}" "${_fuse_wp62_shd}/rtfx_common.glsl" "${_fuse_wp62_scene_inc}/gpu_scene.glsl"
                    "${_fuse_wp62_common_inc}/bindless.glsl" "${_fuse_wp62_root}/shaders/atmosphere/at_sample.glsl"
            COMMENT "glslangValidator ${_glsl} (rtfx_${_suffix}, GLSL twin)"
            VERBATIM)
        list(APPEND _fuse_wp62_embed_args "-D${_key}_GLSL=${_out}")
        list(APPEND _fuse_wp62_embed_deps "${_out}")
    endif()
endforeach()
add_custom_command(OUTPUT "${_fuse_wp62_header}"
    COMMAND "${CMAKE_COMMAND}" "-DOUT=${_fuse_wp62_header}" ${_fuse_wp62_embed_args} -P "${CMAKE_CURRENT_LIST_FILE}"
    DEPENDS ${_fuse_wp62_embed_deps} "${CMAKE_CURRENT_LIST_FILE}"
    COMMENT "Embedding the ray-traced shadow / reflection kernels' SPIR-V"
    VERBATIM)
add_custom_target(fuse_rt_effects_header DEPENDS "${_fuse_wp62_header}")
add_dependencies(fuse_rt_effects_header fuse_rt_effects_kernels)
add_dependencies(fuse_rt_effects fuse_rt_effects_header)
target_include_directories(fuse_rt_effects PRIVATE "${_fuse_wp62_gen}")

if(NOT FUSE_BUILD_CORE_TESTS)
    return()
endif()

# --- CPU gates (layouts, sequence, sampling, offline reference, API; also run in the stub tree) -------------
add_executable(fuse_rp_rt_effects_cpu ${_fuse_wp62_tests_dir}/test_rp_rt_effects_cpu.cpp)
target_link_libraries(fuse_rp_rt_effects_cpu PRIVATE fuse_rt_effects_reference fuse_lighting_gpu)
target_compile_definitions(fuse_rp_rt_effects_cpu PRIVATE "FUSE_RT_EFFECTS_SHADER_DIR=\"${_fuse_wp62_shd}\""
                                                          "FUSE_LIGHTING_SHADER_DIR=\"${_fuse_wp62_root}/shaders/lighting\"")
target_compile_options(fuse_rp_rt_effects_cpu PRIVATE ${_fuse_wp62_warn})
fuse_apply_cxx23(fuse_rp_rt_effects_cpu)
foreach(_suite layout sequence sampling reference api)
    add_test(NAME fuse_rp_rt_effects_${_suite} COMMAND fuse_rp_rt_effects_cpu ${_suite})
    set_tests_properties(fuse_rp_rt_effects_${_suite} PROPERTIES LABELS "gate;renderer;rt" TIMEOUT 600)
endforeach()

# --- Lavapipe gates ------------------------------------------------------------------------------------------
add_executable(fuse_rp_rt_effects ${_fuse_wp62_tests_dir}/test_rp_rt_effects.cpp)
target_link_libraries(fuse_rp_rt_effects PRIVATE fuse_rt_effects_reference fuse_lighting_gpu fuse_geometry fuse_atmosphere_gpu)
target_compile_options(fuse_rp_rt_effects PRIVATE ${_fuse_wp62_warn})
fuse_apply_cxx23(fuse_rp_rt_effects)

# tests/CMakeLists.txt writes the ICD lock wrapper; its variable is scoped to that directory.
set(_fuse_wp62_lock "${CMAKE_CURRENT_BINARY_DIR}/tests/run_vulkan_icd_locked.sh")
set(_fuse_wp62_vk_tests "")
foreach(_mode hard converge shade zero_alloc caps_gate sky)
    set(_name "fuse_rp_rt_effects_vk_${_mode}")
    if(FUSE_VULKAN_BACKEND)
        add_test(NAME ${_name} COMMAND "${_fuse_wp62_lock}" "$<TARGET_FILE:fuse_rp_rt_effects>" --mode ${_mode})
    else()
        add_test(NAME ${_name} COMMAND fuse_rp_rt_effects --mode ${_mode})
    endif()
    list(APPEND _fuse_wp62_vk_tests ${_name})
endforeach()
set_tests_properties(${_fuse_wp62_vk_tests} PROPERTIES
    ENVIRONMENT "VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/lvp_icd.json"
    RUN_SERIAL TRUE
    SKIP_RETURN_CODE 77
    TIMEOUT 1800
    LABELS "gate;vulkan;renderer;rt")
