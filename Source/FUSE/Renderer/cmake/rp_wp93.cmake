add_custom_target(fuse_dgc_kernels)
set(_fuse_wp93_embed_args "")
set(_fuse_wp93_embed_deps "")
if(COMMAND fuse_add_slang_shaders)
    fuse_add_slang_shaders(fuse_dgc_kernels
        SOURCES "${_fuse_wp93_shd}/dgc_generate.slang"
        STAGE compute
        OUTPUT_DIR "${_fuse_wp93_spv}"
        OUTPUT_VAR _fuse_wp93_gen_slang)
    if(_fuse_wp93_gen_slang)
        list(APPEND _fuse_wp93_embed_args "-DGEN_SLANG=${_fuse_wp93_gen_slang}")
        list(APPEND _fuse_wp93_embed_deps "${_fuse_wp93_gen_slang}")
    endif()
endif()

# glslangValidator -> SPIR-V (+ spirv-val) for one GLSL source; sets <out_var> to the .spv path.
function(_fuse_wp93_glsl src out_name out_var)
    set(_out "${_fuse_wp93_spv}/${out_name}")
    set(_cmds COMMAND "${FUSE_GLSLANG_VALIDATOR}" --target-env vulkan1.3 "-I${_fuse_wp93_common_inc}"
                      "-I${_fuse_wp93_scene_inc}" "${src}" -o "${_out}")
    if(FUSE_SPIRV_VAL)
        list(APPEND _cmds COMMAND "${FUSE_SPIRV_VAL}" --target-env vulkan1.3 "${_out}")
    endif()
    add_custom_command(OUTPUT "${_out}" ${_cmds}
        DEPENDS "${src}" "${_fuse_wp93_scene_inc}/gpu_scene.glsl" "${_fuse_wp93_common_inc}/bindless.glsl"
        COMMENT "glslangValidator ${out_name} (GLSL twin)"
        VERBATIM)
    set(${out_var} "${_out}" PARENT_SCOPE)
endfunction()

if(FUSE_GLSLANG_VALIDATOR)
    _fuse_wp93_glsl("${_fuse_wp93_shd}/dgc_generate.comp" dgc_generate.comp.spv _fuse_wp93_gen_glsl)
    list(APPEND _fuse_wp93_embed_args "-DGEN_GLSL=${_fuse_wp93_gen_glsl}")
    list(APPEND _fuse_wp93_embed_deps "${_fuse_wp93_gen_glsl}")
endif()
add_custom_command(OUTPUT "${_fuse_wp93_header}"
    COMMAND "${CMAKE_COMMAND}" "-DOUT=${_fuse_wp93_header}" ${_fuse_wp93_embed_args} -P "${CMAKE_CURRENT_LIST_FILE}"
    DEPENDS ${_fuse_wp93_embed_deps} "${CMAKE_CURRENT_LIST_FILE}"
    COMMENT "Embedding the DGC generate kernel's SPIR-V"
    VERBATIM)
add_custom_target(fuse_dgc_header DEPENDS "${_fuse_wp93_header}")
add_dependencies(fuse_dgc_header fuse_dgc_kernels)
add_dependencies(fuse_dgc fuse_dgc_header)
target_include_directories(fuse_dgc PRIVATE "${_fuse_wp93_gen}")

