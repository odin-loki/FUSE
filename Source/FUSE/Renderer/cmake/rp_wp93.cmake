# WP-9.3 (docs/unification/RENDERER-EXECUTION.md): device-generated commands (VK_EXT_device_generated_commands)
# pipeline selection for the WP-1.3 culling output, with the indirect-count fallback.
# Owned by WP-9.3; other packages must not edit this file.
#
#   fuse_dgc          STATIC  DgcPipelineSelector (dgc.reset + dgc.generate on render graph v2, DGC execute or
#                             per-bucket vkCmdDrawIndexedIndirectCount), capability gate, CPU reference +
#                             indirect-commands layout emulation (include/fuse/renderer/vk/dgc/**, src/vk/dgc/**)
#   dgc_generate      SPIR-V  Slang (primary) + GLSL twin, embedded in fuse_dgc
#   dgc_draw          SPIR-V  test raster (vertex + fragment, bucket = specialization constant), files for the gate
#   fuse_rp_dgc_*     ctest   CPU gates (stub-safe) and Lavapipe gates (validation + sync validation)

# Script mode (build step): embed the kernel SPIR-V into a C++ header.
#   cmake -DOUT=<header> [-DGEN_SLANG=<spv>] [-DGEN_GLSL=<spv>] -P rp_wp93.cmake
if(CMAKE_SCRIPT_MODE_FILE)
    set(_text "// Generated by Source/FUSE/Renderer/cmake/rp_wp93.cmake from shaders/dgc/dgc_generate.{slang,comp}.\n")
    string(APPEND _text "// Do not edit.\n#pragma once\n#include <cstdint>\n")
    foreach(_lang SLANG GLSL)
        if(GEN_${_lang} AND EXISTS "${GEN_${_lang}}")
            if(_lang STREQUAL "SLANG")
                set(_suffix Slang)
            else()
                set(_suffix Glsl)
            endif()
            string(APPEND _text "#define FUSE_DGC_${_lang} 1\n")
            file(READ "${GEN_${_lang}}" _hex HEX)
            string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1u," _words "${_hex}")
            string(APPEND _text "alignas(4) static const std::uint32_t kDgcGenerate${_suffix}Spv[] = {${_words}};\n")
        endif()
    endforeach()
    file(WRITE "${OUT}" "${_text}")
    return()
endif()

get_filename_component(_fuse_wp93_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(_fuse_wp93_inc "${_fuse_wp93_root}/include/fuse/renderer/vk/dgc")
set(_fuse_wp93_src "${_fuse_wp93_root}/src/vk/dgc")
set(_fuse_wp93_shd "${_fuse_wp93_root}/shaders/dgc")
set(_fuse_wp93_scene_inc "${_fuse_wp93_root}/include/fuse/renderer/gpu_scene")
set(_fuse_wp93_common_inc "${_fuse_wp93_root}/shaders/common")

add_library(fuse_dgc STATIC
    ${_fuse_wp93_src}/dgc_pipeline_selector.cpp
    ${_fuse_wp93_src}/dgc_reference.cpp
    ${_fuse_wp93_src}/dgc_vk_ext.hpp
    ${_fuse_wp93_inc}/dgc_types.hpp
    ${_fuse_wp93_inc}/dgc_reference.hpp
    ${_fuse_wp93_inc}/dgc_pipeline_selector.hpp
    ${_fuse_wp93_shd}/dgc_generate.comp
    ${_fuse_wp93_shd}/dgc_generate.slang
)
