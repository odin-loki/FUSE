# WP-9.2 (docs/unification/RENDERER-EXECUTION.md): 3D Gaussian splatting (Kerbl et al. 2023) on Vulkan.
# Owned by WP-9.2; other packages must not edit this file.
#
#   fuse_gsplat          STATIC  GsplatRenderer (gsplat.preprocess, .scan, .emit, .sort (GpuRadixSort), .ranges,
#                                .raster on render graph v2), the 3DGS .ply loader and the CPU reference renderer
#                                (include/fuse/renderer/gsplat/**, src/gsplat/**)
#   gs_* kernels         SPIR-V  Slang (primary) + GLSL twins, embedded in fuse_gsplat
#   fuse_rp_gsplat_*     ctest   CPU gates (stub-safe) and Lavapipe gates (validation + sync validation)

# Every embedded kernel, '|'-separated: KEY | C++ name stem | GLSL source | Slang source
set(_fuse_wp92_kernels
    "PREPROCESS|Preprocess|gs_preprocess.comp|gs_preprocess.slang"
    "SCAN|Scan|gs_scan.comp|gs_scan.slang"
    "EMIT|Emit|gs_emit.comp|gs_emit.slang"
    "RANGES|Ranges|gs_ranges.comp|gs_ranges.slang"
    "RASTER|Raster|gs_raster.comp|gs_raster.slang")

# Script mode (build step): embed the kernels' SPIR-V into a C++ header.
#   cmake -DOUT=<header> [-D<KEY>_SLANG=<spv> ...] [-D<KEY>_GLSL=<spv> ...] -P rp_wp92.cmake
if(CMAKE_SCRIPT_MODE_FILE)
    cmake_policy(SET CMP0007 NEW)
    set(_text "// Generated by Source/FUSE/Renderer/cmake/rp_wp92.cmake from shaders/gsplat/*. Do not edit.\n")
    string(APPEND _text "#pragma once\n#include <cstdint>\n")
    foreach(_lang SLANG GLSL)
        if(_lang STREQUAL "SLANG")
            set(_suffix Slang)
        else()
            set(_suffix Glsl)
        endif()
        set(_complete TRUE)
        foreach(_row IN LISTS _fuse_wp92_kernels)
            string(REPLACE "|" ";" _entry "${_row}")
            list(GET _entry 0 _key)
            if(NOT ${_key}_${_lang} OR NOT EXISTS "${${_key}_${_lang}}")
                set(_complete FALSE)
            endif()
        endforeach()
        if(_complete)
            string(APPEND _text "#define FUSE_GSPLAT_${_lang} 1\n")
            foreach(_row IN LISTS _fuse_wp92_kernels)
                string(REPLACE "|" ";" _entry "${_row}")
                list(GET _entry 0 _key)
                list(GET _entry 1 _stem)
                file(READ "${${_key}_${_lang}}" _hex HEX)
                string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1u," _words "${_hex}")
                string(APPEND _text "alignas(4) static const std::uint32_t kGs${_stem}${_suffix}Spv[] = {${_words}};\n")
            endforeach()
        endif()
    endforeach()
    file(WRITE "${OUT}" "${_text}")
    return()
endif()

get_filename_component(_fuse_wp92_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(_fuse_wp92_inc "${_fuse_wp92_root}/include/fuse/renderer/gsplat")
set(_fuse_wp92_src "${_fuse_wp92_root}/src/gsplat")
set(_fuse_wp92_shd "${_fuse_wp92_root}/shaders/gsplat")
set(_fuse_wp92_common_inc "${_fuse_wp92_root}/shaders/common")

file(GLOB _fuse_wp92_shader_files CONFIGURE_DEPENDS "${_fuse_wp92_shd}/*")
add_library(fuse_gsplat STATIC
    ${_fuse_wp92_src}/gsplat.cpp
    ${_fuse_wp92_src}/gsplat_ply.cpp
    ${_fuse_wp92_src}/gsplat_reference.cpp
    ${_fuse_wp92_inc}/gsplat_types.hpp
    ${_fuse_wp92_inc}/gsplat_ply.hpp
    ${_fuse_wp92_inc}/gsplat_reference.hpp
    ${_fuse_wp92_inc}/gsplat.hpp
    ${_fuse_wp92_shader_files}
)
set_source_files_properties(${_fuse_wp92_shader_files} PROPERTIES HEADER_FILE_ONLY TRUE)
target_link_libraries(fuse_gsplat PUBLIC fuse_rhi)
fuse_apply_cxx23(fuse_gsplat)

# Kernels, embedded into the library. Slang is the primary source (execution doc §8 decision 1a); the
# GLSL twins keep the splat passes available where slangc is not (FUSE_SLANG=AUTO), and the gates run both.
# Slang: -fp-mode precise; GLSL: `precise` (the oracle's operation order, no contraction).
set(_fuse_wp92_gen "${CMAKE_CURRENT_BINARY_DIR}/gsplat_gen")
set(_fuse_wp92_spv "${CMAKE_CURRENT_BINARY_DIR}/shaders/gsplat")
file(MAKE_DIRECTORY "${_fuse_wp92_gen}" "${_fuse_wp92_spv}")
set(_fuse_wp92_header "${_fuse_wp92_gen}/gsplat_spv.h")
add_custom_target(fuse_gsplat_kernels)
set(_fuse_wp92_embed_args "")
set(_fuse_wp92_embed_deps "")
file(GLOB _fuse_wp92_glsl_includes "${_fuse_wp92_shd}/*.glsl")

foreach(_row IN LISTS _fuse_wp92_kernels)
    string(REPLACE "|" ";" _entry "${_row}")
    list(GET _entry 0 _key)
    list(GET _entry 2 _glsl)
    list(GET _entry 3 _slang)
    string(TOLOWER "${_key}" _suffix)
    if(COMMAND fuse_add_slang_shaders)
        fuse_add_slang_shaders(fuse_gsplat_kernels
            SOURCES "${_fuse_wp92_shd}/${_slang}"
            STAGE compute
            SUFFIX ".gs_${_suffix}"
            INCLUDE_DIRS "${_fuse_wp92_shd}"
            # 39001: the bindless arrays alias one binding on purpose.
            FLAGS -warnings-disable 39001 -fp-mode precise
            OUTPUT_DIR "${_fuse_wp92_spv}"
            OUTPUT_VAR _fuse_wp92_out)
        if(_fuse_wp92_out)
            list(APPEND _fuse_wp92_embed_args "-D${_key}_SLANG=${_fuse_wp92_out}")
            list(APPEND _fuse_wp92_embed_deps "${_fuse_wp92_out}")
        endif()
    endif()
    if(FUSE_GLSLANG_VALIDATOR)
        set(_out "${_fuse_wp92_spv}/gs_${_suffix}.glsl.spv")
        set(_cmds COMMAND "${FUSE_GLSLANG_VALIDATOR}" --target-env vulkan1.3 "-I${_fuse_wp92_common_inc}"
                          "-I${_fuse_wp92_shd}" "${_fuse_wp92_shd}/${_glsl}" -o "${_out}")
        if(FUSE_SPIRV_VAL)
            list(APPEND _cmds COMMAND "${FUSE_SPIRV_VAL}" --target-env vulkan1.3 "${_out}")
        endif()
        add_custom_command(OUTPUT "${_out}" ${_cmds}
            DEPENDS "${_fuse_wp92_shd}/${_glsl}" ${_fuse_wp92_glsl_includes} "${_fuse_wp92_common_inc}/bindless.glsl"
            COMMENT "glslangValidator ${_glsl} (gs_${_suffix}, GLSL twin)"
            VERBATIM)
        list(APPEND _fuse_wp92_embed_args "-D${_key}_GLSL=${_out}")
        list(APPEND _fuse_wp92_embed_deps "${_out}")
    endif()
endforeach()
add_custom_command(OUTPUT "${_fuse_wp92_header}"
    COMMAND "${CMAKE_COMMAND}" "-DOUT=${_fuse_wp92_header}" ${_fuse_wp92_embed_args} -P "${CMAKE_CURRENT_LIST_FILE}"
    DEPENDS ${_fuse_wp92_embed_deps} "${CMAKE_CURRENT_LIST_FILE}"
    COMMENT "Embedding the Gaussian splatting kernels' SPIR-V"
    VERBATIM)
add_custom_target(fuse_gsplat_header DEPENDS "${_fuse_wp92_header}")
add_dependencies(fuse_gsplat_header fuse_gsplat_kernels)
add_dependencies(fuse_gsplat fuse_gsplat_header)
target_include_directories(fuse_gsplat PRIVATE "${_fuse_wp92_gen}")

if(NOT FUSE_BUILD_CORE_TESTS)
    return()
endif()

set(_fuse_wp92_tests_dir "${_fuse_wp92_root}/tests")

# --- CPU gates (layouts, .ply loader, reference renderer invariants; also in the stub tree) ---------------
add_executable(fuse_rp_gsplat_cpu ${_fuse_wp92_tests_dir}/test_rp_gsplat_cpu.cpp)
target_link_libraries(fuse_rp_gsplat_cpu PRIVATE fuse_gsplat)
target_compile_definitions(fuse_rp_gsplat_cpu PRIVATE FUSE_RP_GSPLAT_SHADER_DIR="${_fuse_wp92_shd}")
fuse_apply_cxx23(fuse_rp_gsplat_cpu)
foreach(_suite layout ply reference api)
    add_test(NAME fuse_rp_gsplat_${_suite} COMMAND fuse_rp_gsplat_cpu ${_suite})
    set_tests_properties(fuse_rp_gsplat_${_suite} PROPERTIES LABELS "gate;renderer;gsplat" TIMEOUT 900)
endforeach()

# --- Lavapipe gates ------------------------------------------------------------------------------
add_executable(fuse_rp_gsplat ${_fuse_wp92_tests_dir}/test_rp_gsplat.cpp)
target_link_libraries(fuse_rp_gsplat PRIVATE fuse_gsplat)
fuse_apply_cxx23(fuse_rp_gsplat)

# tests/CMakeLists.txt writes the ICD lock wrapper; its variable is scoped to that directory.
set(_fuse_wp92_lock "${CMAKE_CURRENT_BINARY_DIR}/tests/run_vulkan_icd_locked.sh")
set(_fuse_wp92_vk_tests "")
foreach(_case "passes;set" "passes;buffer" "composite;set" "determinism;set" "zero_alloc;set")
    list(GET _case 0 _mode)
    list(GET _case 1 _backend)
    set(_name "fuse_rp_gsplat_vk_${_mode}_${_backend}")
    if(FUSE_VULKAN_BACKEND)
        add_test(NAME ${_name}
                 COMMAND "${_fuse_wp92_lock}" "$<TARGET_FILE:fuse_rp_gsplat>" --mode ${_mode} --backend ${_backend})
    else()
        add_test(NAME ${_name} COMMAND fuse_rp_gsplat --mode ${_mode} --backend ${_backend})
    endif()
    list(APPEND _fuse_wp92_vk_tests ${_name})
endforeach()
set_tests_properties(${_fuse_wp92_vk_tests} PROPERTIES
    ENVIRONMENT "VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/lvp_icd.json"
    RUN_SERIAL TRUE
    SKIP_RETURN_CODE 77
    TIMEOUT 900
    LABELS "gate;vulkan;renderer;gsplat")
