# Fetch the renderer plan §8 reference scenes (docs/unification/RENDERER-HW-RUN.md, "Reference scenes").
#
#   cmake -DDEST=<asset root> [-DSCENE=sponza|bistro|all] -P Source/FUSE/Renderer/cmake/rp_hw_fetch_reference_scenes.cmake
#
# Reads tests/perf/reference_scenes.manifest. For every selected scene: downloads <url> to <DEST>/<archive> (skipped
# when the file is already there), checks its SHA-256 against the pinned value, and extracts it into <DEST>/<name>/.
# An empty pin is never trusted: the script stops after printing the archive's hash, unless
# FUSE_REFSCENE_PIN_ON_FIRST_FETCH=1 is set in the environment (trust on first use: it then extracts and prints the
# line to commit to the manifest). Downloads happen only when someone runs this script; no ctest runs it.
cmake_minimum_required(VERSION 3.20)
if(NOT DEST)
    message(FATAL_ERROR "usage: cmake -DDEST=<dir> [-DSCENE=sponza|bistro|all] -P ${CMAKE_CURRENT_LIST_FILE}")
endif()
if(NOT SCENE)
    set(SCENE all)
endif()
get_filename_component(_manifest "${CMAKE_CURRENT_LIST_DIR}/../tests/perf/reference_scenes.manifest" ABSOLUTE)
file(STRINGS "${_manifest}" _lines REGEX "^[a-z]")
file(MAKE_DIRECTORY "${DEST}")
foreach(_line IN LISTS _lines)
    string(REPLACE "|" ";" _f "${_line}")
    list(GET _f 0 _name)
    list(GET _f 1 _url)
    list(GET _f 2 _archive)
    list(GET _f 3 _sha)
    list(GET _f 4 _marker)
    if(NOT SCENE STREQUAL "all" AND NOT SCENE STREQUAL _name)
        continue()
    endif()
    set(_file "${DEST}/${_archive}")
    if(NOT EXISTS "${_file}")
        message(STATUS "${_name}: downloading ${_url}")
        if(_sha)
            file(DOWNLOAD "${_url}" "${_file}" SHOW_PROGRESS STATUS _st EXPECTED_HASH SHA256=${_sha})
        else()
            file(DOWNLOAD "${_url}" "${_file}" SHOW_PROGRESS STATUS _st)
        endif()
        list(GET _st 0 _code)
        if(NOT _code EQUAL 0)
            file(REMOVE "${_file}")
            message(FATAL_ERROR "${_name}: download failed: ${_st}")
        endif()
    endif()
    file(SHA256 "${_file}" _have)
    if(_sha AND NOT _have STREQUAL _sha)
        message(FATAL_ERROR "${_name}: sha256 mismatch: ${_have} (pinned ${_sha}); delete ${_file} and fetch again")
    endif()
    if(NOT _sha)
        message(STATUS "${_name}: UNPINNED archive sha256 = ${_have}")
        if(NOT "$ENV{FUSE_REFSCENE_PIN_ON_FIRST_FETCH}" STREQUAL "1")
            message(FATAL_ERROR "${_name}: the manifest has no pin; review the archive, then rerun with "
                                "FUSE_REFSCENE_PIN_ON_FIRST_FETCH=1 and commit the printed line")
        endif()
        message(STATUS "commit to ${_manifest}:\n${_name}|${_url}|${_archive}|${_have}|${_marker}|...")
    endif()
    if(NOT EXISTS "${DEST}/${_name}/${_marker}")
        message(STATUS "${_name}: extracting into ${DEST}/${_name}")
        file(ARCHIVE_EXTRACT INPUT "${_file}" DESTINATION "${DEST}/${_name}")
    endif()
    if(NOT EXISTS "${DEST}/${_name}/${_marker}")
        message(FATAL_ERROR "${_name}: ${_marker} missing after extraction (update the manifest's marker column)")
    endif()
    message(STATUS "${_name}: ok (${_have})")
endforeach()
