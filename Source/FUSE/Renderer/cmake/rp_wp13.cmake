# WP-1.3 (docs/unification/RENDERER-EXECUTION.md): instance cull + Hi-Z + indirect-count.
# Owned by WP-1.3; other packages must not edit this file.
#
#   fuse_culling          STATIC  InstanceCuller (two-phase occlusion, single-pass Hi-Z, draw-indirect-count
#                                 args, all as render-graph v2 passes) + CPU reference helpers
#                                 (include/fuse/renderer/culling/**, src/culling/**)
#   instance_cull         SPIR-V  both cull phases, Slang (primary) + GLSL twin, embedded in fuse_culling
#   hiz_build             SPIR-V  SPD-style single-pass Hi-Z, Slang + GLSL twin, embedded in fuse_culling
#   cull_draw             SPIR-V  test raster (vertex + fragment), Slang + GLSL twin, files for the gate
#   fuse_rp_culling_*     ctest   CPU gates (stub-safe) and Lavapipe gates (validation + sync validation)

# Script mode (build step): embed the kernel SPIR-V into a C++ header.
#   cmake -DOUT=<header> [-DCULL_SLANG=<spv> -DHIZ_SLANG=<spv>] [-DCULL_GLSL=<spv> -DHIZ_GLSL=<spv>] -P rp_wp13.cmake
if(CMAKE_SCRIPT_MODE_FILE)
    set(_text "// Generated by Source/FUSE/Renderer/cmake/rp_wp13.cmake from shaders/culling/{instance_cull,hiz_build}.{slang,comp}.\n")
    string(APPEND _text "// Do not edit.\n#pragma once\n#include <cstdint>\n")
    foreach(_lang SLANG GLSL)
        if(CULL_${_lang} AND HIZ_${_lang} AND EXISTS "${CULL_${_lang}}" AND EXISTS "${HIZ_${_lang}}")
            if(_lang STREQUAL "SLANG")
                set(_suffix Slang)
            else()
                set(_suffix Glsl)
            endif()
            string(APPEND _text "#define FUSE_CULLING_${_lang} 1\n")
            foreach(_kernel CULL HIZ)
                file(READ "${${_kernel}_${_lang}}" _hex HEX)
                string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1u," _words "${_hex}")
                if(_kernel STREQUAL "CULL")
                    set(_name kCullingCull${_suffix}Spv)
                else()
                    set(_name kCullingHiz${_suffix}Spv)
                endif()
                string(APPEND _text "alignas(4) static const std::uint32_t ${_name}[] = {${_words}};\n")
            endforeach()
        endif()
    endforeach()
    file(WRITE "${OUT}" "${_text}")
    return()
endif()

