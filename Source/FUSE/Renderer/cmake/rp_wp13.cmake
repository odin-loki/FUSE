set(_fuse_wp13_vk_tests "")
foreach(_case "parity;set" "parity;buffer" "camera_cut;set" "camera_cut;buffer" "submit_flat;set" "zero_alloc;set")
    list(GET _case 0 _mode)
    list(GET _case 1 _backend)
    set(_name "fuse_rp_culling_vk_${_mode}_${_backend}")
    if(FUSE_VULKAN_BACKEND)
        add_test(NAME ${_name}
                 COMMAND "${_fuse_wp13_lock}" "$<TARGET_FILE:fuse_rp_culling>" --mode ${_mode} --backend ${_backend})
    else()
        add_test(NAME ${_name} COMMAND fuse_rp_culling --mode ${_mode} --backend ${_backend})
    endif()
    list(APPEND _fuse_wp13_vk_tests ${_name})
endforeach()
