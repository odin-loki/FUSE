# Kernels, embedded into the library. Slang is the primary source (renderer plan §4, execution doc §8
# decision 1a); the GLSL twins keep culling available where slangc is not (FUSE_SLANG=AUTO), and the
# gates run both and require identical results. instance_cull.slang is compiled with
# -fp-mode precise (Slang does not honour `precise` per variable), so neither twin contracts FMAs.
set(_fuse_wp13_gen "${CMAKE_CURRENT_BINARY_DIR}/culling_gen")
set(_fuse_wp13_spv "${CMAKE_CURRENT_BINARY_DIR}/shaders/culling")
file(MAKE_DIRECTORY "${_fuse_wp13_gen}" "${_fuse_wp13_spv}")
set(_fuse_wp13_header "${_fuse_wp13_gen}/culling_spv.h")
add_custom_target(fuse_culling_kernels)
set(_fuse_wp13_embed_args "")
set(_fuse_wp13_embed_deps "")
if(COMMAND fuse_add_slang_shaders)
    fuse_add_slang_shaders(fuse_culling_kernels
        SOURCES "${_fuse_wp13_shd}/instance_cull.slang"
        STAGE compute
        INCLUDE_DIRS "${_fuse_wp13_scene_inc}" "${_fuse_wp13_shd}"
        FLAGS -fp-mode precise
        OUTPUT_DIR "${_fuse_wp13_spv}"
        OUTPUT_VAR _fuse_wp13_cull_slang)
    fuse_add_slang_shaders(fuse_culling_kernels
        SOURCES "${_fuse_wp13_shd}/hiz_build.slang"
        STAGE compute
        INCLUDE_DIRS "${_fuse_wp13_scene_inc}" "${_fuse_wp13_shd}"
        OUTPUT_DIR "${_fuse_wp13_spv}"
        OUTPUT_VAR _fuse_wp13_hiz_slang)
    if(_fuse_wp13_cull_slang AND _fuse_wp13_hiz_slang)
        list(APPEND _fuse_wp13_embed_args "-DCULL_SLANG=${_fuse_wp13_cull_slang}" "-DHIZ_SLANG=${_fuse_wp13_hiz_slang}")
        list(APPEND _fuse_wp13_embed_deps "${_fuse_wp13_cull_slang}" "${_fuse_wp13_hiz_slang}")
    endif()
endif()

# glslangValidator -> SPIR-V (+ spirv-val) for one GLSL source; sets <out_var> to the .spv path.
function(_fuse_wp13_glsl src out_name out_var)
    set(_out "${_fuse_wp13_spv}/${out_name}")
    set(_cmds COMMAND "${FUSE_GLSLANG_VALIDATOR}" --target-env vulkan1.3 "-I${_fuse_wp13_common_inc}"
                      "-I${_fuse_wp13_scene_inc}" "-I${_fuse_wp13_shd}" "${src}" -o "${_out}")
    if(FUSE_SPIRV_VAL)
        list(APPEND _cmds COMMAND "${FUSE_SPIRV_VAL}" --target-env vulkan1.3 "${_out}")
    endif()
    add_custom_command(OUTPUT "${_out}" ${_cmds}
        DEPENDS "${src}" "${_fuse_wp13_shd}/cull_common.glsl" "${_fuse_wp13_scene_inc}/gpu_scene.glsl"
                "${_fuse_wp13_common_inc}/bindless.glsl"
        COMMENT "glslangValidator ${out_name} (GLSL twin)"
        VERBATIM)
    set(${out_var} "${_out}" PARENT_SCOPE)
endfunction()

if(FUSE_GLSLANG_VALIDATOR)
    _fuse_wp13_glsl("${_fuse_wp13_shd}/instance_cull.comp" instance_cull.comp.spv _fuse_wp13_cull_glsl)
    _fuse_wp13_glsl("${_fuse_wp13_shd}/hiz_build.comp" hiz_build.comp.spv _fuse_wp13_hiz_glsl)
    list(APPEND _fuse_wp13_embed_args "-DCULL_GLSL=${_fuse_wp13_cull_glsl}" "-DHIZ_GLSL=${_fuse_wp13_hiz_glsl}")
    list(APPEND _fuse_wp13_embed_deps "${_fuse_wp13_cull_glsl}" "${_fuse_wp13_hiz_glsl}")
endif()
add_custom_command(OUTPUT "${_fuse_wp13_header}"
    COMMAND "${CMAKE_COMMAND}" "-DOUT=${_fuse_wp13_header}" ${_fuse_wp13_embed_args} -P "${CMAKE_CURRENT_LIST_FILE}"
    DEPENDS ${_fuse_wp13_embed_deps} "${CMAKE_CURRENT_LIST_FILE}"
    COMMENT "Embedding the culling kernels' SPIR-V"
    VERBATIM)
add_custom_target(fuse_culling_header DEPENDS "${_fuse_wp13_header}")
add_dependencies(fuse_culling_header fuse_culling_kernels)
add_dependencies(fuse_culling fuse_culling_header)
target_include_directories(fuse_culling PRIVATE "${_fuse_wp13_gen}")

