# WP-9.1 (docs/unification/RENDERER-EXECUTION.md): neural runtime (MLP with frequency / hash-grid encodings).
# Owned by WP-9.1; other packages must not edit this file.
#
#   fuse_neural        STATIC  NeuralNet (CPU reference inference, fp32 / fp16 parameters), NeuralTrainer (MSE +
#                              Adam), the FNNW weight file, NeuralGpu ("neural.infer" on render graph v2)
#                              (include/fuse/renderer/neural/**, src/neural/**)
#   nn_infer           SPIR-V  portable kernel: Slang (primary) + GLSL twin, embedded in fuse_neural
#   nn_infer_coopmat   SPIR-V  GL_KHR_cooperative_matrix kernel (GLSL), embedded when glslang supports the
#                              extension (configure-time probe); used only on devices with VK_KHR_cooperative_matrix
#   fuse_rp_neural_*   ctest   CPU gates (stub-safe) and Lavapipe gates (validation + sync validation)

# Script mode (build step): embed the kernels' SPIR-V into a C++ header.
#   cmake -DOUT=<header> [-DSLANG_SPV=<spv>] [-DGLSL_SPV=<spv>] [-DCOOP_SPV=<spv>] -P rp_wp91.cmake
if(CMAKE_SCRIPT_MODE_FILE)
    set(_text "// Generated by Source/FUSE/Renderer/cmake/rp_wp91.cmake from shaders/neural/*. Do not edit.\n")
    string(APPEND _text "#pragma once\n#include <cstdint>\n")
    foreach(_entry "SLANG;kNnInferSlangSpv;FUSE_NEURAL_SLANG" "GLSL;kNnInferGlslSpv;FUSE_NEURAL_GLSL"
                   "COOP;kNnInferCoopGlslSpv;FUSE_NEURAL_COOPMAT")
        list(GET _entry 0 _key)
        list(GET _entry 1 _name)
        list(GET _entry 2 _define)
        set(_spv "${${_key}_SPV}")
        if(_spv AND EXISTS "${_spv}")
            file(READ "${_spv}" _hex HEX)
            string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1u," _words "${_hex}")
            string(APPEND _text "#define ${_define} 1\n")
            string(APPEND _text "alignas(4) static const std::uint32_t ${_name}[] = {${_words}};\n")
        endif()
    endforeach()
    file(WRITE "${OUT}" "${_text}")
    return()
endif()

get_filename_component(_fuse_wp91_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(_fuse_wp91_inc "${_fuse_wp91_root}/include/fuse/renderer/neural")
set(_fuse_wp91_src "${_fuse_wp91_root}/src/neural")
set(_fuse_wp91_shd "${_fuse_wp91_root}/shaders/neural")

file(GLOB _fuse_wp91_shader_files CONFIGURE_DEPENDS "${_fuse_wp91_shd}/*")
add_library(fuse_neural STATIC
    ${_fuse_wp91_src}/neural_mlp.cpp
    ${_fuse_wp91_src}/neural_gpu.cpp
    ${_fuse_wp91_inc}/neural_types.hpp
    ${_fuse_wp91_inc}/neural_mlp.hpp
    ${_fuse_wp91_inc}/neural_gpu.hpp
    ${_fuse_wp91_shader_files}
)
set_source_files_properties(${_fuse_wp91_shader_files} PROPERTIES HEADER_FILE_ONLY TRUE)
target_link_libraries(fuse_neural PUBLIC fuse_rhi)
fuse_apply_cxx23(fuse_neural)
# The reference inference must round like the kernels and the naive oracle (no multiply-add contraction):
# PUBLIC, so every user compiles the same way.
if(MSVC AND CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
    target_compile_options(fuse_neural PUBLIC /fp:precise /clang:-ffp-contract=off) # clang-cl
elseif(MSVC)
    target_compile_options(fuse_neural PUBLIC /fp:precise)
elseif(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
    target_compile_options(fuse_neural PUBLIC -ffp-contract=off)
endif()

# Kernels, embedded into the library. Slang is the primary source (execution doc §8 decision 1a); the GLSL twin
# keeps the pass available where slangc is not (FUSE_SLANG=AUTO), and the gates run both.
set(_fuse_wp91_gen "${CMAKE_CURRENT_BINARY_DIR}/neural_gen")
set(_fuse_wp91_spv "${CMAKE_CURRENT_BINARY_DIR}/shaders/neural")
file(MAKE_DIRECTORY "${_fuse_wp91_gen}" "${_fuse_wp91_spv}")
set(_fuse_wp91_header "${_fuse_wp91_gen}/neural_spv.h")
add_custom_target(fuse_neural_kernels)
set(_fuse_wp91_embed_args "")
set(_fuse_wp91_embed_deps "")
if(COMMAND fuse_add_slang_shaders)
    fuse_add_slang_shaders(fuse_neural_kernels
        SOURCES "${_fuse_wp91_shd}/nn_infer.slang"
        STAGE compute
        SUFFIX ".nn_infer"
        INCLUDE_DIRS "${_fuse_wp91_shd}"
        FLAGS -fp-mode precise
        OUTPUT_DIR "${_fuse_wp91_spv}"
        OUTPUT_VAR _fuse_wp91_slang_out)
    if(_fuse_wp91_slang_out)
        list(APPEND _fuse_wp91_embed_args "-DSLANG_SPV=${_fuse_wp91_slang_out}")
        list(APPEND _fuse_wp91_embed_deps "${_fuse_wp91_slang_out}")
    endif()
endif()
if(FUSE_GLSLANG_VALIDATOR)
    set(_fuse_wp91_glsl_rows "GLSL|nn_infer.comp|nn_infer.glsl.spv")
    # Cooperative matrix: only when this glslang knows GL_KHR_cooperative_matrix (probe at configure time).
    execute_process(
        COMMAND "${FUSE_GLSLANG_VALIDATOR}" --target-env vulkan1.3 "-I${_fuse_wp91_shd}"
                "${_fuse_wp91_shd}/nn_infer_coopmat.comp" -o "${_fuse_wp91_spv}/nn_infer_coopmat.probe.spv"
        RESULT_VARIABLE _fuse_wp91_coop_rc OUTPUT_QUIET ERROR_QUIET)
    if(_fuse_wp91_coop_rc EQUAL 0)
        list(APPEND _fuse_wp91_glsl_rows "COOP|nn_infer_coopmat.comp|nn_infer_coopmat.glsl.spv")
    else()
        message(STATUS "WP-9.1: glslang lacks GL_KHR_cooperative_matrix; the cooperative-matrix kernel is not built")
    endif()
    foreach(_row IN LISTS _fuse_wp91_glsl_rows)
        string(REPLACE "|" ";" _entry "${_row}")
        list(GET _entry 0 _key)
        list(GET _entry 1 _src)
        list(GET _entry 2 _name)
        set(_out "${_fuse_wp91_spv}/${_name}")
        set(_cmds COMMAND "${FUSE_GLSLANG_VALIDATOR}" --target-env vulkan1.3 "-I${_fuse_wp91_shd}"
                          "${_fuse_wp91_shd}/${_src}" -o "${_out}")
        if(FUSE_SPIRV_VAL)
            list(APPEND _cmds COMMAND "${FUSE_SPIRV_VAL}" --target-env vulkan1.3 "${_out}")
        endif()
        add_custom_command(OUTPUT "${_out}" ${_cmds}
            DEPENDS "${_fuse_wp91_shd}/${_src}" "${_fuse_wp91_shd}/nn_common.glsl"
            COMMENT "glslangValidator ${_src}"
            VERBATIM)
        list(APPEND _fuse_wp91_embed_args "-D${_key}_SPV=${_out}")
        list(APPEND _fuse_wp91_embed_deps "${_out}")
    endforeach()
endif()
add_custom_command(OUTPUT "${_fuse_wp91_header}"
    COMMAND "${CMAKE_COMMAND}" "-DOUT=${_fuse_wp91_header}" ${_fuse_wp91_embed_args} -P "${CMAKE_CURRENT_LIST_FILE}"
    DEPENDS ${_fuse_wp91_embed_deps} "${CMAKE_CURRENT_LIST_FILE}"
    COMMENT "Embedding the neural kernels' SPIR-V"
    VERBATIM)
add_custom_target(fuse_neural_header DEPENDS "${_fuse_wp91_header}")
add_dependencies(fuse_neural_header fuse_neural_kernels)
add_dependencies(fuse_neural fuse_neural_header)
target_include_directories(fuse_neural PRIVATE "${_fuse_wp91_gen}")

if(NOT FUSE_BUILD_CORE_TESTS)
    return()
endif()

set(_fuse_wp91_tests_dir "${_fuse_wp91_root}/tests")

# --- CPU gates (stub-safe) -----------------------------------------------------------------------
add_executable(fuse_rp_neural_cpu ${_fuse_wp91_tests_dir}/test_rp_neural_cpu.cpp)
target_link_libraries(fuse_rp_neural_cpu PRIVATE fuse_neural)
target_compile_definitions(fuse_rp_neural_cpu PRIVATE FUSE_RP_NEURAL_SHADER_DIR="${_fuse_wp91_shd}")
fuse_apply_cxx23(fuse_rp_neural_cpu)
foreach(_suite layout fp16 naive_parity file gradient train_fit determinism coopmat_spirv zero_alloc)
    add_test(NAME fuse_rp_neural_${_suite} COMMAND fuse_rp_neural_cpu ${_suite})
    set_tests_properties(fuse_rp_neural_${_suite} PROPERTIES LABELS "gate;renderer;neural" TIMEOUT 900)
endforeach()
set_tests_properties(fuse_rp_neural_coopmat_spirv PROPERTIES SKIP_RETURN_CODE 77)

# --- Lavapipe gates ------------------------------------------------------------------------------
add_executable(fuse_rp_neural ${_fuse_wp91_tests_dir}/test_rp_neural.cpp)
target_link_libraries(fuse_rp_neural PRIVATE fuse_neural)
fuse_apply_cxx23(fuse_rp_neural)

# tests/CMakeLists.txt writes the ICD lock wrapper; its variable is scoped to that directory.
set(_fuse_wp91_lock "${CMAKE_CURRENT_BINARY_DIR}/tests/run_vulkan_icd_locked.sh")
set(_fuse_wp91_vk_tests "")
foreach(_case "infer;set" "infer;buffer" "zero_alloc;set")
    list(GET _case 0 _mode)
    list(GET _case 1 _backend)
    set(_name "fuse_rp_neural_vk_${_mode}_${_backend}")
    if(FUSE_VULKAN_BACKEND)
        add_test(NAME ${_name}
                 COMMAND "${_fuse_wp91_lock}" "$<TARGET_FILE:fuse_rp_neural>" --mode ${_mode} --backend ${_backend})
    else()
        add_test(NAME ${_name} COMMAND fuse_rp_neural --mode ${_mode} --backend ${_backend})
    endif()
    list(APPEND _fuse_wp91_vk_tests ${_name})
endforeach()
set_tests_properties(${_fuse_wp91_vk_tests} PROPERTIES
    ENVIRONMENT "VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/lvp_icd.json"
    RUN_SERIAL TRUE
    SKIP_RETURN_CODE 77
    TIMEOUT 900
    LABELS "gate;vulkan;renderer;neural")
