# GPU skinning in the GPU scene (docs/unification/RENDERER-EXECUTION.md P4 "Motion vectors", skinned).
#
#   fuse_skinning_gpu       STATIC  SkinningGpu ("skin.lbs": LBS of every skinned instance, current + previous pose,
#                                   into GPU-scene float streams read through per-instance GpuMesh rows)
#                                   (include/fuse/renderer/skinning/skinning_gpu*.hpp, src/skinning/skinning_gpu.cpp)
#   skin_lbs                SPIR-V  Slang (primary) + GLSL twin, embedded in fuse_skinning_gpu
#   fuse_rp_skinning_vk_*   ctest   parity (GPU == animation::skinning_lbs bit for bit, validation + sync validation),
#                                   zero_alloc, bench (1000 skinned characters, reported on the RTX 3090)

set(_fuse_skin_kernels "LBS|Lbs|skin_lbs.comp|skin_lbs.slang")

# Script mode (build step): embed the kernels' SPIR-V into a C++ header.
if(CMAKE_SCRIPT_MODE_FILE)
    cmake_policy(SET CMP0007 NEW)
    set(_text "// Generated by Source/FUSE/Renderer/cmake/rp_skinning.cmake from shaders/skinning/*. Do not edit.\n")
    string(APPEND _text "#pragma once\n#include <cstdint>\n")
    foreach(_lang SLANG GLSL)
        if(_lang STREQUAL "SLANG")
            set(_suffix Slang)
        else()
            set(_suffix Glsl)
        endif()
        set(_complete TRUE)
        foreach(_row IN LISTS _fuse_skin_kernels)
            string(REPLACE "|" ";" _entry "${_row}")
            list(GET _entry 0 _key)
            if(NOT ${_key}_${_lang} OR NOT EXISTS "${${_key}_${_lang}}")
                set(_complete FALSE)
            endif()
        endforeach()
        if(_complete)
            string(APPEND _text "#define FUSE_SKINNING_${_lang} 1\n")
            foreach(_row IN LISTS _fuse_skin_kernels)
                string(REPLACE "|" ";" _entry "${_row}")
                list(GET _entry 0 _key)
                list(GET _entry 1 _stem)
                file(READ "${${_key}_${_lang}}" _hex HEX)
                string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1u," _words "${_hex}")
                string(APPEND _text "alignas(4) static const std::uint32_t kSkin${_stem}${_suffix}Spv[] = {${_words}};\n")
            endforeach()
        endif()
    endforeach()
    file(WRITE "${OUT}" "${_text}")
    return()
endif()

get_filename_component(_fuse_skin_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(_fuse_skin_inc "${_fuse_skin_root}/include/fuse/renderer/skinning")
set(_fuse_skin_shd "${_fuse_skin_root}/shaders/skinning")

file(GLOB _fuse_skin_shader_files CONFIGURE_DEPENDS "${_fuse_skin_shd}/*")
add_library(fuse_skinning_gpu STATIC
    ${_fuse_skin_root}/src/skinning/skinning_gpu.cpp
    ${_fuse_skin_inc}/skinning_gpu.hpp
    ${_fuse_skin_inc}/skinning_gpu_types.hpp
    ${_fuse_skin_shader_files}
)
set_source_files_properties(${_fuse_skin_shader_files} PROPERTIES HEADER_FILE_ONLY TRUE)
target_link_libraries(fuse_skinning_gpu PUBLIC fuse_gpu_scene)
fuse_apply_cxx23(fuse_skinning_gpu)

set(_fuse_skin_gen "${CMAKE_CURRENT_BINARY_DIR}/skinning_gen")
set(_fuse_skin_spv "${CMAKE_CURRENT_BINARY_DIR}/shaders/skinning")
file(MAKE_DIRECTORY "${_fuse_skin_gen}" "${_fuse_skin_spv}")
set(_fuse_skin_header "${_fuse_skin_gen}/skinning_spv.h")
add_custom_target(fuse_skinning_kernels)
set(_fuse_skin_embed_args "")
set(_fuse_skin_embed_deps "")
foreach(_row IN LISTS _fuse_skin_kernels)
    string(REPLACE "|" ";" _entry "${_row}")
    list(GET _entry 0 _key)
    list(GET _entry 2 _glsl)
    list(GET _entry 3 _slang)
    string(TOLOWER "${_key}" _suffix)
    if(COMMAND fuse_add_slang_shaders)
        fuse_add_slang_shaders(fuse_skinning_kernels
            SOURCES "${_fuse_skin_shd}/${_slang}"
            STAGE compute
            SUFFIX ".skin_${_suffix}"
            FLAGS -fp-mode precise
            OUTPUT_DIR "${_fuse_skin_spv}"
            OUTPUT_VAR _fuse_skin_out)
        if(_fuse_skin_out)
            list(APPEND _fuse_skin_embed_args "-D${_key}_SLANG=${_fuse_skin_out}")
            list(APPEND _fuse_skin_embed_deps "${_fuse_skin_out}")
        endif()
    endif()
    if(FUSE_GLSLANG_VALIDATOR)
        set(_out "${_fuse_skin_spv}/skin_${_suffix}.glsl.spv")
        set(_cmds COMMAND "${FUSE_GLSLANG_VALIDATOR}" --target-env vulkan1.3 "${_fuse_skin_shd}/${_glsl}" -o "${_out}")
        if(FUSE_SPIRV_VAL)
            list(APPEND _cmds COMMAND "${FUSE_SPIRV_VAL}" --target-env vulkan1.3 "${_out}")
        endif()
        add_custom_command(OUTPUT "${_out}" ${_cmds}
            DEPENDS "${_fuse_skin_shd}/${_glsl}" "${_fuse_skin_root}/shaders/common/exact_math.glsl"
            COMMENT "glslangValidator ${_glsl} (skin_${_suffix}, GLSL twin)"
            VERBATIM)
        list(APPEND _fuse_skin_embed_args "-D${_key}_GLSL=${_out}")
        list(APPEND _fuse_skin_embed_deps "${_out}")
    endif()
endforeach()
add_custom_command(OUTPUT "${_fuse_skin_header}"
    COMMAND "${CMAKE_COMMAND}" "-DOUT=${_fuse_skin_header}" ${_fuse_skin_embed_args} -P "${CMAKE_CURRENT_LIST_FILE}"
    DEPENDS ${_fuse_skin_embed_deps} "${CMAKE_CURRENT_LIST_FILE}"
    COMMENT "Embedding the skinning kernels' SPIR-V"
    VERBATIM)
add_custom_target(fuse_skinning_header DEPENDS "${_fuse_skin_header}")
add_dependencies(fuse_skinning_header fuse_skinning_kernels)
add_dependencies(fuse_skinning_gpu fuse_skinning_header)
target_include_directories(fuse_skinning_gpu PRIVATE "${_fuse_skin_gen}")

if(NOT FUSE_BUILD_CORE_TESTS)
    return()
endif()

add_executable(fuse_rp_skinning ${_fuse_skin_root}/tests/test_rp_skinning.cpp)
target_link_libraries(fuse_rp_skinning PRIVATE fuse_skinning_gpu fuse_animation)
fuse_apply_cxx23(fuse_rp_skinning)

set(_fuse_skin_lock "${FUSE_VULKAN_TEST_LAUNCHER}")
set(_fuse_skin_tests "")
foreach(_mode parity zero_alloc bench)
    set(_name "fuse_rp_skinning_vk_${_mode}")
    if(FUSE_VULKAN_BACKEND)
        add_test(NAME ${_name} COMMAND ${_fuse_skin_lock} "$<TARGET_FILE:fuse_rp_skinning>" --mode ${_mode})
    else()
        add_test(NAME ${_name} COMMAND fuse_rp_skinning --mode ${_mode})
    endif()
    list(APPEND _fuse_skin_tests ${_name})
endforeach()
set_tests_properties(${_fuse_skin_tests} PROPERTIES
    ENVIRONMENT "${FUSE_VULKAN_LVP_ENV}"
    RUN_SERIAL TRUE
    SKIP_RETURN_CODE 77
    TIMEOUT 900
    LABELS "gate;vulkan;renderer;skinning")
set_tests_properties(fuse_rp_skinning_vk_bench PROPERTIES LABELS "gate;vulkan;renderer;skinning;bench")
