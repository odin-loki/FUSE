# WP-5.3 (docs/unification/RENDERER-EXECUTION.md): cluster streaming and residency.
# Owned by WP-5.3; other packages must not edit this file. Included after rp_wp52.cmake (needs
# fuse_geometry_dag) and rp_core_logic.cmake (fuse_core_logic, FUSE_CBMC_EXECUTABLE, FUSE_CORE_LOGIC_SAN_OK).
#
#   fuse_geometry_streaming  STATIC  cluster page file (layout, FCPG format), single-source cut + feedback
#                                    kernel "geometry_stream_cut", ClusterStreamer (CPU residency driver),
#                                    GeometryStreaming (RG v2 passes, page uploads, feedback read-back)
#   stream_cut kernel        SPIR-V  Slang (primary) + GLSL twin, embedded in fuse_geometry_streaming
#   core_logic/residency             ClusterPageResidency (page-DAG residency LRU): header-only, CBMC dialect;
#                                    property tests, lint, BMC harness (native + CBMC), ASan/UBSan build
#   fuse_rp_geometry_streaming_*     CPU gates (stub-safe) and Lavapipe gates (validation + sync validation)

# Script mode (build step): embed the kernel's SPIR-V into a C++ header.
#   cmake -DOUT=<header> [-DCUT_SLANG=<spv>] [-DCUT_GLSL=<spv>] -P rp_wp53.cmake
if(CMAKE_SCRIPT_MODE_FILE)
    set(_text "// Generated by Source/FUSE/Renderer/cmake/rp_wp53.cmake from src/geometry_streaming/shaders/*. Do not edit.\n")
    string(APPEND _text "#pragma once\n#include <cstdint>\n")
    foreach(_lang SLANG GLSL)
        if(_lang STREQUAL "SLANG")
            set(_suffix Slang)
        else()
            set(_suffix Glsl)
        endif()
        if(CUT_${_lang} AND EXISTS "${CUT_${_lang}}")
            string(APPEND _text "#define FUSE_STREAM_${_lang} 1\n")
            file(READ "${CUT_${_lang}}" _hex HEX)
            string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1u," _words "${_hex}")
            string(APPEND _text "alignas(4) static const std::uint32_t kStreamCut${_suffix}Spv[] = {${_words}};\n")
        endif()
    endforeach()
    file(WRITE "${OUT}" "${_text}")
    return()
endif()

get_filename_component(_fuse_wp53_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(_fuse_wp53_inc "${_fuse_wp53_root}/include/fuse/renderer/geometry_streaming")
set(_fuse_wp53_src "${_fuse_wp53_root}/src/geometry_streaming")
set(_fuse_wp53_shd "${_fuse_wp53_src}/shaders")
set(_fuse_wp53_common_inc "${_fuse_wp53_root}/shaders/common")
set(_fuse_wp53_cl "${_fuse_wp53_root}/core_logic")
set(_fuse_wp53_cl_res "${_fuse_wp53_cl}/residency")
set(_fuse_wp53_tests_dir "${_fuse_wp53_root}/tests")

set(_fuse_wp53_warn "")
if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang|AppleClang")
    set(_fuse_wp53_warn -Wall -Wextra -Werror)
endif()

add_library(fuse_geometry_streaming STATIC
    ${_fuse_wp53_src}/cluster_page_file.cpp
    ${_fuse_wp53_src}/cluster_streamer.cpp
    ${_fuse_wp53_src}/geometry_streaming.cpp
    ${_fuse_wp53_inc}/cluster_page_types.hpp
    ${_fuse_wp53_inc}/cluster_page_file.hpp
    ${_fuse_wp53_inc}/stream_cut_kernel.hpp
    ${_fuse_wp53_inc}/cluster_streamer.hpp
    ${_fuse_wp53_inc}/geometry_streaming.hpp
    ${_fuse_wp53_cl_res}/include/fuse/core_logic/cluster_page_residency.hpp
    ${_fuse_wp53_shd}/stream_cut.comp
    ${_fuse_wp53_shd}/stream_cut.slang
)
set_source_files_properties(${_fuse_wp53_shd}/stream_cut.comp ${_fuse_wp53_shd}/stream_cut.slang PROPERTIES HEADER_FILE_ONLY TRUE)
target_include_directories(fuse_geometry_streaming PUBLIC "${_fuse_wp53_cl_res}/include")
target_link_libraries(fuse_geometry_streaming PUBLIC fuse_geometry_dag fuse_rhi fuse_core_logic)
fuse_apply_cxx23(fuse_geometry_streaming)
target_compile_options(fuse_geometry_streaming PRIVATE ${_fuse_wp53_warn})
# The CPU reference must round like the kernel (no multiply-add contraction).
if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
    target_compile_options(fuse_geometry_streaming PUBLIC -ffp-contract=off)
endif()

# Kernel, embedded into the library. Slang is the primary source (execution doc §8 decision 1a); the GLSL
# twin keeps streaming available where slangc is not (FUSE_SLANG=AUTO), and the gates run both.
set(_fuse_wp53_gen "${CMAKE_CURRENT_BINARY_DIR}/geometry_streaming_gen")
set(_fuse_wp53_spv "${CMAKE_CURRENT_BINARY_DIR}/shaders/geometry_streaming")
file(MAKE_DIRECTORY "${_fuse_wp53_gen}" "${_fuse_wp53_spv}")
set(_fuse_wp53_header "${_fuse_wp53_gen}/stream_spv.h")
add_custom_target(fuse_geometry_streaming_kernels)
set(_fuse_wp53_embed_args "")
set(_fuse_wp53_embed_deps "")
if(COMMAND fuse_add_slang_shaders)
    fuse_add_slang_shaders(fuse_geometry_streaming_kernels
        SOURCES "${_fuse_wp53_shd}/stream_cut.slang"
        STAGE compute
        SUFFIX ".stream_cut"
        # 39001: the bindless arrays alias one binding on purpose.
        FLAGS -warnings-disable 39001 -fp-mode precise
        OUTPUT_DIR "${_fuse_wp53_spv}"
        OUTPUT_VAR _fuse_wp53_out)
    if(_fuse_wp53_out)
        list(APPEND _fuse_wp53_embed_args "-DCUT_SLANG=${_fuse_wp53_out}")
        list(APPEND _fuse_wp53_embed_deps "${_fuse_wp53_out}")
    endif()
endif()
if(FUSE_GLSLANG_VALIDATOR)
    set(_out "${_fuse_wp53_spv}/stream_cut.glsl.spv")
    set(_cmds COMMAND "${FUSE_GLSLANG_VALIDATOR}" --target-env vulkan1.3 "-I${_fuse_wp53_common_inc}"
                      "${_fuse_wp53_shd}/stream_cut.comp" -o "${_out}")
    if(FUSE_SPIRV_VAL)
        list(APPEND _cmds COMMAND "${FUSE_SPIRV_VAL}" --target-env vulkan1.3 "${_out}")
    endif()
    add_custom_command(OUTPUT "${_out}" ${_cmds}
        DEPENDS "${_fuse_wp53_shd}/stream_cut.comp" "${_fuse_wp53_common_inc}/bindless.glsl"
        COMMENT "glslangValidator stream_cut.comp (GLSL twin)"
        VERBATIM)
    list(APPEND _fuse_wp53_embed_args "-DCUT_GLSL=${_out}")
    list(APPEND _fuse_wp53_embed_deps "${_out}")
endif()
add_custom_command(OUTPUT "${_fuse_wp53_header}"
    COMMAND "${CMAKE_COMMAND}" "-DOUT=${_fuse_wp53_header}" ${_fuse_wp53_embed_args} -P "${CMAKE_CURRENT_LIST_FILE}"
    DEPENDS ${_fuse_wp53_embed_deps} "${CMAKE_CURRENT_LIST_FILE}"
    COMMENT "Embedding the geometry streaming kernel's SPIR-V"
    VERBATIM)
add_custom_target(fuse_geometry_streaming_header DEPENDS "${_fuse_wp53_header}")
add_dependencies(fuse_geometry_streaming_header fuse_geometry_streaming_kernels)
add_dependencies(fuse_geometry_streaming fuse_geometry_streaming_header)
target_include_directories(fuse_geometry_streaming PRIVATE "${_fuse_wp53_gen}")

