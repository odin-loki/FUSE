# tests/CMakeLists.txt writes the ICD lock wrapper; its variable is scoped to that directory.
set(_fuse_wp53_lock "${CMAKE_CURRENT_BINARY_DIR}/tests/run_vulkan_icd_locked.sh")
set(_fuse_wp53_vk_tests "")
foreach(_case "parity;set" "parity;buffer" "zero_alloc;set")
    list(GET _case 0 _mode)
    list(GET _case 1 _backend)
    set(_name "fuse_rp_geometry_streaming_vk_${_mode}_${_backend}")
    if(FUSE_VULKAN_BACKEND)
        add_test(NAME ${_name} COMMAND "${_fuse_wp53_lock}" "$<TARGET_FILE:fuse_rp_geometry_streaming>" --mode ${_mode} --backend ${_backend})
    else()
        add_test(NAME ${_name} COMMAND fuse_rp_geometry_streaming --mode ${_mode} --backend ${_backend})
    endif()
    list(APPEND _fuse_wp53_vk_tests ${_name})
endforeach()
