#version 450
// FUSE UI GPU backend (fuse_ui_vk, plan §4.9 / UI4): "ui.draw_list" — rasterises a packed DrawList (GpuDrawData,
// include/fuse/ui/render/gpu_draw_data.hpp) into an RGBA8 storage image, blending over what is there.
// The specification is fuse::ui::CpuRasterizer (Core/src/draw_list.cpp): same per-pixel arithmetic, same operation
// order, 8-bit quantisation after every blend; gated with fuse_ui_vk_parity (max channel error and FLIP-style mean).
// Commands are binned into 16x16 tiles on the CPU (each tile lists the commands that touch it, in draw order); the
// rounded clip of each command is resolved on the CPU into the command (clip rect + radius), so there is no clip stack.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

struct GpuCmd {
    vec4 rect;   // x, y, w, h (Line: x0, y0, x1, y1)
    vec4 fill;   // straight RGBA
    vec4 fill2;  // gradient end
    vec4 border; // straight RGBA
    vec4 radius; // tl, tr, br, bl
    vec4 clip;   // clip rect (x, y, w, h), already intersected with the scissor
    vec4 params; // borderWidth, blur, clipRadius, 0
    uvec4 info;  // op | gradient << 8, u | v << 16, tw | th << 16, image
};

layout(set = 0, binding = 0, rgba8) uniform image2D ui_target;
layout(set = 0, binding = 1, std430) readonly buffer UiCmds { GpuCmd cmds[]; } ui_cmds;
layout(set = 0, binding = 2, std430) readonly buffer UiTiles { uint data[]; } ui_tiles; // offsets[tiles + 1], then ids
layout(set = 0, binding = 3, std430) readonly buffer UiAtlas { uint words[]; } ui_atlas;
layout(set = 0, binding = 4, std430) readonly buffer UiImages { uint data[]; } ui_images; // per image: off, w, h, ext
// External textures (UiVkRenderer::setExternalImage): GPU images drawn by kImage commands whose image entry has
// ext = slot + 1 (fuse::ui::Image::externalSlot), e.g. the engine's 3D viewport frame without a CPU copy. Separate
// bindings (no descriptor-indexing feature); unbound slots hold a 1x1 dummy.
layout(set = 0, binding = 5) uniform sampler2D ui_ext0;
layout(set = 0, binding = 6) uniform sampler2D ui_ext1;
layout(set = 0, binding = 7) uniform sampler2D ui_ext2;
layout(set = 0, binding = 8) uniform sampler2D ui_ext3;
// Backdrop scratch: two halves of equal size (ping-pong between the box passes), vec4 per pixel of the source region.
layout(set = 0, binding = 9, std430) buffer UiScratch { vec4 v[]; } ui_scratch;

layout(push_constant) uniform UiPush {
    uvec2 extent;
    uint tilesX;
    uint atlasSize;
    uint tileCount;
    uint imageCount;
    uint tileBase;   // word offset of the segment's tile block
    uint tileOrigin; // first tile of the dispatch, x | y << 16
    uint mode;       // 0 tiles, 1 / 2 backdrop box pass (horizontal / vertical), 3 backdrop composite
    uint cmd;        // backdrop command
    uint src;        // box pass source: 0 target, 1 + n scratch half n
    uint dst;        // scratch half written (box pass) / read (composite)
} pc;

const uint kRect = 0u, kShadow = 1u, kGlyph = 2u, kImage = 3u, kLine = 4u;
const uint kModeTiles = 0u, kModeBoxH = 1u, kModeBoxV = 2u, kModeComposite = 3u;

// The CPU reference uses IEEE single precision with correctly rounded division and sqrt. Vulkan only guarantees
// that for add / sub / mul (OpFDiv is 2.5 ulp, sqrt inherits inversesqrt), and real GPUs use the slack: an image
// texel index computed as floor(k / h * n) flips at exact integers. divRn / sqrtRn round the hardware result to the
// IEEE one with an exact residual (Dekker product; needs only correctly rounded mul / add and no contraction).
float resid(float a, float q, float b) { // a - q * b, accurate enough to compare neighbours
    precise float p = q * b;
    precise float cq = 4097.0 * q;
    precise float qh = cq - (cq - q);
    precise float ql = q - qh;
    precise float cb = 4097.0 * b;
    precise float bh = cb - (cb - b);
    precise float bl = b - bh;
    precise float e = ((qh * bh - p) + qh * bl + ql * bh) + ql * bl;
    precise float r = (a - p) - e;
    return r;
}
float nextToward(float q, bool up) { // q != 0; up: toward +inf
    const uint bits = floatBitsToUint(q);
    return uintBitsToFloat((q > 0.0) == up ? bits + 1u : bits - 1u);
}
float roundRn(float a, float q, float b, bool root) { // walk q to the nearest representable a / b (root: sqrt(a), b = q)
    float r = resid(a, q, root ? q : b);
    for (int i = 0; i < 4 && r != 0.0; ++i) {
        const float qn = nextToward(q, root ? r > 0.0 : (r > 0.0) == (b > 0.0));
        const float rn = resid(a, qn, root ? qn : b);
        if (abs(rn) < abs(r) || (abs(rn) == abs(r) && (floatBitsToUint(q) & 1u) != 0u)) {
            q = qn;
            r = rn;
        } else {
            break;
        }
    }
    return q;
}
float divRn(float a, float b) {
    precise float q = a / b;
    if (q == 0.0 || isinf(q) || isnan(q)) return q;
    return roundRn(a, q, b, false);
}
float sqrtRn(float x) {
    precise float s = sqrt(x);
    if (!(x > 0.0) || isinf(x)) return s;
    return roundRn(x, s, s, true);
}

float sdRoundRect(float px, float py, vec4 r, vec4 rad) {
    precise float cx = r.x + r.z * 0.5;
    precise float cy = r.y + r.w * 0.5;
    precise float hx = r.z * 0.5;
    precise float hy = r.w * 0.5;
    precise float dx = px - cx;
    precise float dy = py - cy;
    float rr = dx < 0.0 ? (dy < 0.0 ? rad.x : rad.w) : (dy < 0.0 ? rad.y : rad.z);
    rr = min(rr, min(hx, hy));
    precise float qx = abs(dx) - hx + rr;
    precise float qy = abs(dy) - hy + rr;
    precise float ox = max(qx, 0.0);
    precise float oy = max(qy, 0.0);
    precise float l2 = ox * ox + oy * oy;
    return sqrtRn(l2) + min(max(qx, qy), 0.0) - rr;
}

uint q8(float v) {
    precise float t = clamp(v, 0.0, 1.0) * 255.0 + 0.5;
    return uint(floor(t));
}

shared float ui_inv255[256]; // k / 255, correctly rounded (the CPU's f32(k) / 255.f)

void blend(inout uvec4 dst, vec4 s) {
    if (s.a <= 0.0 && s.r <= 0.0 && s.g <= 0.0 && s.b <= 0.0) return;
    precise float inv = 1.0 - s.a;
    const vec4 d = vec4(ui_inv255[dst.r], ui_inv255[dst.g], ui_inv255[dst.b], ui_inv255[dst.a]);
    precise vec4 o = s + d * inv;
    dst = uvec4(q8(o.r), q8(o.g), q8(o.b), q8(o.a));
}

vec4 premul(vec4 c, float cov) {
    precise float a = clamp(c.a, 0.0, 1.0) * cov;
    return vec4(c.r * a, c.g * a, c.b * a, a);
}

ivec2 extSize(uint e) {
    if (e == 0u) return textureSize(ui_ext0, 0);
    if (e == 1u) return textureSize(ui_ext1, 0);
    if (e == 2u) return textureSize(ui_ext2, 0);
    return textureSize(ui_ext3, 0);
}
vec4 extFetch(uint e, ivec2 q) {
    if (e == 0u) return texelFetch(ui_ext0, q, 0);
    if (e == 1u) return texelFetch(ui_ext1, q, 0);
    if (e == 2u) return texelFetch(ui_ext2, q, 0);
    return texelFetch(ui_ext3, q, 0);
}

uint atlasByte(uint idx) { return (ui_atlas.words[idx >> 2] >> ((idx & 3u) * 8u)) & 0xFFu; }

uvec4 loadTarget(ivec2 ip) { return uvec4(floor(imageLoad(ui_target, ip) * 255.0 + 0.5)); }

// Backdrop blur, the GPU version of CpuRasterizer's backdropBlur (Core/src/draw_list.cpp), with the same float
// operation order: box sums over the source region (edge-clamped), 3 x (horizontal, vertical), then the composite
// mixes the blur in by coverage and blends the tint.
struct Backdrop {
    int x0, y0, x1, y1; // composited pixel area
    int sx0, sy0, w, h; // source region
    int r;
};
Backdrop backdropOf(GpuCmd c) {
    Backdrop b;
    b.x0 = int(c.info.y & 0xFFFFu);
    b.y0 = int(c.info.y >> 16);
    b.x1 = int(c.info.z & 0xFFFFu);
    b.y1 = int(c.info.z >> 16);
    b.r = int(c.info.w);
    const int m = 3 * b.r;
    b.sx0 = max(0, b.x0 - m);
    b.sy0 = max(0, b.y0 - m);
    b.w = min(int(pc.extent.x), b.x1 + m) - b.sx0;
    b.h = min(int(pc.extent.y), b.y1 + m) - b.sy0;
    return b;
}
uint scratchHalf() { return uint(ui_scratch.v.length()) / 2u; }

vec4 boxAt(Backdrop b, bool vertical, int line, int i, int n) {
    i = clamp(i, 0, n - 1);
    const int x = vertical ? line : i, y = vertical ? i : line;
    if (pc.src == 0u) return vec4(loadTarget(ivec2(b.sx0 + x, b.sy0 + y)));
    return ui_scratch.v[(pc.src - 1u) * scratchHalf() + uint(y * b.w + x)];
}

// One invocation per output pixel: the window sum in the reference's fixed order (left to right / top to bottom).
void boxPass(bool vertical) {
    const GpuCmd c = ui_cmds.cmds[pc.cmd];
    const Backdrop b = backdropOf(c);
    const ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    if (q.x >= b.w || q.y >= b.h) return;
    const int line = vertical ? q.x : q.y, i = vertical ? q.y : q.x, n = vertical ? b.h : b.w;
    precise vec4 acc = vec4(0.0);
    for (int j = -b.r; j <= b.r; ++j) acc += boxAt(b, vertical, line, i + j, n);
    precise vec4 o = acc * divRn(1.0, float(2 * b.r + 1));
    ui_scratch.v[pc.dst * scratchHalf() + uint(q.y * b.w + q.x)] = o;
}

float lroundPos(float v) { // std::lround for the composite (halves away from zero; v >= -0.5)
    const float f = floor(v);
    precise float frac = v - f;
    return frac >= 0.5 ? f + 1.0 : f;
}

void backdropComposite() {
    const GpuCmd c = ui_cmds.cmds[pc.cmd];
    const Backdrop b = backdropOf(c);
    const ivec2 ip = ivec2(gl_GlobalInvocationID.xy) + ivec2(b.x0, b.y0);
    if (ip.x >= b.x1 || ip.y >= b.y1) return;
    const float px = float(ip.x) + 0.5, py = float(ip.y) + 0.5;
    precise float cov = clamp(0.5 - sdRoundRect(px, py, c.rect, c.radius), 0.0, 1.0);
    if (c.params.z > 0.0) cov *= clamp(0.5 - sdRoundRect(px, py, c.clip, vec4(c.params.z)), 0.0, 1.0);
    if (cov <= 0.0) return;
    const vec4 dv = vec4(loadTarget(ip));
    // src == ~0: the region did not fit the scratch, tint only
    const vec4 bl = pc.src == 0xFFFFFFFFu ? dv : ui_scratch.v[pc.dst * scratchHalf() + uint((ip.y - b.sy0) * b.w + (ip.x - b.sx0))];
    precise vec4 t = dv + (bl - dv) * cov;
    uvec4 dst = uvec4(clamp(vec4(lroundPos(t.r), lroundPos(t.g), lroundPos(t.b), lroundPos(t.a)), 0.0, 255.0));
    if (c.fill.a > 0.0) blend(dst, premul(c.fill, cov));
    imageStore(ui_target, ip, vec4(dst) / 255.0);
}

void main() {
    ui_inv255[gl_LocalInvocationIndex] = divRn(float(gl_LocalInvocationIndex), 255.0);
    barrier();
    if (pc.mode == kModeBoxH || pc.mode == kModeBoxV) {
        boxPass(pc.mode == kModeBoxV);
        return;
    }
    if (pc.mode == kModeComposite) {
        backdropComposite();
        return;
    }
    const uvec2 p = gl_GlobalInvocationID.xy + uvec2(pc.tileOrigin & 0xFFFFu, pc.tileOrigin >> 16) * 16u;
    if (p.x >= pc.extent.x || p.y >= pc.extent.y) return;
    const uint tile = (p.y / 16u) * pc.tilesX + (p.x / 16u);
    const uint begin = ui_tiles.data[pc.tileBase + tile];
    const uint end = ui_tiles.data[pc.tileBase + tile + 1u];
    if (begin == end) return; // nothing here: leave the pixel as it is
    const ivec2 ip = ivec2(p);
    uvec4 dst = loadTarget(ip);
    const float px = float(p.x) + 0.5, py = float(p.y) + 0.5;
    for (uint k = begin; k < end; ++k) {
        const GpuCmd c = ui_cmds.cmds[ui_tiles.data[pc.tileBase + pc.tileCount + 1u + k]];
        const uint op = c.info.x & 0xFFu;
        const uint gradient = (c.info.x >> 8) & 0xFFu;
        // pixel must lie in the command's clipped pixel area (same integer bounds as the CPU loop)
        vec4 b = c.rect;
        if (op == kShadow) b = vec4(c.rect.x - c.params.y * 2.0, c.rect.y - c.params.y * 2.0, c.rect.z + c.params.y * 4.0, c.rect.w + c.params.y * 4.0);
        if (op == kLine) {
            precise float hw = c.params.x * 0.5 + 1.0;
            b = vec4(min(c.rect.x, c.rect.z) - hw, min(c.rect.y, c.rect.w) - hw, abs(c.rect.z - c.rect.x) + 2.0 * hw, abs(c.rect.w - c.rect.y) + 2.0 * hw);
        }
        precise float ax0 = max(b.x, c.clip.x);
        precise float ay0 = max(b.y, c.clip.y);
        precise float ax1 = min(b.x + b.z, c.clip.x + c.clip.z);
        precise float ay1 = min(b.y + b.w, c.clip.y + c.clip.w);
        if (ax1 <= ax0 || ay1 <= ay0) continue;
        if (int(p.x) < int(floor(ax0)) || int(p.x) >= int(ceil(ax1)) || int(p.y) < int(floor(ay0)) || int(p.y) >= int(ceil(ay1))) continue;
        float clipCov = 1.0;
        if (c.params.z > 0.0) clipCov = clamp(0.5 - sdRoundRect(px, py, c.clip, vec4(c.params.z)), 0.0, 1.0);
        if (clipCov <= 0.0) continue;
        if (op == kRect) {
            const float d = sdRoundRect(px, py, c.rect, c.radius);
            precise float outer = clamp(0.5 - d, 0.0, 1.0) * clipCov;
            if (outer <= 0.0) continue;
            vec4 fill = c.fill;
            if (gradient != 0u) {
                float t = gradient == 1u ? clamp(divRn(py - c.rect.y, max(c.rect.w, 1.0)), 0.0, 1.0)
                                         : clamp(divRn(px - c.rect.x, max(c.rect.z, 1.0)), 0.0, 1.0);
                precise vec4 f = fill + (c.fill2 - fill) * t;
                fill = f;
            }
            if (c.params.x > 0.0 && c.border.a > 0.0) {
                precise float inner = clamp(0.5 - (d + c.params.x), 0.0, 1.0) * clipCov;
                const vec4 pf = premul(fill, inner);
                const vec4 pb = premul(c.border, outer - inner);
                blend(dst, pf + pb);
            } else {
                blend(dst, premul(fill, outer));
            }
        } else if (op == kShadow) {
            const float d = sdRoundRect(px, py, c.rect, c.radius);
            const float bl = max(c.params.y, 0.5);
            precise float t = clamp(divRn(d + bl, 2.0 * bl), 0.0, 1.0);
            precise float cov = (1.0 - t * t * (3.0 - 2.0 * t)) * clipCov;
            blend(dst, premul(c.fill, cov));
        } else if (op == kGlyph) {
            const int gx = int(p.x) - int(c.rect.x), gy = int(p.y) - int(c.rect.y);
            const int tw = int(c.info.z & 0xFFFFu), th = int(c.info.z >> 16);
            if (gx < 0 || gy < 0 || gx >= tw || gy >= th || pc.atlasSize == 0u) continue;
            const uint u = c.info.y & 0xFFFFu, v = c.info.y >> 16;
            const uint a = atlasByte((v + uint(gy)) * pc.atlasSize + u + uint(gx));
            if (a != 0u) blend(dst, premul(c.fill, ui_inv255[a] * clipCov));
        } else if (op == kImage) {
            const uint img = c.info.w;
            if (img >= pc.imageCount) continue;
            const uint ext = ui_images.data[img * 4u + 3u];
            if (ext != 0u) {
                // straight RGBA texture, nearest-scaled over the rect (same mapping as the CPU image path)
                const ivec2 es = max(extSize(ext - 1u), ivec2(1));
                const int ex = clamp(int(divRn(px - c.rect.x, c.rect.z) * float(es.x)), 0, es.x - 1);
                const int ey = clamp(int(divRn(py - c.rect.y, c.rect.w) * float(es.y)), 0, es.y - 1);
                const vec4 t = clamp(extFetch(ext - 1u, ivec2(ex, ey)), 0.0, 1.0);
                const float ek = clipCov * (c.fill.a > 0.0 ? c.fill.a : 1.0);
                blend(dst, vec4(t.rgb * t.a * ek, t.a * ek));
                continue;
            }
            const uint off = ui_images.data[img * 4u], w = ui_images.data[img * 4u + 1u], h = ui_images.data[img * 4u + 2u];
            const int sx = clamp(int(divRn(px - c.rect.x, c.rect.z) * float(w)), 0, int(w) - 1);
            const int sy = clamp(int(divRn(py - c.rect.y, c.rect.w) * float(h)), 0, int(h) - 1);
            const uint s = ui_images.data[off + uint(sy) * w + uint(sx)];
            const float kk = clipCov * (c.fill.a > 0.0 ? c.fill.a : 1.0);
            blend(dst, vec4(ui_inv255[s & 0xFFu] * kk, ui_inv255[(s >> 8) & 0xFFu] * kk,
                            ui_inv255[(s >> 16) & 0xFFu] * kk, ui_inv255[s >> 24] * kk));
        } else if (op == kLine) {
            precise float vx = c.rect.z - c.rect.x;
            precise float vy = c.rect.w - c.rect.y;
            precise float len2 = max(vx * vx + vy * vy, 1e-6);
            precise float t = clamp(divRn((px - c.rect.x) * vx + (py - c.rect.y) * vy, len2), 0.0, 1.0);
            precise float ex = px - (c.rect.x + vx * t);
            precise float ey = py - (c.rect.y + vy * t);
            precise float d = sqrtRn(ex * ex + ey * ey) - c.params.x * 0.5;
            precise float cov = clamp(0.5 - d, 0.0, 1.0) * clipCov;
            if (cov > 0.0) blend(dst, premul(c.fill, cov));
        }
    }
    imageStore(ui_target, ip, vec4(dst) / 255.0);
}
