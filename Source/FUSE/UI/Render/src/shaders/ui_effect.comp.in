#version 450
#extension GL_GOOGLE_include_directive : require
// FUSE UI custom effect pipeline (Core/include/fuse/ui/effects.hpp), generated by fuse_ui_add_effect: this template
// with the effect snippet spliced in at the marker below. Runs between draw-list segments of "ui.draw_list" with the
// kernel's descriptor set and push constants (pc.cmd = the Effect command): one invocation per pixel of the command's
// pixel area; fx_main returns the premultiplied 0..255 result, mixed in by the rounded-rect / clip coverage exactly
// as CpuRasterizer's effectPass does. Before it, the kernel copied the source region (area + margin) to scratch half 0.
//
// Snippet API:
//   vec4 fx_main(ivec2 p)          the effect: premultiplied RGBA 0..255 for target pixel p (required)
//   vec4 fx_src(ivec2 p)           target texel before the effect (0..255), clamped to the source region
//   float fx_param(int i)          parameter i (0..7);  float fx_time;  vec4 fx_rect (x, y, w, h)
//   ivec2 fx_imageSize(); vec4 fx_imageTexel(ivec2 t)   the optional sampled image (premultiplied 0..255)
//   divRn, sqrtRn, fx_sin, fx_cos, fx_hash, fx_hash01, sdRoundRect (ui_math.glsl): CPU-identical arithmetic
// Use `precise` on float temporaries so the compiler does not contract a * b + c into an fma.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

struct GpuCmd {
    vec4 rect;
    vec4 fill;
    vec4 fill2;
    vec4 border;
    vec4 radius;
    vec4 clip;
    vec4 params;
    uvec4 info;
};

layout(set = 0, binding = 0, rgba8) uniform image2D ui_target;
layout(set = 0, binding = 1, std430) readonly buffer UiCmds { GpuCmd cmds[]; } ui_cmds;
layout(set = 0, binding = 4, std430) readonly buffer UiImages { uint data[]; } ui_images;
layout(set = 0, binding = 5) uniform sampler2D ui_ext0;
layout(set = 0, binding = 6) uniform sampler2D ui_ext1;
layout(set = 0, binding = 7) uniform sampler2D ui_ext2;
layout(set = 0, binding = 8) uniform sampler2D ui_ext3;
layout(set = 0, binding = 9, std430) readonly buffer UiScratch { vec4 v[]; } ui_scratch;

layout(push_constant) uniform UiPush {
    uvec2 extent;
    uint tilesX;
    uint atlasSize;
    uint tileCount;
    uint imageCount;
    uint tileBase;
    uint tileOrigin;
    uint mode;
    uint cmd;
    uint src;
    uint dst;
} pc;

#include "ui_math.glsl"

GpuCmd fx_cmd;
ivec4 fx_region; // source region x, y, w, h
vec4 fx_rect;
float fx_time;

float fx_param(int i) { return i < 4 ? fx_cmd.fill[i] : fx_cmd.fill2[i - 4]; }

vec4 fx_src(ivec2 p) {
    const int x = clamp(p.x - fx_region.x, 0, fx_region.z - 1);
    const int y = clamp(p.y - fx_region.y, 0, fx_region.w - 1);
    return ui_scratch.v[y * fx_region.z + x];
}

int fx_imageIndex() {
    const float f = fx_cmd.border.x;
    return f < 0.0 || f >= float(pc.imageCount) ? -1 : int(f);
}
ivec2 fx_extSize(uint e) {
    if (e == 0u) return textureSize(ui_ext0, 0);
    if (e == 1u) return textureSize(ui_ext1, 0);
    if (e == 2u) return textureSize(ui_ext2, 0);
    return textureSize(ui_ext3, 0);
}
vec4 fx_extFetch(uint e, ivec2 q) {
    if (e == 0u) return texelFetch(ui_ext0, q, 0);
    if (e == 1u) return texelFetch(ui_ext1, q, 0);
    if (e == 2u) return texelFetch(ui_ext2, q, 0);
    return texelFetch(ui_ext3, q, 0);
}
ivec2 fx_imageSize() {
    const int i = fx_imageIndex();
    if (i < 0) return ivec2(0);
    const uint ext = ui_images.data[uint(i) * 4u + 3u];
    if (ext != 0u) return fx_extSize(ext - 1u);
    return ivec2(int(ui_images.data[uint(i) * 4u + 1u]), int(ui_images.data[uint(i) * 4u + 2u]));
}
vec4 fx_imageTexel(ivec2 t) {
    const int i = fx_imageIndex();
    if (i < 0) return vec4(0.0);
    const ivec2 sz = max(fx_imageSize(), ivec2(1));
    t = clamp(t, ivec2(0), sz - 1);
    const uint ext = ui_images.data[uint(i) * 4u + 3u];
    if (ext != 0u) { // straight RGBA texture -> premultiplied 0..255 (exact for opaque texels)
        const vec4 c = clamp(fx_extFetch(ext - 1u, t), 0.0, 1.0);
        return vec4(floor(c.rgb * c.a * 255.0 + 0.5), floor(c.a * 255.0 + 0.5));
    }
    const uint s = ui_images.data[ui_images.data[uint(i) * 4u] + uint(t.y) * uint(sz.x) + uint(t.x)];
    return vec4(float(s & 0xFFu), float((s >> 8) & 0xFFu), float((s >> 16) & 0xFFu), float(s >> 24));
}

// ---- effect snippet ----
@FUSE_UI_EFFECT_SNIPPET@
// ---- end of snippet ----

void main() {
    fx_cmd = ui_cmds.cmds[pc.cmd];
    const ivec2 a0 = ivec2(int(fx_cmd.info.y & 0xFFFFu), int(fx_cmd.info.y >> 16));
    const ivec2 a1 = ivec2(int(fx_cmd.info.z & 0xFFFFu), int(fx_cmd.info.z >> 16));
    const int m = int(fx_cmd.info.w & 0xFFFFu);
    fx_region.xy = max(ivec2(0), a0 - m);
    fx_region.zw = min(ivec2(pc.extent), a1 + m) - fx_region.xy;
    fx_rect = fx_cmd.rect;
    fx_time = fx_cmd.params.y;
    const ivec2 ip = ivec2(gl_GlobalInvocationID.xy) + a0;
    if (ip.x >= a1.x || ip.y >= a1.y) return;
    const float px = float(ip.x) + 0.5, py = float(ip.y) + 0.5;
    precise float cov = clamp(0.5 - sdRoundRect(px, py, fx_cmd.rect, fx_cmd.radius), 0.0, 1.0);
    if (fx_cmd.params.z > 0.0) cov *= clamp(0.5 - sdRoundRect(px, py, fx_cmd.clip, vec4(fx_cmd.params.z)), 0.0, 1.0);
    if (cov <= 0.0) return;
    const vec4 e = clamp(fx_main(ip), 0.0, 255.0);
    const vec4 dv = floor(imageLoad(ui_target, ip) * 255.0 + 0.5);
    precise vec4 t = dv + (e - dv) * cov;
    const vec4 o = clamp(vec4(lroundPos(t.r), lroundPos(t.g), lroundPos(t.b), lroundPos(t.a)), 0.0, 255.0);
    imageStore(ui_target, ip, o / 255.0);
}
