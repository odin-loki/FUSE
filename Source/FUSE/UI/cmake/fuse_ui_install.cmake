# Install rules for the FUSE UI libraries and the FuseUI CMake package (included at the end of the UI CMakeLists.txt
# when FUSE_UI_INSTALL is ON, the default for a standalone build).
#
#   cmake --install <build> --prefix <prefix>
#       <prefix>/lib/libfuse_*.a                 every FUSE UI static library that was built, plus the static
#                                                third-party libraries they link (Lua, SQLite, HarfBuzz, ...)
#       <prefix>/include/fuse/...                the public headers of those libraries
#       <prefix>/lib/cmake/FuseUI/FuseUIConfig.cmake (+ FuseUIConfigVersion.cmake)
#       <prefix>/share/fuse_ui/cmake/            fuse_app_add_executable and the packaging helpers
#
# An external project then does
#       find_package(FuseUI REQUIRED)            # CMAKE_PREFIX_PATH=<prefix>
#       target_link_libraries(app PRIVATE FuseUI::widgets FuseUI::doc FuseUI::app)
# The imported targets are FuseUI::<name> for every installed fuse_<name> / fuse_ui_<name> library (FuseUI::text,
# ::core, ::widgets, ::doc, ::render, ::script, ::game, ::a11y, ::sql, ::video, ::app, ::app_native, ...); each
# carries its include directory, compile definitions, C++23 and its link dependencies. FuseUI_TARGETS lists them.
#
# The package is written by hand (imported static libraries) instead of install(EXPORT): the build targets name
# their include directories by source path, which an export set refuses.
# Not relocatable in one respect: unless FUSE_TEXT_EMBED_FONT is ON, fuse_text loads the bundled Open Sans from the
# source tree's vendor/fonts (the path is compiled in). Configure with -DFUSE_TEXT_EMBED_FONT=ON for an install that
# is moved to another machine.
include(GNUInstallDirs)
include(CMakePackageConfigHelpers)

# (every library target of this directory; the ones a configuration does not build are skipped)
set(_fuse_ui_roots fuse_text fuse_ui_core fuse_ui_widgets fuse_ui_doc fuse_ui_render fuse_ui_vk fuse_ui_script fuse_ui_game
    fuse_ui_game_ecs fuse_ui_game_audio fuse_ui_l10n_lib fuse_ui_a11y fuse_ui_sql fuse_ui_video fuse_ui_designer_lib fuse_app fuse_app_native)

# Collects, depth first, every static library target reachable from `target` into _fuse_ui_install_set (dependencies
# before dependents is not needed: static archives are listed per target with their own dependencies).
function(_fuse_ui_collect target)
    get_property(_set GLOBAL PROPERTY _fuse_ui_install_set)
    if(NOT TARGET ${target} OR "${target}" IN_LIST _set)
        return()
    endif()
    get_target_property(_type ${target} TYPE)
    get_target_property(_imported ${target} IMPORTED)
    if(_imported OR NOT (_type STREQUAL "STATIC_LIBRARY" OR _type STREQUAL "INTERFACE_LIBRARY"))
        return()
    endif()
    set_property(GLOBAL APPEND PROPERTY _fuse_ui_install_set ${target})
    foreach(_prop LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
        get_target_property(_deps ${target} ${_prop})
        if(_deps)
            foreach(_d IN LISTS _deps)
                if(TARGET ${_d})
                    _fuse_ui_collect(${_d})
                endif()
            endforeach()
        endif()
    endforeach()
endfunction()

set_property(GLOBAL PROPERTY _fuse_ui_install_set "")
foreach(_t IN LISTS _fuse_ui_roots)
    _fuse_ui_collect(${_t})
endforeach()
get_property(_fuse_ui_set GLOBAL PROPERTY _fuse_ui_install_set)

# FuseUI::<short name> of a build target (fuse_ui_core -> core, fuse_text -> text, fuse_lua -> lua, harfbuzz -> harfbuzz)
function(_fuse_ui_short out target)
    string(REGEX REPLACE "^fuse_ui_" "" _s "${target}")
    string(REGEX REPLACE "^fuse_" "" _s "${_s}")
    set(${out} "${_s}" PARENT_SCOPE)
endfunction()

set(_cfg "# Generated by Source/FUSE/UI/cmake/fuse_ui_install.cmake. Do not edit.\n")
string(APPEND _cfg "get_filename_component(_fuse_ui_prefix \"\${CMAKE_CURRENT_LIST_DIR}/../../..\" ABSOLUTE)\n")
string(APPEND _cfg "set(FuseUI_INCLUDE_DIR \"\${_fuse_ui_prefix}/${CMAKE_INSTALL_INCLUDEDIR}\")\n")
string(APPEND _cfg "set(FuseUI_TEXT_PROFILE \"${FUSE_UI_TEXT}\")\n")
string(APPEND _cfg "set(FuseUI_TARGETS \"\")\n")
string(APPEND _cfg "include(CMakeFindDependencyMacro)\nset(THREADS_PREFER_PTHREAD_FLAG ON)\nfind_package(Threads QUIET)\n")
set(_header_dirs "")
foreach(_t IN LISTS _fuse_ui_set)
    _fuse_ui_short(_short ${_t})
    get_target_property(_type ${_t} TYPE)
    # link dependencies: installed targets by their imported name, anything else (system libraries, frameworks,
    # linker flags) as written; generator expressions other than plain names are dropped
    set(_links "")
    foreach(_prop LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
        get_target_property(_deps ${_t} ${_prop})
        if(_deps)
            foreach(_d IN LISTS _deps)
                if("${_d}" IN_LIST _fuse_ui_set)
                    _fuse_ui_short(_ds ${_d})
                    list(APPEND _links "FuseUI::${_ds}")
                elseif(TARGET ${_d})
                    get_target_property(_dimp ${_d} IMPORTED)
                    if(_dimp AND "${_d}" MATCHES "::")
                        list(APPEND _links "${_d}") # e.g. Threads::Threads, Vulkan::Vulkan: found again by the consumer
                    endif()
                elseif(NOT "${_d}" MATCHES "^\\$<")
                    list(APPEND _links "${_d}")
                endif()
            endforeach()
        endif()
    endforeach()
    list(REMOVE_DUPLICATES _links)
    get_target_property(_defs ${_t} INTERFACE_COMPILE_DEFINITIONS)
    if(NOT _defs)
        set(_defs "")
    endif()
    string(REPLACE "\"" "\\\"" _defs "${_defs}") # (a definition with a quoted string value)
    # public headers: the include directories of this project's own libraries
    get_target_property(_incs ${_t} INTERFACE_INCLUDE_DIRECTORIES)
    if(_incs)
        foreach(_i IN LISTS _incs)
            if("${_i}" MATCHES "^${CMAKE_CURRENT_SOURCE_DIR}/" AND IS_DIRECTORY "${_i}/fuse")
                list(APPEND _header_dirs "${_i}")
            endif()
        endforeach()
    endif()
    if(_type STREQUAL "INTERFACE_LIBRARY")
        string(APPEND _cfg "add_library(FuseUI::${_short} INTERFACE IMPORTED)\n")
    else()
        install(TARGETS ${_t} ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR})
        string(APPEND _cfg "add_library(FuseUI::${_short} STATIC IMPORTED)\n")
        string(APPEND _cfg "set_target_properties(FuseUI::${_short} PROPERTIES IMPORTED_LOCATION \"\${_fuse_ui_prefix}/${CMAKE_INSTALL_LIBDIR}/$<TARGET_FILE_NAME:${_t}>\" IMPORTED_LINK_INTERFACE_LANGUAGES \"C;CXX\")\n")
    endif()
    string(APPEND _cfg "set_target_properties(FuseUI::${_short} PROPERTIES INTERFACE_INCLUDE_DIRECTORIES \"\${FuseUI_INCLUDE_DIR}\" INTERFACE_COMPILE_FEATURES cxx_std_23 INTERFACE_COMPILE_DEFINITIONS \"${_defs}\" INTERFACE_LINK_LIBRARIES \"${_links}\")\n")
    string(APPEND _cfg "list(APPEND FuseUI_TARGETS FuseUI::${_short})\n")
endforeach()
string(APPEND _cfg "# fuse_app_add_executable / packaging helpers for apps built against the install tree\n")
string(APPEND _cfg "set(FuseUI_CMAKE_DIR \"\${_fuse_ui_prefix}/${CMAKE_INSTALL_DATADIR}/fuse_ui/cmake\")\n")
string(APPEND _cfg "set(FuseUI_FOUND TRUE)\n")

if(_header_dirs)
    list(REMOVE_DUPLICATES _header_dirs)
    foreach(_d IN LISTS _header_dirs)
        install(DIRECTORY "${_d}/fuse" DESTINATION ${CMAKE_INSTALL_INCLUDEDIR} FILES_MATCHING PATTERN "*.hpp" PATTERN "*.h")
    endforeach()
endif()
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/FuseUIConfig.cmake" CONTENT "${_cfg}")
write_basic_package_version_file("${CMAKE_CURRENT_BINARY_DIR}/FuseUIConfigVersion.cmake" VERSION 0.1.0 COMPATIBILITY SameMinorVersion)
install(FILES "${CMAKE_CURRENT_BINARY_DIR}/FuseUIConfig.cmake" "${CMAKE_CURRENT_BINARY_DIR}/FuseUIConfigVersion.cmake"
        DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/FuseUI)
if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/App/cmake/fuse_app_packaging.cmake")
    install(FILES "${CMAKE_CURRENT_SOURCE_DIR}/App/cmake/fuse_app_packaging.cmake" "${CMAKE_CURRENT_SOURCE_DIR}/App/cmake/fuse_app_stage_assets.cmake"
            DESTINATION ${CMAKE_INSTALL_DATADIR}/fuse_ui/cmake)
endif()
