# FORGE (https://github.com/odin-loki/FORGE) — Odin's OS layer, intrinsics and support library.
# FUSE consumes only FORGE's header-only layers (core, os, lane) through one INTERFACE target, `fuse_forge`,
# instead of add_subdirectory()-ing FORGE's full build (AI runtime, GPU compute, code generators).
#   -DFUSE_FORGE_DIR=/path/to/FORGE   use another checkout (default: vendor/forge submodule)
include_guard(GLOBAL)
get_filename_component(_fuse_forge_default "${CMAKE_CURRENT_LIST_DIR}/../vendor/forge" ABSOLUTE)
set(FUSE_FORGE_DIR "${_fuse_forge_default}" CACHE PATH "FORGE source root (header-only core/os/lane layers are used)")

# fuse_target_is_x86_64(<out>): TRUE when the C++ compiler targets x86_64 (asks the compiler, not the host).
function(fuse_target_is_x86_64 out)
    if(NOT DEFINED FUSE_TARGET_X86_64)
        include(CheckCXXSourceCompiles)
        check_cxx_source_compiles("#if !defined(__x86_64__) && !defined(_M_X64)\n#error not x86_64\n#endif\nint main() { return 0; }"
                                  FUSE_TARGET_X86_64)
    endif()
    set(${out} ${FUSE_TARGET_X86_64} PARENT_SCOPE)
endfunction()
# fuse_simd_flags(<out> avx2|avx512): per-source ISA flags for GCC/Clang (incl. clang-cl's GNU driver) or MSVC.
function(fuse_simd_flags out isa)
    if(MSVC)
        if(isa STREQUAL "avx2")
            set(${out} "/arch:AVX2" PARENT_SCOPE)
        else()
            set(${out} "/arch:AVX512" PARENT_SCOPE)
        endif()
    elseif(isa STREQUAL "avx2")
        set(${out} "-mavx2;-mfma;-mf16c" PARENT_SCOPE)
    else()
        set(${out} "-mavx512f;-mavx512bw;-mavx512dq;-mavx512vl;-mfma" PARENT_SCOPE)
    endif()
endfunction()

function(fuse_add_forge)
    if(TARGET fuse_forge)
        return()
    endif()
    if(NOT EXISTS "${FUSE_FORGE_DIR}/os/include/forge/os/os.hpp")
        message(FATAL_ERROR "FUSE: FORGE not found at ${FUSE_FORGE_DIR}. Run `git submodule update --init vendor/forge` "
                            "or pass -DFUSE_FORGE_DIR=<FORGE checkout>.")
    endif()
    add_library(fuse_forge INTERFACE)
    add_library(fuse::forge ALIAS fuse_forge)
    target_include_directories(fuse_forge SYSTEM INTERFACE
        "${FUSE_FORGE_DIR}/os/include" "${FUSE_FORGE_DIR}/core/include" "${FUSE_FORGE_DIR}/lane/include")
    target_compile_features(fuse_forge INTERFACE cxx_std_23)
    if(WIN32)
        target_link_libraries(fuse_forge INTERFACE ws2_32 bcrypt)
    elseif(UNIX)
        target_link_libraries(fuse_forge INTERFACE ${CMAKE_DL_LIBS})
    endif()
    find_package(Threads REQUIRED)
    target_link_libraries(fuse_forge INTERFACE Threads::Threads)
    message(STATUS "FUSE: FORGE OS layer from ${FUSE_FORGE_DIR}")
    # FORGE lane runtime (CPU feature detection + multiversioned kernels), built from FORGE's own sources so the
    # GUI never carries its own CPUID code. x86_64 only (GCC/Clang incl. mingw, and MSVC); elsewhere the header-only
    # vec is used at the compile-time baseline (NEON on aarch64) and detection is skipped. The target architecture
    # is probed from the compiler: cross toolchains often leave CMAKE_SYSTEM_PROCESSOR empty or as the host's.
    fuse_target_is_x86_64(_x64)
    if(_x64 AND NOT FUSE_FORGE_NO_LANE)
        set(_l "${FUSE_FORGE_DIR}/lane/src")
        add_library(fuse_forge_lane STATIC "${_l}/kernels_scalar.cpp" "${_l}/kernels_avx2.cpp"
            "${_l}/kernels_avx512.cpp" "${_l}/dispatch.cpp" "${_l}/tile_amx.cpp" "${_l}/tile_sme.cpp")
        fuse_simd_flags(_avx2 avx2)
        fuse_simd_flags(_avx512 avx512)
        set_source_files_properties("${_l}/kernels_avx2.cpp" PROPERTIES COMPILE_OPTIONS "${_avx2}")
        set_source_files_properties("${_l}/kernels_avx512.cpp" PROPERTIES COMPILE_OPTIONS "${_avx512}")
        target_link_libraries(fuse_forge_lane PUBLIC fuse_forge)
        set_target_properties(fuse_forge_lane PROPERTIES POSITION_INDEPENDENT_CODE ON)
        if(MSVC)
            target_compile_options(fuse_forge_lane PRIVATE /w)
        else()
            target_compile_options(fuse_forge_lane PRIVATE -w)
        endif()
    endif()
endfunction()

# fuse_add_forge_script(): FORGE's managed scripting runtime (forge::script, vendor/forge/script) as `fuse_forge_script`,
# the language behind fuse_ui_script. Built from FORGE's own sources; FUSE adds no script engine of its own.
function(fuse_add_forge_script)
    if(TARGET fuse_forge_script)
        return()
    endif()
    fuse_add_forge()
    set(_f "${FUSE_FORGE_DIR}")
    if(NOT EXISTS "${_f}/script/include/forge/script/script.hpp")
        message(STATUS "FUSE: FORGE at ${_f} has no script runtime; fuse_ui_script disabled")
        return()
    endif()
    # Host bindings (engine::define / call / release) are a FUSE-side patch until FORGE carries them upstream:
    # when the FORGE checkout lacks them, its script/ tree is copied into the build dir and patched there
    # (cmake/forge-patches/0001-script-host-bindings.patch). vendor/forge itself is never modified.
    file(READ "${_f}/script/include/forge/script/script.hpp" _hdr)
    if(NOT _hdr MATCHES "host_fn")
        set(_patch "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/forge-patches/0001-script-host-bindings.patch")
        set(_copy "${CMAKE_BINARY_DIR}/fuse-forge-script")
        file(SHA256 "${_patch}" _ph)
        file(GLOB_RECURSE _srcs "${_f}/script/*")
        set(_sig "${_ph}")
        foreach(x ${_srcs})
            file(SHA256 "${x}" _xh)
            string(APPEND _sig "${_xh}")
        endforeach()
        string(SHA256 _sig "${_sig}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_patch}")
        set(_stamp "")
        if(EXISTS "${_copy}/.fuse-patched")
            file(READ "${_copy}/.fuse-patched" _stamp)
        endif()
        if(NOT _stamp STREQUAL _sig)
            find_package(Git QUIET)
            if(NOT GIT_EXECUTABLE)
                message(WARNING "FUSE: git not found; cannot apply the FORGE script host patch, fuse_ui_script disabled")
                return()
            endif()
            file(REMOVE_RECURSE "${_copy}")
            file(MAKE_DIRECTORY "${_copy}")
            file(COPY "${_f}/script" DESTINATION "${_copy}")
            # GIT_CEILING_DIRECTORIES: apply as a plain patch even when the build dir sits inside a git checkout
            execute_process(COMMAND "${CMAKE_COMMAND}" -E env "GIT_CEILING_DIRECTORIES=${CMAKE_BINARY_DIR}"
                                    "${GIT_EXECUTABLE}" apply --whitespace=nowarn "${_patch}"
                            WORKING_DIRECTORY "${_copy}" RESULT_VARIABLE _rc ERROR_VARIABLE _err)
            if(NOT _rc EQUAL 0)
                message(WARNING "FUSE: FORGE script host patch does not apply to ${_f} (${_err}); fuse_ui_script disabled")
                return()
            endif()
            file(WRITE "${_copy}/.fuse-patched" "${_sig}")
        endif()
        message(STATUS "FUSE: forge::script host bindings patched into ${_copy}")
        set(_sroot "${_copy}")
    else()
        set(_sroot "${_f}")
    endif()
    file(GLOB _shells CONFIGURE_DEPENDS "${_sroot}/script/src/shells/*.cpp")
    set(_decl "")
    set(_call "")
    foreach(s ${_shells})
        get_filename_component(_stem ${s} NAME_WE)
        string(APPEND _decl "void forge_shell_register_${_stem}(forge::script::shell_registry&);\n")
        string(APPEND _call "        forge_shell_register_${_stem}(r);\n")
    endforeach()
    set(_reg "${CMAKE_BINARY_DIR}/generated/fuse_forge_shells_registry.cpp")
    file(CONFIGURE OUTPUT "${_reg}" CONTENT
"// generated by FUSE cmake/FuseForge.cmake from FORGE script/src/shells/*.cpp\n#include \"shells/shell.hpp\"\n${_decl}namespace forge::script {\nconst shell_registry& shells() {\n    static const shell_registry reg = [] {\n        shell_registry r;\n${_call}        return r;\n    }();\n    return reg;\n}\n}\n")
    set(_s "${_sroot}/script/src")
    add_library(fuse_forge_script STATIC ${_shells} "${_reg}" "${_s}/heap.cpp" "${_s}/parser.cpp" "${_s}/runtime.cpp"
        "${_s}/tree.cpp" "${_s}/vm.cpp" "${_s}/builtins.cpp" "${_s}/cppstd.cpp" "${_s}/automation.cpp" "${_s}/ai.cpp"
        "${_s}/debug.cpp" "${_s}/engine.cpp"
        # forge::remote needs FORGE's flow/rpc stack (generated op tables, lane kernels); a GUI host leaves it out.
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../Source/FUSE/UI/Script/src/forge_remote_off.cpp")
    add_library(fuse::forge_script ALIAS fuse_forge_script)
    target_include_directories(fuse_forge_script PUBLIC "${_sroot}/script/include" PRIVATE "${_s}")
    target_include_directories(fuse_forge_script SYSTEM PRIVATE "${_f}/support/include" "${_f}/flow/include"
        "${_f}/pack/include")
    target_link_libraries(fuse_forge_script PUBLIC fuse_forge)
    set_target_properties(fuse_forge_script PROPERTIES POSITION_INDEPENDENT_CODE ON)
    if(MSVC)
        target_compile_options(fuse_forge_script PRIVATE /w)
    else()
        target_compile_options(fuse_forge_script PRIVATE -w)
    endif()
endfunction()
