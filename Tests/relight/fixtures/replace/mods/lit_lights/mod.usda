#usda 1.0
(
    customLayerData = {
        string lightspeed_game_name = "ff_lit"
        string lightspeed_layer_type = "replacement"
    }
    defaultPrim = "RootNode"
    metersPerUnit = 1
    upAxis = "Y"
)

# RL-3.4 fixture (Remix mod, rtx-remix/mods/lit_lights) for the ff_lit app (hashes: the app's D3D lights and mesh):
#   light_70660FFAD292AF8D  the point light replaced by a brighter sphere light at a new position
#   light_52929E1042A73D88  the directional light deleted (a light_<H> prim that is not a light)
#   mesh_6EE2CF9EEF058877   the lit mesh (5 instances per frame) kept (preserveOriginalDrawCall) with an attached
#                           sphere light 1.5 units above each instance
# The spot light (8B0A310EB4127A3E) is not replaced.
def Xform "RootNode"
{
    def Scope "meshes"
    {
        def Xform "mesh_6EE2CF9EEF058877"
        {
            int preserveOriginalDrawCall = 1

            def SphereLight "halo"
            {
                color3f inputs:color = (0.5, 0.75, 1)
                float inputs:intensity = 10
                float inputs:radius = 0.1
                double3 xformOp:translate = (0, 1.5, 0)
                uniform token[] xformOpOrder = ["xformOp:translate"]
            }
        }
    }

    def Scope "lights"
    {
        def SphereLight "light_70660FFAD292AF8D"
        {
            color3f inputs:color = (1, 0.9, 0.7)
            float inputs:intensity = 200
            float inputs:radius = 0.25
            double3 xformOp:translate = (-1, 3, -1)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "light_52929E1042A73D88"
        {
        }
    }
}
