#usda 1.0
(
    defaultPrim = "Paint"
)

def Material "Paint" (
    variants = {
        string color = "green"
    }
    prepend variantSets = "color"
)
{
    variantSet "color" = {
        "blue" {
            color3f tint = (0, 0, 1)
        }
        "green" {
            color3f tint = (0, 1, 0)
        }
        "red" {
            color3f tint = (1, 0, 0)
        }
    }
}
