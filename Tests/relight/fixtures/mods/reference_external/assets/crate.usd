#usda 1.0
(
    defaultPrim = "Crate"
    upAxis = "Y"
)

def Xform "Crate" (
    kind = "component"
)
{
    custom string asset_name = "crate"

    def Mesh "geo"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-1, -1, 0), (1, -1, 0), (1, 1, 0), (-1, 1, 0)]
        float3 local_override = (1, 1, 1)
        double3 xformOp:scale = (1, 1, 1)
        uniform token[] xformOpOrder = ["xformOp:scale"]
        asset inputs:texture = @./tex/crate.dds@
    }
}

def Xform "NotReferenced"
{
}
