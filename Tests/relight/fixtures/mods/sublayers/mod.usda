#usda 1.0
(
    defaultPrim = "RootNode"
    subLayers = [
        @./layers/strong.usd@,
        @./layers/weak.usd@
    ]
)

# RL-3.1 fixture: sublayer stacking. Root > strong.usd > weak.usd (> deeper/base.usd, weak's own sublayer).
over "RootNode"
{
    over "meshes"
    {
        over "mesh_00000000000000A1"
        {
            over "mesh"
            {
                float root_only = 1
                float shared = 1
            }
        }
    }
}
