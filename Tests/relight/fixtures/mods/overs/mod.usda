#usda 1.0
(
    subLayers = [
        @./game.usd@
    ]
)

# RL-3.1 fixture: `over` specifiers merge by strongest opinion; an over without any def stays an over; a stronger
# over keeps the weaker def's type; `active = false` in the stronger layer deactivates a replacement.
over "RootNode"
{
    over "meshes"
    {
        over "mesh_0000000000000D01"
        {
            float value = 2
        }

        over "mesh_0000000000000D02" (
            active = false
        )
        {
        }

        over "mesh_0000000000000D03"
        {
            float orphan = 1
        }
    }
}
