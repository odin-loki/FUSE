{
    def Xform "meshes"
    {
        def Xform "mesh_0000000000000E01" (
            instanceable = true
            prepend references = @./assets/rock.usd@
        )
        {
        }

        def Xform "mesh_0000000000000E02" (
            instanceable = true
            prepend references = @./assets/rock.usd@
        )
        {
            float3 tint = (1, 0, 0)
        }
    }
}
