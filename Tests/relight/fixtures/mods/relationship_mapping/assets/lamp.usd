#usda 1.0
(
    defaultPrim = "Lamp"
)

def Xform "Lamp" (
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    rel material:binding = </Lamp/Looks/Glow>
    rel outside = </Elsewhere/Thing>
    rel extra = [</Lamp/Shade>, </Lamp/Base>]

    def Mesh "Shade"
    {
    }
    def Mesh "Base"
    {
    }
    def SphereLight "Bulb"
    {
        float inputs:intensity = 50
    }

    def Scope "Looks"
    {
        def Material "Glow"
        {
            token outputs:mdl:surface.connect = </Lamp/Looks/Glow/Shader.outputs:out>

            def Shader "Shader"
            {
                token outputs:out
            }
        }
    }
}

def Scope "Elsewhere"
{
    def Scope "Thing"
    {
    }
}
