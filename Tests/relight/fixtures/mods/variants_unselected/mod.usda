#usda 1.0

# RL-3.1 fixture: a variant set without any selection contributes nothing (USD has no implicit default variant).
def Xform "RootNode"
{
    def Xform "lights"
    {
        def SphereLight "light_0000000000000C02" (
            prepend variantSets = "mood"
        )
        {
            float inputs:intensity = 10

            variantSet "mood" = {
                "bright" {
                    float inputs:intensity = 1000
                }
                "dim" {
                    float inputs:intensity = 1
                }
            }
        }
    }
}
